---
// Unlisted CV page: shareable by direct link only. Nothing on the site links here, and search engines
// are asked not to index it. To rotate the link, rename this folder and public/cv/<folder> to a new name.
// The sheet below is the HTML the downloadable PDF is printed from (Fayhaa_Alharbi_DataEngineer_CV_ATS),
// so the page and the PDF say the same thing: update both together.
import { url } from '../../../lib/site';
const folder = Astro.url.pathname.split('/').filter(Boolean).pop();
const pdf = url('cv/' + folder + '/Fayhaa-Alharbi-CV.pdf');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Fayhaa Alharbi - Data Engineer CV</title>
<link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
<style is:global>
  @page { size: A4; margin: 11mm 17mm 10mm 17mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Times New Roman", "Liberation Serif", serif; font-size: 10pt; line-height: 1.13; color: #000; }
  header { text-align: center; margin-bottom: 4pt; }
  h1 { font-size: 20pt; font-weight: normal; margin: 0 0 1pt; }
  header p { margin: 0; }
  a { color: #1a3fb5; }
  h2 { font-size: 11pt; color: #3a5bd9; margin: 6pt 0 3pt; padding-bottom: 1pt; border-bottom: 0.8pt solid #000; }
  .row { display: flex; justify-content: space-between; gap: 12pt; }
  .entry { margin-bottom: 4pt; }
  .org { font-weight: bold; }
  .role { font-style: italic; }
  ul { margin: 1pt 0 0; padding-left: 14pt; }
  li { margin-bottom: 1pt; }
  p { margin: 0; }
  table.skills { border-collapse: collapse; }
  table.skills td { padding: 0 0 2.5pt; vertical-align: top; }
  table.skills td:first-child { width: 117pt; }

  /* On screen: the sheet as a page on a quiet desk, with a small bar to download or print it */
  @media screen {
    html { background: #e9e9e6; }
    body { max-width: 210mm; margin: 0 auto 40px; padding: 11mm 17mm 10mm; background: #fff; box-shadow: 0 1px 3px rgba(0, 0, 0, .12), 0 8px 30px rgba(0, 0, 0, .08); }
    .cv-bar { display: flex; justify-content: flex-end; gap: 8px; max-width: 210mm; margin: 24px auto 12px; font: 13px/1 system-ui, sans-serif; }
    .cv-bar a, .cv-bar button { padding: 8px 12px; border: 1px solid #c8c8c4; background: #fff; color: #111; text-decoration: none; cursor: pointer; font: inherit; }
    .cv-bar a:first-child { background: #111; color: #fff; border-color: #111; }
  }
  @media screen and (max-width: 820px) { body { padding: 8mm 6mm; } .cv-bar { padding: 0 8px; } .row { flex-wrap: wrap; gap: 0 12pt; } table.skills td:first-child { width: 96pt; } }
  @media print { .cv-bar { display: none; } }
</style>
</head>
<body>
<nav class="cv-bar"><a href={pdf} download="Fayhaa-Alharbi-CV.pdf">Download PDF</a><button type="button" onclick="window.print()">Print</button></nav>
<header>
  <h1>Fayhaa Alharbi</h1>

---
// Experiment 03 · Herbarium (v2) — a readable scrolling portfolio that speaks
// Papillon's language. The landing is a botanical figure: an ASCII flower whose
// four petals are labelled with the four stages of the work. Projects are pressed
// specimens with museum labels, tools are a pollination map grouped by stage, and
// notes are entries in a field journal. v1 lives at /experiments/herbarium-v1/.
import ExpShell from '../../components/ExpShell.astro';
import { expData } from '../../lib/expData';
import { flowerHTML } from '../../lib/flowerArt';
const D = await expData('en');
const roman = ['I', 'II', 'III', 'IV', 'V'];
const secs = [['about', 'About'], ['work', 'Work'], ['tools', 'Tools'], ['notes', 'Notes'], ['contact', 'Contact']];
const pad = (n: number) => String(n).padStart(2, '0');

// The four stages (same split as the home page pipeline), plus two shelves for the rest
const STAGES = [
  { id: 'ingest', name: D.workflow[0], what: 'Pull data from APIs, files and the web.', keys: ['python', 'rest-apis', 'web-scraping', 'etl', 'ibm-api-connect', 'outsystems'] },
  { id: 'transform', name: D.workflow[1], what: 'Clean it, test it, schedule it.', keys: ['sql', 'dbt', 'airflow', 'data-cleaning', 'power-query'] },
  { id: 'model', name: D.workflow[2], what: 'Shape it into tables people can trust.', keys: ['data-modeling', 'snowflake', 'statistics'] },
  { id: 'report', name: D.workflow[3], what: 'Turn it into decisions people can see.', keys: ['power-bi', 'dax', 'dashboard-design', 'streamlit'] },
  { id: 'run', name: 'Ship & run', what: 'Cloud, containers and the plumbing around it.', keys: ['aws', 'azure', 'docker', 'ci-cd', 'git'] },
  { id: 'web', name: 'Build for the web', what: 'When the result is a site or an app.', keys: ['typescript', 'javascript', 'astro', 'p5js', 'generative-viz'] },
];
const live = (k: string) => D.skills.find((s) => s.key === k && (s.used.length || s.work.length));
const groups = STAGES.map((g) => ({ ...g, tools: g.keys.map(live).filter(Boolean).sort((a, b) => b!.used.length - a!.used.length || b!.work.length - a!.work.length) as typeof D.skills }))
  .filter((g) => g.tools.length);
const roles = D.experience.filter((e) => e.skills.length);
const fam = (p: (typeof D.projects)[number]) => p.skills.some((s) => s.key === 'airflow' || s.key === 'dbt') ? 'Pipelines' : p.skills.some((s) => s.key === 'power-bi') ? 'Dashboards' : p.skills.some((s) => s.key === 'typescript') ? 'Web' : 'Analysis';
const featured = D.projects.filter((p) => p.featured), drawer = D.projects.filter((p) => !p.featured);
const stack = (p: (typeof D.projects)[number], n = 4) => p.skills.slice(0, n).map((s) => s.label).join(' · ') + (p.skills.length > n ? ` · +${p.skills.length - n}` : '');
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---
<ExpShell title="Herbarium" n="03" scripts={['js/flyer.js', 'experiments/kit.js', 'experiments/herbarium.js']}>
  <nav class="hb-rail" id="hb-rail" aria-label="Sections">
    <span class="hb-stem"><i id="hb-grow"></i></span>
    {secs.map(([id, label], i) => <a href={`#${id}`} data-id={id}><b>{roman[i]}</b><span>{label}</span></a>)}
  </nav>

  <div class="hb-gwrap"><canvas id="hb-garden" aria-hidden="true"></canvas></div>
  <main class="hb">
    <!-- ── Landing: a specimen sheet ── -->
    <header class="hb-hero">
      <div class="hb-ruler" aria-hidden="true"><span>0</span><span>5</span><span>10</span><span>15</span><span>20 cm</span></div>
      <div class="hb-hero-in">
        <p class="hb-k"><span>Herbarium</span> · sheet no. 0001</p>
        <h1 class="hb-name"><span data-decode>{D.name}</span></h1>
        <p class="hb-role">{D.role}, <em>who flies a little farther.</em></p>
        <p class="hb-intro">{D.intro}</p>
        <p class="hb-cta"><a href="#work">See the specimens ↓</a><a href={`mailto:${D.email}`}>Email me</a></p>
        <dl class="hb-museum" aria-label="Specimen label">
          <dt>Family</dt><dd>{D.role}</dd>
          <dt>Collected</dt><dd>2022 — 2026</dd>
          <dt>Specimens</dt><dd>{D.projects.length} projects · {D.posts.length} notes</dd>
        </dl>
      </div>
      <figure class="hb-fig" id="hb-fig">
        <div class="hb-fig-art"><canvas id="hb-flower" aria-hidden="true"></canvas><svg id="hb-callouts" aria-hidden="true"></svg>
          {STAGES.slice(0, 4).map((s, i) => <a class="hb-co" href="#tools" data-stage={s.id} data-i={i}><b>{pad(i + 1)}</b> {s.name}<small>{s.what}</small></a>)}
        </div>
        <figcaption><b>Fig. 1</b> <em>Papilio datum</em>, anatomy of a pipeline. Four petals, one per stage; each one a stream of live bits.</figcaption>
      </figure>
    </header>

    <!-- ── I. About ── -->
    <section id="about" class="hb-sec">
      <header class="hb-head"><p class="hb-num">Pl. I</p><h2 data-decode>About</h2><p class="hb-lead">Where the specimens came from: the jobs, the schooling, and the reason it's a butterfly.</p></header>
      <div class="hb-about">
        <blockquote class="hb-quote">
          <p>{D.philosophy.paragraphs[1]}</p>
          <a href={D.papillon}>{D.philosophy.title} — the full story ↗</a>
        </blockquote>
        <ol class="hb-time">
          {D.experience.map((e) => <li><small>{e.period}</small><b>{e.title}</b><span>{e.org}</span><p>{e.points[0]}</p></li>)}
          {D.education.map((e) => <li class="is-root"><small>{e.period}</small><b>{e.title}</b><span>{e.org}{e.note && ` · ${e.note}`}</span></li>)}
        </ol>
      </div>
    </section>

    <!-- ── II. Work: pressed specimens ── -->
    <section id="work" class="hb-sec">
      <header class="hb-head"><p class="hb-num">Pl. II</p><h2 data-decode>Work</h2><p class="hb-lead">{D.projects.length} specimens, pressed and labelled. Each picture develops out of the bits as it comes into view.</p></header>
      <div class="hb-feats">
        {featured.map((p, i) => (
          <article class={`hb-feat ${i % 2 ? 'is-flip' : ''}`}>
            <a class="hb-img" href={p.href} aria-label={p.title}>
              {p.thumb ? <><canvas data-src={p.thumb}></canvas><img src={p.thumb} alt="" loading="lazy" /></> : <pre class="hb-fallback" data-seed={i + 5}></pre>}
              <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
              <span class="hb-tape t1"></span><span class="hb-tape t2"></span>
              <span class="hb-slip" aria-hidden="true"><b>No. II.{pad(i + 1)}</b><span>{p.title}</span><span>fam. {fam(p)}</span><span>coll. {p.date}</span></span>
            </a>
            <div class="hb-label">
              <p class="hb-n" aria-hidden="true">{pad(i + 1)}</p>
              <h3><a href={p.href}>{p.title}</a></h3>
              {p.sub && <p class="hb-sub">{p.sub}</p>}
              <p class="hb-sum">{p.summary}</p>
              <p class="hb-res"><b>Result</b>{p.tldr.result}</p>
              <p class="hb-stack">{stack(p)}</p>
              <p class="hb-links">
                <a href={p.href}>Case study →</a>
                {p.live && <a href={p.live}>Live demo ↗</a>}
                {p.code && <a href={p.code}>Code ↗</a>}
              </p>
            </div>
          </article>
        ))}
      </div>
      <p class="hb-sub-h">From the drawer <span>· {drawer.length} more specimens</span></p>
      <div class="hb-drawer">
        {drawer.map((p, i) => (
          <article class="hb-sheet">
            <a class="hb-img" href={p.href} aria-label={p.title}>
              {p.thumb ? <><canvas data-src={p.thumb}></canvas><img src={p.thumb} alt="" loading="lazy" /></> : <pre class="hb-fallback" data-seed={i + 9}></pre>}
              <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
            </a>
            <p class="hb-tag">No. II.{pad(featured.length + i + 1)} · fam. {fam(p)} · {p.date}</p>
            <h3><a href={p.href}>{p.title}</a></h3>
            <p class="hb-sum">{p.summary}</p>
            <p class="hb-links">
              <a href={p.href}>Case study →</a>
              {p.live && <a href={p.live}>Live ↗</a>}
              {p.code && <a href={p.code}>Code ↗</a>}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── III. Tools: the pollination map ── -->
    <section id="tools" class="hb-sec">
      <header class="hb-head"><p class="hb-num">Pl. III</p><h2 data-decode>Tools</h2><p class="hb-lead">A pollination map. Tools are grouped by the stage of the work they serve and threaded to where I used them: at my jobs and in my projects. Hover to trace, click to pin.</p></header>
      <div class="hb-map" id="hb-map">
        <svg class="hb-map-lines" id="hb-map-lines" aria-hidden="true"><g id="hb-paths"></g><g id="hb-pollen"></g></svg>
        <div class="hb-map-l">
          {groups.map((g, gi) => (
            <div class="hb-grp">
              <button type="button" class="hb-grp-h" data-stage={g.id} data-name={`${pad(gi + 1)} ${g.name}`} data-short={g.name}><b>{pad(gi + 1)}</b> {g.name}<small>{g.what}</small></button>
              <ul>{g.tools.map((s) => <li><button type="button" data-k={s.key} class={s.core ? 'is-core' : ''}>{s.work.length > 0 && <em class="wk">work</em>}{s.label}<i title={`used in ${s.used.length} project(s)`}>{s.used.length || '–'}</i></button></li>)}</ul>
            </div>
          ))}
        </div>
        <div class="hb-map-r">
          <p class="hb-map-h"><b class="wk">work</b> at my jobs</p>
          <ul>{roles.map((e) => <li><button type="button" class="is-role" data-p={`role-${e.period}`} data-name={e.title} data-ks={e.skills.join(' ')}>{e.title}<small>{e.org} · {e.period}</small></button></li>)}</ul>
          <p class="hb-map-h"><b class="p">n</b> projects</p>
          <ul>{D.projects.map((p) => <li><button type="button" data-p={p.slug} data-name={p.title} data-ks={p.skills.map((s) => s.key).join(' ')}>{p.title}</button></li>)}</ul>
          <p class="hb-cap" id="hb-cap" aria-live="polite"><span>Hover a tool, a job or a project.</span></p>
        </div>
      </div>
    </section>

    <!-- ── IV. Notes: a field journal ── -->
    <section id="notes" class="hb-sec">
      <header class="hb-head"><p class="hb-num">Pl. IV</p><h2 data-decode>Notes</h2><p class="hb-lead">The field journal: what I learn on the way, written down before it fades.</p></header>
      <div class="hb-journal">
        {D.posts.map((p, i) => (
          <article class="hb-entry">
            <p class="hb-entry-k"><span>Entry {pad(D.posts.length - i)}</span><span>{p.minutes} min read</span></p>
            <p class="hb-date" aria-hidden="true"><b>{pad(p.month)}</b><span>{months[p.month - 1]}<br />{p.year}</span></p>
            <pre class="hb-sprig" aria-hidden="true" set:html={flowerHTML({ R: 3, petals: 5 + i, seed: 40 + i, stem: 4 })}></pre>
            <h3><a href={p.href}>{p.title}</a></h3>
            <p class="hb-excerpt">{p.summary}</p>
            <p class="hb-entry-f"><span>{p.tags.map((t) => `#${t}`).join('  ')}</span><a href={p.href}>Read the entry →</a></p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── V. Contact ── -->
    <section id="contact" class="hb-sec hb-end">
      <header class="hb-head"><p class="hb-num">Pl. V</p><h2 data-decode>Contact</h2><p class="hb-lead">Email is the fastest way to reach me. The butterfly will meet you there.</p></header>
      <a class="hb-mail" href={`mailto:${D.email}`} id="hb-mail">{D.email}</a>
      <p class="hb-cta"><a href={D.links.linkedin}>LinkedIn ↗</a><a href={D.links.github}>GitHub ↗</a></p>
      <div class="hb-release" id="hb-release"><canvas></canvas></div>
      <p class="hb-colophon">Pressed, labelled and catalogued by {D.name}. Set in IBM Plex and JetBrains Mono. Every flower on this sheet is drawn in code.</p>
    </section>
  </main>
</ExpShell>

<style is:global>
  html { scroll-behavior: smooth; }
  body { background:
    radial-gradient(1200px 600px at 85% -10%, #1a1f1a 0%, transparent 60%),
    var(--night); }
  .hb { --col: min(1120px, calc(100vw - 230px)); margin-left: 180px; }
  .hb-sec { width: var(--col); margin: 0 auto; padding: 150px 0 40px; position: relative; }

  /* section heads: plate number, title, lead on a ruled baseline */
  .hb-head { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 0 48px; padding-bottom: 22px; margin-bottom: 56px; position: relative;
    background: repeating-linear-gradient(90deg, #ffffff22 0 1px, transparent 1px 12px) bottom left / 100% 5px no-repeat, linear-gradient(#ffffff1a, #ffffff1a) bottom / 100% 1px no-repeat; }
  .hb-num { grid-column: 1 / -1; margin: 0; font: 500 10.5px var(--mono); letter-spacing: .2em; color: var(--red); text-transform: uppercase; }
  .hb h2 { margin: 8px 0 0; font: 400 clamp(48px, 6.4vw, 96px)/0.9 var(--serif); font-style: italic; letter-spacing: -.025em; color: var(--ink); }
  .hb-lead { max-width: 46ch; margin: 0 0 6px; justify-self: end; color: var(--dim); font-size: 14.5px; line-height: 1.6; }

  /* rail */
  .hb-rail { position: fixed; z-index: 20; left: 34px; top: 50%; transform: translateY(-50%); display: grid; gap: 22px; padding-left: 18px; }
  .hb-stem { position: absolute; left: 0; top: 4px; bottom: 4px; width: 1px; background: #ffffff1a; }
  .hb-stem i { position: absolute; left: 0; top: 0; width: 1px; height: 0; background: var(--leaf); box-shadow: 0 0 6px #6f9f6f; }
  .hb-rail a { position: relative; display: grid; gap: 2px; text-decoration: none; color: var(--dim); font: 500 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; transition: color .3s; }
  .hb-rail a b { font: italic 400 15px/1 var(--serif); letter-spacing: 0; color: #ffffff55; transition: color .3s; }
  .hb-rail a::before { content: ''; position: absolute; left: -21px; top: 3px; width: 7px; height: 7px; border-radius: 50%; background: var(--night); border: 1px solid #ffffff33; transition: all .3s; }
  .hb-rail a.is-on { color: var(--ink); } .hb-rail a.is-on b { color: var(--red); }
  .hb-rail a.is-on::before { background: var(--red); border-color: var(--red); box-shadow: 0 0 8px var(--red); }
  .hb-rail.is-hero { opacity: 0; pointer-events: none; } .hb-rail { transition: opacity .6s; }

  /* ── landing ── */
  .hb-hero { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: 30px; width: var(--col); margin: 0 auto; padding: 70px 0 30svh; }
  .hb-ruler { position: absolute; top: 26px; left: 0; right: 0; height: 18px; display: flex; justify-content: space-between; font: 9px var(--mono); color: #ffffff40; letter-spacing: .1em;
    background: repeating-linear-gradient(90deg, #ffffff30 0 1px, transparent 1px 9px) bottom / 100% 4px no-repeat, repeating-linear-gradient(90deg, #ffffff40 0 1px, transparent 1px 45px) bottom / 100% 8px no-repeat; padding-bottom: 10px; }
  .hb-gwrap { position: absolute; left: 0; top: 70svh; width: 100%; height: 28svh; }
  #hb-garden { width: 100%; height: 100%; display: block; }
  .hb-k { font: 500 10.5px var(--mono); letter-spacing: .2em; text-transform: uppercase; color: var(--dim); margin: 0 0 22px; }
  .hb-k span { color: var(--red); }
  .hb-name { margin: 0; font: 400 clamp(84px, 11.5vw, 184px)/.82 var(--serif); font-style: italic; letter-spacing: -.045em; }
  .hb-name span { display: inline-block; background: linear-gradient(100deg, var(--ink) 40%, #ffd7c8 50%, var(--ink) 60%) 0 0 / 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: hb-sheen 9s ease-in-out 2.5s infinite; }
  @keyframes hb-sheen { 0%, 70% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  .hb-role { margin: 22px 0 0; font: 400 clamp(19px, 2vw, 26px)/1.3 var(--serif); color: var(--ink-2); }
  .hb-role em { color: var(--red); }
  .hb-intro { max-width: 46ch; margin: 18px 0 0; font-size: 15px; line-height: 1.7; color: var(--dim); }
  .hb-cta { display: flex; gap: 10px; flex-wrap: wrap; margin: 28px 0 0; }
  .hb-cta a { font: 500 11.5px/1 var(--mono); letter-spacing: .06em; padding: 11px 14px; text-decoration: none; color: var(--ink); border: 1px solid #ffffff2a; background: #0b0c0e99; transition: all .2s; }
  .hb-cta a:first-child { border-color: #ff8a8a88; background: #ff8a8a12; }
  .hb-cta a:hover { border-color: var(--red); color: var(--red); box-shadow: 0 0 14px #ff8a8a33; }

  .hb-fig { margin: 0; position: relative; justify-self: end; width: 100%; max-width: 600px; }
  .hb-fig-art { position: relative; aspect-ratio: 1 / .92; }
  #hb-flower, #hb-callouts { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  #hb-callouts path { fill: none; stroke: #ff8a8a; stroke-width: 1; filter: drop-shadow(0 0 3px #ff8a8a99); stroke-dasharray: var(--len); stroke-dashoffset: var(--len); transition: stroke-dashoffset .9s cubic-bezier(.6, 0, .2, 1); }
  #hb-callouts path.is-drawn { stroke-dashoffset: 0; }
  #hb-callouts circle { fill: var(--red); opacity: 0; transition: opacity .3s; } #hb-callouts circle.is-drawn { opacity: 1; }
  .hb-co { position: absolute; left: 0; top: 0; display: grid; gap: 3px; width: max-content; max-width: 170px; text-decoration: none; padding: 6px 9px 7px;
    font: 500 11px/1.1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink); background: rgba(8, 9, 11, .82); border: 1px solid #ff8a8a66;
    opacity: 0; transform: translateY(4px); transition: opacity .5s, transform .5s, border-color .2s, box-shadow .2s; }
  .hb-co.is-on { opacity: 1; transform: none; }
  .hb-co b { color: var(--red); font-weight: 500; }
  .hb-co small { font: 400 10.5px/1.45 var(--sans); letter-spacing: 0; text-transform: none; color: var(--dim); }
  .hb-co:hover { border-color: var(--red); box-shadow: 0 0 14px #ff8a8a44; }
  .hb-fig figcaption { margin: 10px 0 0; font: 10.5px/1.6 var(--mono); color: var(--dim); letter-spacing: .03em; max-width: 46ch; margin-left: auto; text-align: right; }
  .hb-fig figcaption b { color: var(--red); font-weight: 500; } .hb-fig figcaption em { font: italic 13px var(--serif); color: var(--ink-2); }
  .hb-museum { margin: 44px 0 0; display: inline-grid; grid-template-columns: auto auto auto auto auto auto; gap: 0 12px; padding: 9px 0 0; font: 10px/1.5 var(--mono); border-top: 1px solid #ffffff1a; }
  .hb-museum dd { margin-right: 14px !important; white-space: nowrap; }
  .hb-museum dt { color: var(--dim); text-transform: uppercase; letter-spacing: .14em; } .hb-museum dd { margin: 0; color: var(--ink-2); }

  /* ── about ── */
  .hb-about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: start; }
  .hb-quote { margin: 0; position: sticky; top: 110px; padding-left: 26px; border-left: 1px solid var(--gold); }
  .hb-quote p { margin: 0; font: italic 400 clamp(22px, 2.3vw, 31px)/1.38 var(--serif); color: var(--ink); text-wrap: pretty; }
  .hb-quote a { display: inline-block; margin-top: 20px; font: 500 11px var(--mono); color: var(--red); text-decoration: none; letter-spacing: .06em; }
  .hb-quote a:hover { text-decoration: underline; }
  .hb-time { list-style: none; margin: 0; padding: 0 0 0 28px; border-left: 1px solid #6f9f6f55; }
  .hb-time li { position: relative; padding: 0 0 30px; }
  .hb-time li::before { content: '0'; position: absolute; left: -34px; top: 0; width: 12px; text-align: center; font: 11px/1.2 var(--mono); color: var(--leaf); background: var(--night); }
  .hb-time li.is-root::before { content: '1'; color: var(--gold); }
  .hb-time small { display: block; font: 10.5px var(--mono); color: var(--dim); letter-spacing: .04em; }
  .hb-time b { display: block; margin-top: 4px; font-weight: 500; font-size: 16px; }
  .hb-time span { font-size: 13px; color: var(--leaf); }
  .hb-time p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--dim); max-width: 52ch; }

  /* ── specimens ── */
  .hb-img { position: relative; display: block; aspect-ratio: 16/10; background: #0e100f; outline: 1px solid #ffffff12; outline-offset: 7px; overflow: visible; }
  .hb-img img, .hb-img canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; object-position: top; }
  .hb-img img { clip-path: inset(0 0 100% 0); transition: clip-path 1.6s cubic-bezier(.6, 0, .2, 1) .2s, transform .8s cubic-bezier(.2, .8, .2, 1), filter .4s; }
  .hb-img::after { content: ''; position: absolute; left: -6px; right: -6px; top: 0; height: 1px; background: var(--red); box-shadow: 0 0 10px 1px #ff8a8a; opacity: 0; pointer-events: none; z-index: 2; }
  .is-dev .hb-img img { clip-path: inset(0 0 0 0); }
  .is-dev .hb-img::after { animation: hb-scan 1.6s cubic-bezier(.6, 0, .2, 1) .2s both; }
  @keyframes hb-scan { 0% { top: 0; opacity: 1; } 92% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  .hb-img .c { position: absolute; width: 12px; height: 12px; border: 1px solid var(--red); opacity: 0; transition: all .3s; filter: drop-shadow(0 0 4px var(--red)); z-index: 3; }
  .hb-img .tl { top: -14px; left: -14px; border-right: 0; border-bottom: 0; } .hb-img .tr { top: -14px; right: -14px; border-left: 0; border-bottom: 0; }
  .hb-img .bl { bottom: -14px; left: -14px; border-right: 0; border-top: 0; } .hb-img .br { bottom: -14px; right: -14px; border-left: 0; border-top: 0; }
  article:hover .hb-img .c { opacity: 1; }

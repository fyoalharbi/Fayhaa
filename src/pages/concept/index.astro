---
// Concept (hidden, noindex): the normal view as one "garden-style" board. An
// introduction plus every part of the site shown at once as panels; each panel
// shows a preview and expands in place, or "open all" expands everything.
import Base from '../../layouts/Base.astro';
import { profile, experience, education, certifications, philosophy } from '../../data/profile';
import { url, langUrl, getProjects, projectHref, getPosts, postSlug } from '../../lib/site';

const lang = 'en';
const projects = await getProjects(lang);
const posts = await getPosts(lang);
const STAGES = [
  ['Ingest', 'Python · REST APIs · Web scraping · ETL'],
  ['Transform', 'SQL · dbt · Airflow · Data cleaning'],
  ['Model', 'Data modeling · Snowflake · Statistics'],
  ['Report', 'Power BI · DAX · Dashboards · Streamlit'],
];
const panels = [
  { id: 'work', n: '01', title: 'Work', peek: `${projects.length} projects · data pipelines, BI dashboards, creative code` },
  { id: 'how', n: '02', title: 'How I work', peek: 'Ingest → Transform → Model → Report' },
  { id: 'path', n: '03', title: 'Path', peek: `${experience.length} roles · ${education.length} degrees · ${certifications.length} certificates` },
  { id: 'notes', n: '04', title: 'Notes', peek: `${posts.length} posts on tools, AI and the craft` },
  { id: 'why', n: '05', title: 'Why butterflies?', peek: 'my work philosophy, told by a garden' },
  { id: 'reach', n: '06', title: 'Say hi', peek: profile.email },
];
---
<Base lang={lang} title="Concept" path="concept/" noindex>
  <div class="cx" id="cx">
    <!-- Introduction: who, what, and how to read the board -->
    <section class="cx-intro">
      <p class="cx-k mono">// {profile.role[lang].toUpperCase()} · RIYADH</p>
      <h1 class="cx-name">{profile.name[lang]}</h1>
      <p class="cx-lead">{profile.intro[lang]}</p>
      <p class="cx-how mono">
        <span>pick a panel to open it</span>
        <button class="cx-all" id="cx-all" type="button" aria-pressed="false">[ open all ]</button>
      </p>
    </section>

    <!-- The board: every part of the site at once -->
    <div class="cx-board">
      {panels.map((p) => (
        <section class={`cx-p cx-p-${p.id}`} id={`p-${p.id}`} data-open="false">
          <button class="cx-head" type="button" aria-expanded="false" aria-controls={`b-${p.id}`}>
            <span class="cx-n mono">{p.n}</span>
            <span class="cx-t">{p.title}</span>
            <span class="cx-peek mono">{p.peek}</span>
            <span class="cx-plus mono" aria-hidden="true">+</span>
          </button>
          <div class="cx-body" id={`b-${p.id}`}>
            {p.id === 'work' && (
              <ul class="cx-list">
                {projects.map((pr) => { const h = projectHref(pr); return (
                  <li><a href={h.href} {...(h.external ? { target: '_blank', rel: 'noopener' } : {})}><b>{pr.data.title.split(/ [—–-] /)[0]}</b><span>{pr.data.summary}</span></a></li>
                ); })}
              </ul>
            )}
            {p.id === 'how' && (
              <ol class="cx-stages">{STAGES.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}</ol>
            )}
            {p.id === 'path' && (
              <ul class="cx-list">
                {experience.map((e) => <li><b>{e.title[lang]}</b><span>{e.org[lang]} · {e.period}</span></li>)}
                {education.map((e) => <li><b>{e.title[lang]}</b><span>{e.org[lang]} · {e.period}</span></li>)}
              </ul>
            )}
            {p.id === 'notes' && (
              <ul class="cx-list">{posts.map((po) => <li><a href={langUrl(lang, `blog/${postSlug(po)}/`)}><b>{po.data.title}</b><span>{po.data.summary}</span></a></li>)}</ul>
            )}
            {p.id === 'why' && (
              <div class="cx-why">
                <p>{philosophy.lines[lang].slice(5, 9).join(' ')}</p>
                <a class="cx-go mono" href={langUrl(lang, 'papillon/')}>[ enter the garden ]</a>
              </div>
            )}
            {p.id === 'reach' && (
              <div class="cx-why">
                <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
                <p class="mono"><a href={profile.links.linkedin}>linkedin</a> · <a href={profile.links.github}>github</a></p>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      const root = document.getElementById('cx'), all = document.getElementById('cx-all');
      const panels = [...root.querySelectorAll('.cx-p')];
      const set = (p, open) => { p.dataset.open = String(open); p.querySelector('.cx-head').setAttribute('aria-expanded', String(open)); };
      panels.forEach((p) => p.querySelector('.cx-head').addEventListener('click', () => {
        const open = p.dataset.open !== 'true';
        if (all.getAttribute('aria-pressed') !== 'true') panels.forEach((q) => q !== p && set(q, false));   // one at a time
        set(p, open);
      }));
      all.addEventListener('click', () => {
        const on = all.getAttribute('aria-pressed') !== 'true';
        all.setAttribute('aria-pressed', String(on)); all.textContent = on ? '[ close all ]' : '[ open all ]';
        panels.forEach((p) => set(p, on));
      });
    })();
  </script>
</Base>

<style>
  .cx { min-height: calc(100svh - var(--header-h)); background: radial-gradient(ellipse at 50% 120%, #1f2a1f 0%, #141814 40%, #0d0d0f 75%); color: #cfcfcf; padding: clamp(20px, 4vw, 48px) clamp(16px, 4vw, 56px) 48px; }
  :global(body:has(.cx)) { background: #0d0d0f; }
  :global(body:has(.cx) .site-header) { background: rgba(10, 11, 12, .72); border-bottom: 1px solid #ffffff14; }
  :global(body:has(.cx) .site-header a) { color: #8a8a92; }
  :global(body:has(.cx) .site-header .brand), :global(body:has(.cx) .brand-mark) { color: #ff8a8a; }
  :global(body:has(.cx) .term-toggle) { background: none; border-color: #ffffff2a; }
  :global(body:has(.cx) .site-footer) { background: #0d0d0f; color: #77777f; border-color: #ffffff14; }

  .cx-intro { max-width: 760px; margin-bottom: 28px; }
  .cx-k { margin: 0 0 6px; color: #ff8a8a; }
  .cx-name { margin: 0; font: 600 clamp(2.2rem, 6vw, 4rem)/1 var(--font-mono); color: var(--paper); }
  .cx-lead { margin: 14px 0 0; max-width: 62ch; color: #a3a3a3; line-height: 1.6; }
  .cx-how { margin: 18px 0 0; display: flex; gap: 16px; align-items: center; color: #77777f; font-size: .72rem; }
  .cx-all { background: none; border: 0; color: #ff8a8a; font: inherit; cursor: pointer; padding: 0; }
  .cx-all:hover { color: var(--paper); }

  /* Panels: a loose grid of old-game windows; the open one spans wider */
  .cx-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .cx-p {
    position: relative; background: rgba(8, 10, 12, .7); border: 1px solid #ffffff1f; transition: border-color .25s, box-shadow .25s;
    background-image: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255, 255, 255, .02) 2px 3px);
  }
  .cx-p::before, .cx-p::after { content: ''; position: absolute; width: 5px; height: 5px; background: #ff8a8a; opacity: 0; transition: opacity .25s; }
  .cx-p::before { top: -3px; left: -3px; } .cx-p::after { bottom: -3px; right: -3px; }
  .cx-p:hover, .cx-p[data-open='true'] { border-color: #ff8a8a; box-shadow: 0 0 14px #ff8a8a33, inset 0 0 10px #ff8a8a14; }
  .cx-p:hover::before, .cx-p:hover::after, .cx-p[data-open='true']::before, .cx-p[data-open='true']::after { opacity: 1; }
  .cx-p[data-open='true'] { grid-column: span 2; }
  .cx-head { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'n t plus' 'peek peek peek'; gap: 4px 10px; width: 100%; padding: 16px 16px 14px; background: none; border: 0; color: inherit; text-align: start; cursor: pointer; }
  .cx-n { grid-area: n; color: #ff8a8a; }
  .cx-t { grid-area: t; font: 600 1.05rem var(--font-mono); color: var(--paper); }
  .cx-plus { grid-area: plus; color: #77777f; transition: transform .25s; }
  .cx-p[data-open='true'] .cx-plus { transform: rotate(45deg); color: #ff8a8a; }
  .cx-peek { grid-area: peek; color: #77777f; font-size: .7rem; }
  .cx-body { display: none; }
  .cx-p[data-open='true'] .cx-body { display: block; animation: cx-open .3s ease both; }
  @keyframes cx-open { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .cx-list, .cx-stages { list-style: none; margin: 0; padding: 0 16px 16px; display: grid; gap: 2px; }
  .cx-list li a, .cx-list li { display: grid; gap: 2px; padding: 8px 0; border-top: 1px solid #ffffff12; color: inherit; text-decoration: none; }
  .cx-list li a { border: 0; padding: 0; }
  .cx-list b { color: var(--paper); font-weight: 600; }
  .cx-list span { color: #8a8a92; font-size: .85rem; }
  .cx-list a:hover b { color: #ff8a8a; }
  .cx-stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .cx-stages li { border-top: 1px solid #ff8a8a; padding-top: 8px; display: grid; gap: 4px; }
  .cx-stages b { color: var(--paper); font-family: var(--font-mono); }
  .cx-stages span { color: #8a8a92; font-size: .85rem; }
  .cx-why { padding: 0 16px 16px; }
  .cx-why p { margin: 0 0 10px; line-height: 1.6; }
  .cx-why a { color: var(--paper); }
  .cx-go { color: #ff8a8a !important; text-decoration: none; }
  @media (max-width: 900px) { .cx-board { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .cx-board { grid-template-columns: 1fr; }
    .cx-p[data-open='true'] { grid-column: auto; }
    .cx-stages { grid-template-columns: 1fr 1fr; }
  }
</style>

---
// A post: date and reading time, the title, its summary, then the text in a reading column; it ends
// with a garden flower and the way to the next note.
import { render } from 'astro:content';
import Herb from '../layouts/Herb.astro';
import { flowerHTML } from '../lib/flowerArt';
import { type Lang } from '../data/profile';
import { ui, langUrl, getPosts, postSlug, formatDate, type Post } from '../lib/site';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = ui[lang];
const AR = lang === 'ar';
const d = post.data;
const slug = postSlug(post);
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
// Language switch: this post's translation if there is one, else the other blog
const other: Lang = AR ? 'en' : 'ar';
const translated = (await getPosts(other)).some((p) => postSlug(p) === slug);
// The next note: the one before this in time, or the newest when this is the oldest
const posts = await getPosts(lang), at = posts.findIndex((p) => postSlug(p) === slug);
const next = posts.length > 1 ? posts[(at + 1) % posts.length] : null;
const T = AR
  ? { back: '→ كل التدوينات', min: 'دقيقة قراءة', next: 'التدوينة التالية' }
  : { back: '← All writing', min: 'min read', next: 'Next note' };
---
<Herb lang={lang} title={d.title} description={d.summary} path={translated ? `blog/${slug}/` : 'blog/'}>
  <article class="hb-doc">
    <header class="hb-doc-head hb-measure">
      <a class="hb-back" href={langUrl(lang, 'blog/')}>{T.back}</a>
      <p class="hb-tag"><time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time> · {minutes} {T.min}</p>
      <h1 class="hb-doc-t" data-perch>{d.title}</h1>
      <p class="hb-doc-lead">{d.summary}</p>
      {(d.translated || d.original) && (
        <p class="hb-doc-note">
          {d.translated && <span>{t.translatedNote} </span>}
          {d.original && <a href={d.original} target="_blank" rel="noopener">{t.originalOn}</a>}
        </p>
      )}
    </header>
    <div class="hb-prose hb-measure"><Content /></div>
    <footer class="hb-doc-end hb-measure">
      <pre class="hb-fleuron" aria-hidden="true" set:html={flowerHTML({ R: 4, petals: 6, seed: slug, stem: 4 })}></pre>
      <nav class="hb-next">
        <a href={langUrl(lang, 'blog/')}><span>{T.back}</span></a>
        {next && <a class="is-to" href={langUrl(lang, `blog/${postSlug(next)}/`)}><small>{T.next}</small><span>{next.data.title}</span></a>}
      </nav>
    </footer>
  </article>
</Herb>

---
// Project thumbnail. Uses /public/projects/<slug>.(png|jpg|webp) when one exists;
// otherwise draws an ASCII scene in the site's glyph style, picked by project type,
// so every card has an image without needing screenshots.
import fs from 'node:fs';
import path from 'node:path';
import { url } from '../lib/site';

interface Props { slug: string; skills: string[]; title: string }
const { slug, skills, title } = Astro.props;
const img = ['png', 'jpg', 'webp'].map((e) => `projects/${slug}.${e}`).find((f) => fs.existsSync(path.join(process.cwd(), 'public', f)));

// Deterministic noise so each card gets its own variation of its scene
let seed = [...slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) | 0, 7);
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const W = 38, H = 9;
const grid = () => Array.from({ length: H }, () => Array(W).fill(' '));
const bit = () => (rnd() < 0.5 ? '0' : '1');

function bars() {                       // a dashboard: axis, bars of 0/1, a trend line
  const g = grid();
  for (let x = 2; x < W - 1; x += 3) {
    const h = 2 + Math.floor(rnd() * (H - 3));
    for (let y = H - 2; y >= H - 1 - h; y--) { g[y][x] = bit(); g[y][x + 1] = y === H - 1 - h ? '▀' : bit(); }
  }
  for (let x = 0; x < W; x++) g[H - 1][x] = '─';
  for (let y = 0; y < H; y++) g[y][0] = '│';
  g[H - 1][0] = '└'; g[0][W - 6] = '•'; g[0][W - 5] = 'K'; g[0][W - 4] = 'P'; g[0][W - 3] = 'I';
  return g;
}
function line() {                       // a time series with a highlighted peak
  const g = grid();
  let y = 5;
  for (let x = 1; x < W - 1; x++) {
    y = Math.max(1, Math.min(H - 2, y + Math.round((rnd() - 0.48) * 2)));
    g[y][x] = x % 6 === 0 ? '@' : '*';
    for (let k = y + 1; k < H - 1; k++) if (rnd() < 0.35) g[k][x] = '.';
  }
  for (let x = 0; x < W; x++) g[H - 1][x] = '─';
  return g;
}
function pipeline() {                   // sources → transform → model → report
  const rows = [
    '  [api]──┐                            ',
    '         ├──>{ dbt }──>[ ★ ]──>▐█▌    ',
    '  [csv]──┘     0110     1001    ▐▌▌    ',
    '               1011     0110           ',
    '  ~ airflow ~~~~~~~~~~~~~~~~~~~~~~>    ',
  ];
  const g = grid();
  rows.forEach((r, i) => [...r].forEach((c, x) => { if (x < W) g[i + 2][x] = c; }));
  for (let x = 0; x < W; x++) if (rnd() < 0.18) g[0][x] = bit();
  return g;
}
function tree() {                       // a tree of feelings / ideas
  const rows = [
    '               @                       ',
    '          o────┼────o                  ',
    '       *──┤    │    ├──*               ',
    '       │  o──┬─┴─┬──o  │               ',
    '       *     o   o     *               ',
    '             │   │                     ',
    '           ──┴───┴──                   ',
  ];
  const g = grid();
  rows.forEach((r, i) => [...r].forEach((c, x) => { if (x + 6 < W) g[i + 1][x + 6] = c; }));
  return g;
}
function butterfly() {
  const rows = [
    '     .-.      .-.     ',
    '    (0101\\  /1010)    ',
    '     \\1001\\/1001/     ',
    '      )=  @@  =(      ',
    '     /0110/\\0110\\     ',
    '    (1001/  \\1001)    ',
    "     '-'      '-'     ",
  ];
  const g = grid();
  rows.forEach((r, i) => [...r].forEach((c, x) => { if (x + 8 < W) g[i + 1][x + 8] = c; }));
  return g;
}
function report() {                     // a generated report: text lines and a mini chart
  const g = grid();
  for (let y = 0; y < H; y++) {
    const len = y === 0 ? 14 : 8 + Math.floor(rnd() * 16);
    for (let x = 1; x < len; x++) g[y][x] = y === 0 ? '█' : rnd() < 0.85 ? '─' : ' ';
  }
  for (let x = 26; x < W - 1; x++) { const h = 1 + Math.floor(rnd() * 6); for (let y = H - 1; y > H - 1 - h; y--) g[y][x] = x % 2 ? '1' : '0'; }
  return g;
}
const has = (k: string) => skills.includes(k);
const kind = slug.includes('butterfly') ? butterfly
  : slug.includes('qafiyah') ? tree
  : has('airflow') || has('dbt') ? pipeline
  : slug.includes('report') ? report
  : slug.includes('finance') || slug.includes('bellabeat') ? line
  : bars;
const art = kind().map((r) => r.join('')).join('\n')
  .replace(/[@★▀•]/g, (c) => `<b>${c}</b>`);
---
<div class="thumb" aria-hidden={img ? undefined : 'true'}>
  {img ? <img src={url(img)} alt={title} loading="lazy" decoding="async" /> : <pre set:html={art}></pre>}
</div>

<style>
  .thumb {
    position: relative; aspect-ratio: 16 / 7; overflow: hidden; margin: -4px -4px 6px; border-radius: calc(var(--radius) - 2px);
    background: radial-gradient(ellipse at 50% 130%, #1f2a1f 0%, #141814 45%, #0d0d0f 80%);
    display: grid; place-items: center;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform .4s ease; }
  :global(.card:hover) .thumb img { transform: scale(1.04); }
  .thumb pre {
    margin: 0; font: 600 clamp(8px, 1.05vw, 11px)/1.15 var(--font-mono); color: #6f9f6f; letter-spacing: .02em;
    transition: color .3s, transform .4s ease;
  }
  .thumb pre :global(b) { color: #ff8a8a; text-shadow: 0 0 6px #ff8a8a88; font-weight: 700; }
  /* scanlines */
  .thumb::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255, 255, 255, .03) 2px 3px); }
  /* home section on short screens: keep it to one screen */
  @media (max-height: 760px) { :global(.band) .thumb { aspect-ratio: 16 / 5; } }
  :global(.card:hover) .thumb pre { color: #9fcf8f; transform: scale(1.04); }
</style>

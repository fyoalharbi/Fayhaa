---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang } from '../data/profile';
import { ui, url, langUrl, projectSlug, skillLabel, formatDate, getProjects, hasPage, type Project } from '../lib/site';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const t = ui[lang];
const d = project.data;
const slug = projectSlug(project);
const { Content } = await render(project);
// The EN/AR switch points at this post's translation, or the project list if there isn't one
const other: Lang = lang === 'en' ? 'ar' : 'en';
const translated = (await getProjects(other)).some((p) => projectSlug(p) === slug && hasPage(p));
const linkEntries = (Object.entries(d.links) as [keyof typeof t.links, string | undefined][])
  .filter(([, v]) => v);
---
<Base lang={lang} title={d.title} description={d.summary} path={translated ? `projects/${slug}/` : 'projects/'}>
  <article class="post wrap">
    <a class="back mono" href={langUrl(lang, 'projects/')}>{t.back}</a>

    {d.draft && <p class="draft-banner mono">{t.draftBanner}</p>}

    <header class="post-header">
      <p class="mono muted"><time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time></p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </header>

    <dl class="tldr">
      {(['problem', 'role', 'tools', 'result'] as const).map((k) => (
        <div><dt class="mono">{t.tldr[k]}</dt><dd>{d.tldr[k]}</dd></div>
      ))}
    </dl>

    <div class="actions">
      {linkEntries.map(([k, v]) => <a class="btn" href={v} target="_blank" rel="noopener">{t.links[k]} ↗</a>)}
      <a class="btn" href={`${url('terminal/')}?cmd=${encodeURIComponent(`cat ${slug}`)}${lang === 'ar' ? '&lang=ar' : ''}`}>
        <span aria-hidden="true">&gt;_</span> {t.openInTerminal}
      </a>
    </div>

    {d.embed && (
      <div class="embed">
        <iframe src={d.embed} title={d.title} loading="lazy" allowfullscreen></iframe>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <h2 class="mono">{t.skillsUsed}</h2>
      <ul class="tags">
        {d.skills.map((s) => <li><a href={langUrl(lang, `skills/${s}/`)}>{skillLabel(s, lang)}</a></li>)}
      </ul>
    </footer>
  </article>
</Base>

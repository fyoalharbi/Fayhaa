---
// The ASCII butterfly from the terminal view, reused in the normal hero.
// Scripts load only once the hero is on screen, and not at all for
// visitors who prefer reduced motion (they get a static caption instead).
import { url } from '../lib/site';

interface Props { hint: string }
const { hint } = Astro.props;

const sketchSrc = url('terminal/sketch.js');
const videoSrc = url('terminal/newbutterfly1.mp4');
const p5Src = 'https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.min.js';
---
<figure class="butterfly">
  <div id="video-holder" class="butterfly-canvas" role="img" aria-label="Animated ASCII art of a butterfly"></div>
  <figcaption class="mono muted">{hint}</figcaption>
</figure>

<script is:inline define:vars={{ sketchSrc, videoSrc, p5Src }}>
  (function () {
    const holder = document.getElementById('video-holder');
    if (!holder) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      holder.classList.add('is-static');
      return;
    }
    window.BUTTERFLY_SRC = videoSrc;

    const load = (src) => new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.body.appendChild(s);
    });

    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      // The sketch defines setup/draw globals first; p5 then finds them on init.
      load(sketchSrc).then(() => load(p5Src)).catch(() => holder.classList.add('is-static'));
    });
    io.observe(holder);
  })();
</script>

---
// Hidden 3D garden (/papillon/garden/): a real-time ASCII render of the flowers,
// bushes, a bee and butterflies (public/js/garden3d.js), with a guided tour: a
// dialogue box at the bottom tells the philosophy line by line while the camera
// moves to each line's subject (the white butterfly, the bee, the hive, a far
// flower, the whole garden). Reached from the end of the secret philosophy page.
import Base from '../layouts/Base.astro';
import { philosophy, type Lang } from '../data/profile';
import { url, langUrl } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const t = ar
  ? { title: 'الحديقة', kicker: '// GARDEN_3D', hint: 'اسحب للالتفاف · مرّر للتقريب', follow: 'تابع الفراشة', free: 'كاميرا حرة', back: 'رجوع للقصة',
      tour: 'ابدأ الجولة', next: 'التالي', skip: 'تخطَّ', again: 'من جديد', blog: 'اقرأ المدونة', end: 'طارت. وأنت؟', ask: 'تبي جولة في الحديقة؟',
      who: { butterfly: 'الفراشة', bee: 'النحلة', hive: 'الخلية', far: 'زهرة بعيدة', wide: 'الحديقة' } }
  : { title: 'The garden', kicker: '// GARDEN_3D', hint: 'drag to orbit · scroll to zoom', follow: 'Follow the butterfly', free: 'Free camera', back: 'Back to the story',
      tour: 'Start the tour', next: 'Next', skip: 'Skip', again: 'Replay', blog: 'Read the blog', end: 'It flew away. Your turn.', ask: 'Want a tour of the garden?',
      who: { butterfly: 'the butterfly', bee: 'the bee', hive: 'the hive', far: 'a far flower', wide: 'the garden' } };
const lines = philosophy.lines[lang];
// Which subject the camera visits for each line (same order as the philosophy lines)
const SHOTS = ['wide', 'butterfly', 'butterfly', 'bee', 'bee', 'hive', 'butterfly', 'far', 'wide', 'butterfly', 'wide', 'butterfly'];
const steps = lines.map((line, i) => ({ line, shot: SHOTS[i] || 'wide' }));
---
<Base lang={lang} title={t.title} path="papillon/garden/" noindex>
  <div class="g3" dir={ar ? 'rtl' : 'ltr'}>
    <canvas id="g3-canvas" aria-label={t.title}></canvas>
    <div class="g3-ui mono">
      <p class="g3-kicker" dir="ltr">{t.kicker}</p>
      <p class="g3-hint">{t.hint}</p>
    </div>

    <section class="g3-box" id="g3-box" aria-live="polite" data-state="intro">
      <p class="g3-who mono" id="g3-who"></p>
      <p class="g3-line" id="g3-line">{t.ask}</p>
      <div class="g3-row">
        <span class="g3-dots" aria-hidden="true">{steps.map(() => <i></i>)}</span>
        <span class="g3-btns">
          <a class="btn g3-blog" href={langUrl(lang, 'blog/')}>{t.blog}</a>
          <button class="btn g3-skip" id="g3-skip" type="button">{t.skip}</button>
          <button class="btn g3-next" id="g3-next" type="button">{t.tour}</button>
        </span>
      </div>
    </section>

    <div class="g3-actions">
      <button class="btn" id="g3-follow" type="button" data-on={t.free} data-off={t.follow}>{t.follow}</button>
      <a class="btn" href={langUrl(lang, 'papillon/')}>{t.back}</a>
    </div>
  </div>

  <script is:inline define:vars={{ src: url('js/garden3d.js'), steps, t }}>
    (function () {
      try { localStorage.setItem('fayhaa:papillon', '1'); } catch (e) {}
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const box = document.getElementById('g3-box'), lineEl = document.getElementById('g3-line'), whoEl = document.getElementById('g3-who');
      const nextBtn = document.getElementById('g3-next'), skipBtn = document.getElementById('g3-skip');
      const dots = [...box.querySelectorAll('.g3-dots i')];
      let g = null, step = -1;

      // Decode a line in: 0/1 noise resolving into letters (same feel as the story page)
      function decode(el, text) {
        cancelAnimationFrame(el._raf || 0);
        const chars = [...text], n = chars.length, at = chars.map((_, i) => (i / n) * 0.7 + Math.random() * 0.12);
        const t0 = performance.now(), dur = REDUCED ? 0 : Math.min(1200, 400 + n * 12);
        const frame = (now) => {
          const k = dur ? (now - t0) / dur : 2; let out = '', done = true;
          for (let i = 0; i < n; i++) {
            if (chars[i] === ' ' || k >= at[i] + 0.18) out += chars[i];
            else { out += Math.random() < 0.5 ? '0' : '1'; done = false; }
          }
          el.textContent = out;
          if (!done) el._raf = requestAnimationFrame(frame);
        };
        el._raf = requestAnimationFrame(frame);
      }
      function show(i) {
        step = i;
        dots.forEach((d, k) => { d.classList.toggle('is-on', k <= i); d.classList.toggle('is-now', k === i); });
        if (i >= steps.length) {                    // the end: pull back, offer the blog
          box.dataset.state = 'end';
          if (g) g.setShot('wide');
          whoEl.textContent = '';
          decode(lineEl, t.end);
          nextBtn.textContent = t.again;
          return;
        }
        box.dataset.state = 'tour';
        const s = steps[i];
        if (g) g.setShot(s.shot);
        whoEl.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(steps.length).padStart(2, '0') + ' · ' + t.who[s.shot];
        decode(lineEl, s.line);
        nextBtn.textContent = t.next;
      }
      function stop() {
        step = -1; box.dataset.state = 'off';
        if (g) g.setShot(null);
      }
      nextBtn.addEventListener('click', () => show(step >= steps.length ? 0 : step + 1));
      skipBtn.addEventListener('click', stop);
      addEventListener('keydown', (e) => {
        if (box.dataset.state === 'off' || box.dataset.state === 'intro') return;
        if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); nextBtn.click(); }
        if (e.key === 'Escape') stop();
      });

      const s = document.createElement('script');
      s.src = src;
      s.onload = () => {
        g = new window.Garden3D(document.getElementById('g3-canvas'));
        const btn = document.getElementById('g3-follow');
        btn.addEventListener('click', () => { stop(); btn.textContent = g.toggleFollow() ? btn.dataset.on : btn.dataset.off; });
        // Dragging the garden mid-tour hands the camera back for that line
        document.getElementById('g3-canvas').addEventListener('pointerdown', () => { if (box.dataset.state === 'tour') g.setShot(null); });
      };
      document.body.appendChild(s);
    })();
  </script>
</Base>

<style>
  .g3 {
    position: relative; height: calc(100svh - var(--header-h)); overflow: hidden; color: var(--paper);
    background: radial-gradient(ellipse at 50% 115%, #1f2a1f 0%, #141814 38%, #0d0d0f 72%);
  }
  .g3 canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
  .g3 canvas:active { cursor: grabbing; }
  .g3-ui { position: absolute; top: 16px; inset-inline-start: 20px; pointer-events: none; }
  .g3-kicker { margin: 0 0 4px; color: #ff8a8a; }
  .g3-hint { margin: 0; color: #77777f; font-size: .8rem; }
  .g3-actions { position: absolute; top: 16px; inset-inline-end: 20px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .g3-actions .btn { background: var(--ink); }

  /* Dialogue box: same language as the dark stage — ink panel, hairline rule, mono, paper buttons */
  .g3-box {
    --rule: #3a3a3a;
    position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); width: min(720px, calc(100% - 32px));
    padding: 14px 18px 12px; background: var(--ink); border: 1px solid var(--rule); border-radius: var(--radius);
    box-shadow: 0 0 0 1px #00000066, 0 12px 40px #00000099; transition: opacity .4s, transform .4s;
  }
  .g3-box[data-state='off'] { opacity: 0; transform: translate(-50%, 16px); pointer-events: none; }
  .g3-who {
    display: flex; align-items: center; gap: 10px; margin: 0 0 10px; min-height: 1.1em;
    color: #a3a3a3; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
  }
  .g3-who::after { content: ''; flex: 1; border-top: 1px solid var(--rule); }
  .g3-line { margin: 0; min-height: 2.9em; font: 500 clamp(.98rem, 1.6vw, 1.2rem)/1.5 var(--font-mono); color: var(--paper); }
  .g3-line::after { content: '_'; margin-inline-start: 2px; color: #ff8a8a; animation: g3-blink 1s steps(1) infinite; }
  @keyframes g3-blink { 50% { opacity: 0; } }
  .g3[dir='rtl'] .g3-line { font-family: var(--font-ar); font-size: clamp(1.05rem, 1.9vw, 1.35rem); }
  .g3-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--rule); }
  .g3-dots { display: flex; gap: 4px; }
  .g3-dots i { width: 10px; height: 2px; background: var(--rule); transition: background .3s; }
  .g3-dots i.is-on { background: #8a8a8a; }
  .g3-dots i.is-now { background: var(--paper); }
  .g3-box[data-state='intro'] .g3-dots { visibility: hidden; }
  .g3-btns { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .g3 .btn { padding: 6px 14px; font-size: .85rem; border-color: var(--paper); color: var(--paper); background: transparent; }
  .g3 .btn:hover, .g3 .g3-next { background: var(--paper); color: var(--ink); }
  .g3 .g3-next:hover { background: #ff8a8a; border-color: #ff8a8a; color: var(--ink); }
  .g3 :focus-visible { outline-color: #ff8a8a; }
  .g3-blog { display: none !important; }
  .g3-box[data-state='end'] .g3-blog { display: inline-flex !important; }
  .g3-box[data-state='end'] .g3-skip { display: none; }
  @media (prefers-reduced-motion: reduce) { .g3-line::after { animation: none; } }
  @media (max-width: 600px) {
    .g3-box { bottom: 12px; padding: 12px 14px 10px; }
    .g3-dots i { width: 6px; }
    .g3-actions { top: 64px; inset-inline-start: 16px; inset-inline-end: auto; justify-content: flex-start; }
  }
</style>

---
// The secret philosophy page (/papillon/), unlocked by catching the butterfly: a real-time ASCII render of the flowers,
// bushes, a bee and butterflies (public/js/garden3d.js), with a guided tour: a
// dialogue box at the bottom tells the philosophy line by line while the camera
// moves to each line's subject (the white butterfly, the bee, the hive, a far
// flower, the whole garden).
import Base from '../layouts/Base.astro';
import { philosophy, type Lang } from '../data/profile';
import { url, langUrl } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const t = ar
  ? { title: 'الحديقة', kicker: '// GARDEN_3D', hint: 'اسحب للالتفاف · مرّر للتقريب', follow: 'تابع الفراشة', free: 'كاميرا حرة', back: 'رجوع للموقع',
      tour: 'ابدأ الجولة', next: 'التالي', skip: 'تخطَّ', again: 'من جديد', blog: 'اقرأ المدونة', end: 'طارت. وأنت؟', ask: 'هذي الحديقة هي طريقتي بالشغل. تبي جولة؟', sub: 'فلسفتي بالشغل، تحكيها حديقة',
      who: { butterfly: 'الفراشة', bee: 'النحلة', hive: 'الخلية', far: 'زهرة بعيدة', wide: 'الحديقة' } }
  : { title: 'The garden', kicker: '// GARDEN_3D', hint: 'drag to orbit · scroll to zoom', follow: 'Follow the butterfly', free: 'Free camera', back: 'Back to the site',
      tour: 'Start the tour', next: 'Next', skip: 'Skip', again: 'Replay', blog: 'Read the blog', end: 'It flew away. Your turn.', ask: 'This garden is how I work. Want the tour?', sub: 'my work philosophy, told by a garden',
      who: { butterfly: 'the butterfly', bee: 'the bee', hive: 'the hive', far: 'a far flower', wide: 'the garden' } };
const lines = philosophy.lines[lang];
// Which subject the camera visits for each line (same order as the philosophy lines)
const SHOTS = ['wide', 'butterfly', 'butterfly', 'bee', 'bee', 'hive', 'butterfly', 'far', 'wide', 'butterfly', 'wide', 'butterfly'];
const steps = lines.map((line, i) => ({ line, shot: SHOTS[i] || 'wide' }));
---
<Base lang={lang} title={t.title} path="papillon/" noindex>
  <div class="g3" dir={ar ? 'rtl' : 'ltr'}>
    <canvas id="g3-canvas" aria-label={t.title}></canvas>
    <div class="g3-ui mono">
      <h1 class="g3-title">{philosophy.title[lang]}</h1>
      <p class="g3-sub">{t.sub}</p>
      <p class="g3-hint">{t.hint}</p>
    </div>

    <section class="g3-box is-enter" id="g3-box" aria-live="polite" data-state="intro">
      <p class="g3-who mono" id="g3-who"></p>
      <p class="g3-line" id="g3-line">{t.ask}</p>
      <div class="g3-row">
        <span class="g3-dots" aria-hidden="true">{steps.map(() => <i></i>)}</span>
        <span class="g3-btns">
          <a class="btn g3-blog" href={langUrl(lang, 'blog/')}>{t.blog}</a>
          <button class="btn g3-skip" id="g3-skip" type="button">{t.skip}</button>
          <button class="btn g3-next" id="g3-next" type="button">{t.tour}</button>
        </span>
      </div>
    </section>

    <div class="g3-actions">
      <button class="btn" id="g3-follow" type="button" data-on={t.free} data-off={t.follow}>{t.follow}</button>
      <a class="btn" href={langUrl(lang)}>{t.back}</a>
    </div>
  </div>

  <script is:inline define:vars={{ src: url('js/garden3d.js'), steps, t }}>
    (function () {
      try { localStorage.setItem('fayhaa:papillon', '1'); } catch (e) {}
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const box = document.getElementById('g3-box'), lineEl = document.getElementById('g3-line'), whoEl = document.getElementById('g3-who');
      const nextBtn = document.getElementById('g3-next'), skipBtn = document.getElementById('g3-skip');
      const dots = [...box.querySelectorAll('.g3-dots i')];
      let g = null, step = -1;

      // Decode a line in: 0/1 noise resolving into letters (same feel as the story page)
      function decode(el, text) {
        cancelAnimationFrame(el._raf || 0);
        const chars = [...text], n = chars.length, at = chars.map((_, i) => (i / n) * 0.7 + Math.random() * 0.12);
        const t0 = performance.now(), dur = REDUCED ? 0 : Math.min(1200, 400 + n * 12);
        const frame = (now) => {
          const k = dur ? (now - t0) / dur : 2; let out = '', done = true;
          for (let i = 0; i < n; i++) {
            if (chars[i] === ' ' || k >= at[i] + 0.18) out += chars[i];
            else { out += Math.random() < 0.5 ? '0' : '1'; done = false; }
          }
          el.textContent = out;
          if (!done) el._raf = requestAnimationFrame(frame);
        };
        el._raf = requestAnimationFrame(frame);
      }
      function show(i) {
        step = i;
        dots.forEach((d, k) => { d.classList.toggle('is-on', k <= i); d.classList.toggle('is-now', k === i); });
        if (i >= steps.length) {                    // the end: pull back, offer the blog
          box.dataset.state = 'end';
          if (g) g.setShot('wide');
          whoEl.textContent = '';
          decode(lineEl, t.end);
          nextBtn.textContent = t.again;
          return;
        }
        box.dataset.state = 'tour';
        const s = steps[i];
        if (g) g.setShot(s.shot);
        whoEl.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(steps.length).padStart(2, '0') + ' · ' + t.who[s.shot];
        decode(lineEl, s.line);
        nextBtn.textContent = t.next;
      }
      function stop() {
        step = -1; box.dataset.state = 'off';
        if (g) g.setShot(null);
      }
      // Greeting decodes in as the box finishes rising
      { const ask = lineEl.textContent; lineEl.textContent = ''; setTimeout(() => decode(lineEl, ask), REDUCED ? 0 : 1000); }
      setTimeout(() => box.classList.remove('is-enter'), REDUCED ? 0 : 2300);   // after the whole entrance has played
      nextBtn.addEventListener('click', () => show(step >= steps.length ? 0 : step + 1));
      skipBtn.addEventListener('click', stop);
      addEventListener('keydown', (e) => {
        if (box.dataset.state === 'off' || box.dataset.state === 'intro') return;
        if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); nextBtn.click(); }
        if (e.key === 'Escape') stop();
      });

      const s = document.createElement('script');
      s.src = src;
      s.onload = () => {
        g = new window.Garden3D(document.getElementById('g3-canvas'));
        const btn = document.getElementById('g3-follow');
        btn.addEventListener('click', () => { stop(); btn.textContent = g.toggleFollow() ? btn.dataset.on : btn.dataset.off; });
        // Dragging the garden mid-tour hands the camera back for that line
        document.getElementById('g3-canvas').addEventListener('pointerdown', () => { if (box.dataset.state === 'tour') g.setShot(null); });
      };
      document.body.appendChild(s);
    })();
  </script>
</Base>

<style>
  .g3 {
    position: relative; height: calc(100svh - var(--header-h)); overflow: hidden; color: var(--paper);
    background: radial-gradient(ellipse at 50% 115%, #1f2a1f 0%, #141814 38%, #0d0d0f 72%);
  }
  .g3 canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
  .g3 canvas:active { cursor: grabbing; }
  .g3-ui { position: absolute; top: 16px; inset-inline-start: 20px; pointer-events: none; }
  .g3-title { margin: 0; font: 600 1rem/1.3 var(--font-mono); color: #cfcfcf; letter-spacing: .02em; }
  .g3-sub { margin: 2px 0 8px; font: .74rem/1.4 var(--font-mono); color: #ff8a8a; opacity: .85; }
  .g3-sub::before { content: '— '; }
  .g3-hint { margin: 0; color: #77777f; font-size: .72rem; }
  .g3[dir='rtl'] .g3-title, .g3[dir='rtl'] .g3-sub { font-family: var(--font-ar); letter-spacing: 0; }
  .g3[dir='rtl'] .g3-title { font-size: 1.1rem; }

  /* The site header, re-dressed for the night garden: a dark veil, quiet mono links */
  :global(body:has(.g3)) { background: #0d0d0f; }
  :global(body:has(.g3) .site-header) {
    background: rgba(10, 11, 12, .72); border-bottom: 1px solid #ffffff14; color: #cfcfcf;
  }
  :global(body:has(.g3) .site-header .brand) { color: #cfcfcf; }
  :global(body:has(.g3) .site-header .brand-mark) { color: #ff8a8a; }
  :global(body:has(.g3) .site-nav a), :global(body:has(.g3) .lang-link) { color: #77777f; font-family: var(--font-mono); font-size: .74rem; letter-spacing: .04em; }
  :global(body:has(.g3) .site-nav a:hover), :global(body:has(.g3) .lang-link:hover) { color: var(--paper); }
  :global(body:has(.g3) .term-toggle) { background: none; border-color: #ffffff2a; color: #a3a3a3; }
  :global(body:has(.g3) .term-toggle:hover) { border-color: #ff8a8a; color: var(--paper); background: none; }
  :global(body:has(.g3) .site-header .secret-tab) { color: #ff8a8a !important; }
  :global(html[dir='rtl'] body:has(.g3) .site-nav a), :global(html[dir='rtl'] body:has(.g3) .lang-link) { font-family: var(--font-ar); letter-spacing: 0; font-size: .85rem; }
  .g3-actions { position: absolute; top: 16px; inset-inline-end: 20px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .g3-actions { gap: 14px; }

  /* Dialogue box: quiet, like the garden's own labels — small mono text on a faint veil */
  .g3-box {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); width: min(460px, calc(100% - 32px));
    padding: 10px 14px 9px; background: rgba(10, 11, 12, .68); border-inline-start: 1px solid #ff8a8a66;
    transition: opacity .4s, transform .4s;
  }
  /* Entrance on page load: the veil fades up, the side line draws in, then the text decodes */
  .g3-box.is-enter { animation: g3-rise .7s cubic-bezier(.2, .8, .2, 1) .5s both; }
  .g3-box.is-enter::before {
    content: ''; position: absolute; inset-block: 0; inset-inline-start: -1px; width: 1px; background: #ff8a8a;
    transform-origin: 50% 100%; animation: g3-draw .6s ease-out .9s both;
  }
  .g3-box.is-enter .g3-row { animation: g3-fade .5s ease-out 1.6s both; }
  @keyframes g3-rise { from { opacity: 0; transform: translate(-50%, 14px); filter: blur(3px); } to { opacity: 1; transform: translate(-50%, 0); filter: none; } }
  @keyframes g3-draw { from { transform: scaleY(0); opacity: 1; } 70% { opacity: 1; } to { transform: scaleY(1); opacity: 0; } }
  @keyframes g3-fade { from { opacity: 0; } to { opacity: 1; } }
  .g3-box[data-state='off'] { opacity: 0; transform: translate(-50%, 10px); pointer-events: none; }
  .g3-who { margin: 0 0 4px; min-height: 1em; color: #77777f; font: .7rem/1.2 var(--font-mono); letter-spacing: .06em; }
  .g3-line { margin: 0; min-height: 2.7em; font: .9rem/1.45 var(--font-mono); color: #cfcfcf; }
  .g3-line::after { content: '_'; margin-inline-start: 1px; color: #ff8a8a; opacity: .8; animation: g3-blink 1s steps(1) infinite; }
  @keyframes g3-blink { 50% { opacity: 0; } }
  .g3[dir='rtl'] .g3-line { font-family: var(--font-ar); font-size: .98rem; }
  .g3-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 6px; }
  .g3-dots { display: flex; gap: 3px; }
  .g3-dots i { width: 8px; height: 1px; background: #3a3a3a; }
  .g3-dots i.is-on { background: #77777f; }
  .g3-dots i.is-now { background: #ff8a8a; }
  .g3-box[data-state='intro'] .g3-dots { visibility: hidden; }
  .g3-btns { display: flex; gap: 14px; }
  /* Buttons read as small mono links, like the hint text */
  .g3 .btn {
    padding: 0; border: 0; border-radius: 0; background: none; color: #a3a3a3;
    font: .74rem/1.4 var(--font-mono); letter-spacing: .04em; cursor: pointer;
  }
  .g3 .btn::before { content: '['; color: #55555c; margin-inline-end: 3px; }
  .g3 .btn::after { content: ']'; color: #55555c; margin-inline-start: 3px; }
  .g3 .btn:hover, .g3 .btn:focus-visible { color: var(--paper); background: none; }
  .g3 .g3-next { color: #ff8a8a; }
  .g3 .g3-next:hover { color: #ffb0b0; }
  .g3 :focus-visible { outline: 1px dotted #ff8a8a; outline-offset: 3px; }
  .g3-blog { display: none !important; }
  .g3-box[data-state='end'] .g3-blog { display: inline-flex !important; }
  .g3-box[data-state='end'] .g3-skip { display: none; }
  .g3[dir='rtl'] .btn, .g3[dir='rtl'] .g3-who { letter-spacing: 0; font-family: var(--font-ar); font-size: .8rem; }   /* keep Arabic letters joined */
  @media (prefers-reduced-motion: reduce) { .g3-line::after, .g3-box.is-enter, .g3-box.is-enter::before, .g3-box.is-enter .g3-row { animation: none; } }
  @media (max-width: 600px) {
    .g3-box { bottom: 12px; }
    .g3-dots i { width: 5px; }
    .g3-actions { top: auto; bottom: 150px; inset-inline-start: 16px; inset-inline-end: auto; justify-content: flex-start; }
  }
</style>

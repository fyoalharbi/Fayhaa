</Herb>

<style>
  .g3 {
    position: relative; height: 100svh; overflow: hidden; color: var(--paper);
    --paper: #f4f4f4; --font-mono: var(--mono); --font-ar: 'IBM Plex Sans Arabic', system-ui, sans-serif;
    /* The sky warms as the story goes on (--stage 0 → 1) */
    --stage: 0;
    background:
      radial-gradient(ellipse at 50% 112%, rgba(255, 150, 110, calc(var(--stage) * .16)) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 115%, #1f2a1f 0%, #141814 38%, #0d0d0f 72%);
    transition: background 2s ease;
  }
  .g3 canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
  .g3 canvas:active { cursor: grabbing; }
  .g3 .mono { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .04em; }
  .g3[dir='rtl'] .mono { font-family: var(--font-ar); letter-spacing: 0; font-size: .85rem; }
  .g3-ui { position: absolute; top: 80px; inset-inline-start: 20px; pointer-events: none; }
  .g3-title { margin: 0; font: 600 1rem/1.3 var(--font-mono); color: #cfcfcf; letter-spacing: .02em; }
  .g3-sub { margin: 2px 0 8px; font: .74rem/1.4 var(--font-mono); color: #ff8a8a; opacity: .85; }
  .g3-sub::before { content: '— '; }
  .g3-hint { margin: 0; color: #77777f; font-size: .72rem; }
  .g3[dir='rtl'] .g3-title, .g3[dir='rtl'] .g3-sub { font-family: var(--font-ar); letter-spacing: 0; }
  .g3[dir='rtl'] .g3-title { font-size: 1.1rem; }

  /* The site's top bar steps aside for the intro and the journey, and slides back in at the end */
  :global(body:has(.g3)) { background: #0d0d0f; }
  :global(body:has(.g3) .hb-top) { background: linear-gradient(#0d0d0fcc, #0d0d0f00); }
  :global(body:has(.g3:not([data-phase='end'])) .hb-top) { opacity: 0; pointer-events: none; }
  :global(body:has(.g3[data-phase='end']) .hb-top) { animation: g3-head .7s cubic-bezier(.2, .8, .2, 1) both; }
  .g3-actions { position: absolute; top: 80px; inset-inline-end: 20px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .g3-actions { gap: 14px; }

  /* ── Phases ── intro and journey take the whole screen (the header steps aside) */
  .g3[data-phase='intro'], .g3[data-phase='journey'] { position: fixed; inset: 0; height: 100svh; z-index: 60; }
  .g3 canvas, .g3-ui, .g3-actions { transition: opacity 1.2s ease; }
  .g3[data-phase='intro'] canvas, .g3[data-phase='intro'] .g3-ui, .g3[data-phase='intro'] .g3-actions,
  .g3[data-phase='journey'] .g3-actions, .g3[data-phase='journey'] .g3-hint { opacity: 0; pointer-events: none; }
  @keyframes g3-head { from { transform: translateY(-100%); opacity: 0; } to { transform: none; opacity: 1; } }

  .g3-intro {
    position: absolute; inset: 0; z-index: 6; display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center;
    padding: 24px; transition: opacity .8s ease, visibility .8s;
  }
  .g3:not([data-phase='intro']) .g3-intro { opacity: 0; visibility: hidden; }
  .g3-intro-k { margin: 0; color: #ff8a8a; animation: g3-fade .8s ease .2s both; }
  .g3-intro-t { margin: 0; font: 600 clamp(1.8rem, 5vw, 3.2rem)/1.1 var(--font-mono); color: var(--paper); animation: g3-fade .9s ease .5s both; }
  .g3[dir='rtl'] .g3-intro-t, .g3[dir='rtl'] .g3-intro-k { font-family: var(--font-ar); }
  .g3-intro .g3-start { margin-top: 10px; font-size: .85rem !important; color: #ff8a8a !important; animation: g3-fade .8s ease 1s both; }
  .g3-intro .g3-start:hover { color: var(--paper) !important; }

  /* ── The end: retro callouts ── */
  .g3-lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 4; pointer-events: none; opacity: 0; transition: opacity .8s ease .6s; }
  .g3-lines :global(polyline) { fill: none; stroke: #ff8a8a; stroke-width: 1; stroke-dasharray: 4 3; filter: drop-shadow(0 0 3px #ff8a8a); animation: g3-march 1.2s linear infinite; }
  /* Project flowers: a warm glow behind the head, and pollen glyphs rising from it */
  .g3-lines :global(.g3-glow) { fill: #ffb48a; opacity: .38; filter: blur(6px); transform-box: fill-box; transform-origin: center; animation: g3-breathe 2.4s ease-in-out var(--d) infinite; }
  .g3-lines :global(.g3-glow.is-lit) { opacity: .45; fill: #ffc79a; animation-duration: 1.2s; }
  @keyframes g3-breathe { 50% { transform: scale(1.3); opacity: .55; } }
  .g3-lines :global(.g3-mote) { fill: #ffe0a8; font: 700 11px var(--font-mono); text-anchor: middle; filter: drop-shadow(0 0 3px #ffb48a); }
  .g3.is-pointing canvas { cursor: pointer; }
  @keyframes g3-march { to { stroke-dashoffset: -14; } }
  .g3-pins { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .g3-pin {
    position: absolute; top: 0; left: 0; width: min(230px, 38vw); padding: 7px 10px 8px; pointer-events: auto; text-decoration: none;
    background-color: rgba(6, 8, 12, .82); border: 1px solid #ff8a8a; outline: 1px solid #ff8a8a44; outline-offset: 2px;
    box-shadow: 0 0 10px #ff8a8a55, inset 0 0 8px #ff8a8a22; color: #cfcfcf; font: .68rem/1.4 var(--font-mono);
    background-image: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255, 255, 255, .035) 2px 3px);
    transition: transform .45s cubic-bezier(.2, .8, .2, 1), opacity .5s, box-shadow .2s; opacity: 0; visibility: hidden;
  }
  .g3[data-phase='end'] .g3-pin[data-on='1'] { opacity: 1; visibility: visible; }
  .g3[data-phase='end'] .g3-lines, .g3[data-phase='journey'] .g3-lines { opacity: 1; }
  .g3-fact { z-index: 5; pointer-events: none; width: min(250px, 60vw); transition: opacity .5s, visibility .5s; }
  .g3[data-phase='journey'] .g3-fact[data-on='1'] { opacity: 1; visibility: visible; }
  .g3-fact em { display: block; font-style: normal; color: #ffe0a8; font-size: .64rem; letter-spacing: .08em; margin: 1px 0 3px; }
  .g3-fact span { -webkit-line-clamp: 4 !important; display: -webkit-box !important; }   /* facts keep their note, even on phones */
  .g3[dir='rtl'] .g3-fact em { letter-spacing: 0; }
  .g3-pin b { display: block; color: #ff8a8a; font-size: .74rem; letter-spacing: .05em; text-transform: uppercase; text-shadow: 0 0 6px #ff8a8a; }
  .g3-pin span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #8a8a92; margin-top: 2px; }
  .g3-pin:hover, .g3-pin:focus-visible { box-shadow: 0 0 18px #ff8a8aaa, inset 0 0 10px #ff8a8a44; outline-color: #ff8a8a; }
  .g3-pin:hover b::after { content: ' ▸'; }
  .g3[dir='rtl'] .g3-pin { font-family: var(--font-ar); font-size: .78rem; }
  .g3[dir='rtl'] .g3-pin b { letter-spacing: 0; font-size: .82rem; }
  @media (max-width: 600px) {
    .g3-pin span { display: none; } .g3-pin { width: 40vw; padding: 5px 7px 6px; }
    .g3-pin b { font-size: .62rem; letter-spacing: .02em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  }
  /* Following the butterfly: the project cards and their lines step aside so it stays in sight */
  .g3.is-following .g3-pins, .g3.is-following .g3-lines, .g3.is-following .g3-tip { opacity: 0 !important; visibility: hidden; pointer-events: none; }

  /* Sound + capture: small bracket links, bottom right, visible once the garden is showing */
  .g3-tools { position: absolute; right: 20px; bottom: 26px; z-index: 6; display: flex; gap: 14px; transition: opacity 1s; }
  .g3[data-phase='intro'] .g3-tools { opacity: 0; pointer-events: none; }
  .g3-tools .btn[aria-pressed='true'] { color: #ff8a8a; }
  /* The secret flower's lines: a soft veil, the garden still moving behind it */
  .g3-secret { position: absolute; inset: 0; z-index: 14; display: grid; place-items: center; padding: 24px;
    background: radial-gradient(ellipse at 50% 50%, rgba(8, 9, 11, .72) 0%, rgba(8, 9, 11, .38) 55%, rgba(8, 9, 11, .1) 100%);
    opacity: 0; transition: opacity 1.4s ease; }
  .g3-secret[hidden] { display: none; }   /* its own display: grid would otherwise keep it over the page */
  .g3-secret.is-open { opacity: 1; }
  .g3-secret figure { position: relative; margin: 0; max-width: min(520px, 86vw); text-align: center; }
  .g3-secret blockquote { margin: 0; }
  .g3-secret p, .g3-secret figcaption { opacity: 0; transform: translateY(6px); transition: opacity 1.1s ease, transform 1.1s ease; transition-delay: calc(.5s + var(--i) * .35s); }
  .g3-secret.is-open p, .g3-secret.is-open figcaption { opacity: 1; transform: none; }
  .g3-secret p { margin: 0; font: italic 400 clamp(16px, 1.7vw, 20px)/1.95 var(--serif); color: #e8e4d0; text-shadow: 0 0 18px rgba(8, 9, 11, .9); }
  .g3[dir='rtl'] .g3-secret p { font-style: normal; }
  .g3-secret figcaption { margin-top: 26px; font: .66rem/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; color: #ff8a8a; opacity: 0; }
  .g3-secret.is-open figcaption { opacity: .75; }
  .g3-secret-x { position: absolute; top: -34px; inset-inline-end: -6px; padding: 4px 8px; border: 0; background: none; cursor: pointer; font: 400 18px/1 var(--font-mono); color: #55555c; transition: color .2s; }
  .g3-secret-x:hover, .g3-secret-x:focus-visible { color: #cfcfcf; }
  .g3-secret-x:focus-visible { outline: 1px dotted #ff8a8a; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .g3-secret, .g3-secret p, .g3-secret figcaption { transition-duration: .01s; transition-delay: 0s; } }

  /* Hide layout: everything over the garden fades out but the button that brings it back */
  .g3-ui, .g3-actions, .g3-box, .g3-pins, .g3-lines, .g3-fact, .g3-tools .btn { transition: opacity .5s; }
  .g3.is-clean :is(.g3-ui, .g3-actions, .g3-box, .g3-pins, .g3-lines, .g3-tip, .g3-fact, .g3-tools .btn:not(.g3-clean)) { opacity: 0 !important; visibility: hidden; pointer-events: none; }
  .g3.is-clean .g3-pin { visibility: hidden !important; pointer-events: none !important; }   /* the cards set their own visibility */
  .g3.is-clean .g3-clean { opacity: .55; } .g3.is-clean .g3-clean:hover, .g3.is-clean .g3-clean:focus-visible { opacity: 1; }
  :global(body:has(.g3.is-clean) .hb-top) { opacity: 0 !important; visibility: hidden; pointer-events: none; }   /* !important: its slide-in animation would hold it visible */
  @media (max-width: 760px) { .g3-tools { top: 150px; bottom: auto; right: 16px; } }

  /* Old-game hover card: neon double border, pixel corners, scanlines */
  .g3-tip {
    --neon: #ff8a8a;
    position: absolute; top: 0; left: 0; z-index: 12; pointer-events: none; max-width: 240px;   /* above the cards, buttons and story box */
    padding: 8px 11px 9px; background-color: rgba(6, 8, 12, .82);
    border: 1px solid var(--neon); outline: 1px solid color-mix(in srgb, var(--neon) 35%, transparent); outline-offset: 2px;
    box-shadow: 0 0 10px color-mix(in srgb, var(--neon) 55%, transparent), inset 0 0 8px color-mix(in srgb, var(--neon) 25%, transparent);
    font: .72rem/1.45 var(--font-mono); color: #d8d8d8;
    background-image: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255, 255, 255, .035) 2px 3px);
  }
  .g3-tip::before, .g3-tip::after { content: ''; position: absolute; width: 5px; height: 5px; background: var(--neon); }
  .g3-tip::before { top: -3px; left: -3px; }
  .g3-tip::after { bottom: -3px; right: -3px; }
  .g3-tip b { display: block; color: var(--neon); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; text-shadow: 0 0 6px var(--neon); }

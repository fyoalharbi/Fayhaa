---
// The secret philosophy page (/papillon/), unlocked by catching the butterfly: a real-time ASCII render of the flowers,
// bushes, a bee and butterflies (public/js/garden3d.js), with a guided tour: a
// dialogue box at the bottom tells the philosophy line by line while the camera
// moves to each line's subject (the white butterfly, the bee, the hive, a far
// flower, the whole garden). It runs as one experience: an intro screen asks to
// start the journey; the garden appears and the story plays with the site header
// tucked away; at the end the top bar returns and retro callout lines pin my
// projects to flowers in the garden.
import Herb from '../layouts/Herb.astro';
import { secretFlower } from '../data/secretFlower';
import { philosophy, type Lang } from '../data/profile';
import { url, langUrl, getProjects, projectHref } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const t = ar
  ? { title: 'الحديقة', kicker: '// GARDEN_3D', hint: 'اسحب للالتفاف · مرّر للتقريب', follow: 'تابع الفراشة', free: 'كاميرا حرة', back: 'رجوع للموقع',
      tour: 'ليش؟', soundOn: 'الصوت: شغّال', soundOff: 'الصوت: مطفي', capture: 'التقط صورة', close: 'إغلاق', hide: 'إخفاء الواجهة', unhide: 'إظهار الواجهة', bloom: 'مشاريعي تزهر هنا · اضغط على زهرة', next: 'التالي', skip: 'تخطَّ', again: 'من جديد', blog: 'اقرأ المدونة', end: 'طارت. وأنت؟', sub: 'فلسفتي الحياتية',
      who: { butterfly: 'الفراشة', bee: 'النحلة', hive: 'الخلية', far: 'زهرة بعيدة', wide: 'الحديقة' } }
  : { title: 'The garden', kicker: '// GARDEN_3D', hint: 'drag to orbit · scroll to zoom', follow: 'Follow the butterfly', free: 'Free camera', back: 'Back to the site',
      tour: 'Why?', soundOn: 'sound: on', soundOff: 'sound: off', capture: 'capture', close: 'close', hide: 'hide layout', unhide: 'show layout', bloom: 'my projects bloom here · pick a flower', next: 'Next', skip: 'Skip', again: 'Replay', blog: 'Read the blog', end: 'It flew away. Your turn.', sub: 'my philosophy.',
      who: { butterfly: 'the butterfly', bee: 'the bee', hive: 'the hive', far: 'a far flower', wide: 'the garden' } };
const lines = philosophy.lines[lang];
// Hover cards, old-game style: name, a "stat" line, a note
const INFO = ar ? {
  me: ['الفراشة البيضاء', 'المدى: بعيد · الزيارات: كثيرة', 'هذي أنا. أزور كل زهرة وأوصل بين الحدايق.'],
  butterfly: ['فراشة', 'المدى: بعيد', 'تطير أبعد، وتزور زهور محد يوصلها.'],
  bee: ['النحلة', 'المدى: قريب · الإتقان: عالي', 'تبقى قريب من خليتها، وشاطرة بشغلها.'],
  hive: ['الخلية', 'البيت', 'كل رحلات النحلة تبدأ وتنتهي هنا.'],
  daisy: ['أقحوانة', 'زهرة', 'نقطة بيانات صغيرة، تستاهل زيارة.'],
  tulip: ['توليب', 'زهرة', 'فكرة مغلقة تنتظر أحد يفتحها.'],
  cosmos: ['كوزموس', 'زهرة', 'تنبت حيث مرّ اللقاح.'],
  bush: ['شجيرة', 'خضرة', 'الأساس الهادي اللي يشيل الحديقة.'],
  'flowering bush': ['شجيرة مزهرة', 'خضرة + زهور', 'عناقيد أفكار من مجالات مختلفة.'],
} : {
  me: ['The white butterfly', 'RANGE: far · VISITS: many', "That's me. I visit every flower and connect the gardens."],
  butterfly: ['Butterfly', 'RANGE: far', 'Flies farther, to flowers no one else reaches.'],
  bee: ['The bee', 'RANGE: near · SKILL: high', "Stays close to home, and it's excellent at it."],
  hive: ['The hive', 'HOME BASE', "Every one of the bee's trips starts and ends here."],
  daisy: ['Daisy', 'FLOWER', 'A small data point, worth a visit.'],
  tulip: ['Tulip', 'FLOWER', 'A closed idea, waiting for someone to open it.'],
  cosmos: ['Cosmos', 'FLOWER', 'Grows wherever the pollen landed.'],
  bush: ['Bush', 'GREENERY', 'The quiet groundwork that holds the garden together.'],
  'flowering bush': ['Flowering bush', 'GREENERY + BLOOMS', 'Clusters of ideas from different fields.'],
};
// Which subject the camera visits for each line (same order as the philosophy lines)
const SHOTS = ['wide', 'butterfly', 'butterfly', 'bee', 'bee', 'hive', 'butterfly', 'far', 'wide', 'butterfly', 'wide', 'butterfly'];
// Field notes: on some lines a callout points at the subject with a real fact
const FACTS = ar ? {
  1: ['عمر الفراشة', 'البالغة: ٢–٤ أسابيع', 'معظم الفراشات تعيش أسابيع قليلة بعد ما تطلع من الشرنقة. جيل الملكة المهاجر يعيش لين ٨ شهور.'],
  2: ['نقل اللقاح', 'على الأرجل والجسم', 'وهي تشرب الرحيق، يعلق اللقاح على أرجلها الطويلة وجسمها وينتقل للزهرة الجاية.'],
  3: ['النحلة العاملة', 'العمر: ~٦ أسابيع بالصيف', 'تقضي آخر أسابيعها تجمع الرحيق واللقاح للخلية.'],
  5: ['مدى النحلة', 'غالباً أقل من ~٣ كم', 'نحل العسل يرعى عادة قريب من الخلية، ويرجع دايم لنفس الزهور.'],
  6: ['مدى الفراشة', 'الملكة: لين ~٤٨٠٠ كم', 'فراشة الملكة تهاجر عبر قارة كاملة، وتزور زهور ما توصلها النحلة.'],
} : {
  1: ['Lifespan', 'ADULT: 2–4 weeks', 'Most butterflies live only a few weeks after leaving the chrysalis. The migrating monarch generation can last up to 8 months.'],
  2: ['Pollen carrier', 'ON LEGS + BODY', 'While it drinks nectar, pollen sticks to its long legs and body and rides along to the next flower.'],
  3: ['Worker bee', 'LIFESPAN: ~6 weeks in summer', 'It spends its last weeks foraging nectar and pollen for the hive.'],
  5: ['Bee range', 'USUALLY < ~3 km', 'Honeybees mostly forage close to the hive, and keep returning to the same flowers.'],
  6: ['Butterfly range', 'MONARCH: up to ~4,800 km', 'Monarchs migrate across a whole continent, reaching flowers no bee ever will.'],
};
const FACT_ON = { 1: 'butterfly', 2: 'butterfly', 3: 'bee', 5: 'bee', 6: 'butterfly' };
const steps = lines.map((line, i) => ({ line, shot: SHOTS[i] || 'wide', fact: FACTS[i] || null, on: FACT_ON[i] || null }));
// Projects pinned to flowers at the end of the journey
const projects = (await getProjects(lang)).slice(0, 6).map((p) => ({ title: p.data.title, summary: p.data.summary, ...projectHref(p) }));
---
<Herb lang={lang} title={t.title} path="papillon/" noindex bare>
  <main id="main">
  <div class="g3" id="g3" data-phase="intro" dir={ar ? 'rtl' : 'ltr'}>
    <canvas id="g3-canvas" aria-label={t.title}></canvas>

    <!-- 1. Intro: nothing but the question -->
    <div class="g3-intro" id="g3-intro">
      <p class="g3-intro-k mono">{t.sub}</p>
      <h1 class="g3-intro-t">{philosophy.title[lang]}</h1>
      <button class="btn g3-start" id="g3-start" type="button">{t.tour}</button>
    </div>

    <!-- 3. The end: projects pinned to flowers with retro callout lines -->
    <svg class="g3-lines" id="g3-lines" aria-hidden="true"></svg>
    <div class="g3-pin g3-fact" id="g3-fact" aria-live="polite"><b></b><em></em><span></span></div>
    <nav class="g3-pins" id="g3-pins" aria-label={ar ? 'مشاريعي' : 'My projects'}>
      {projects.map((p) => (
        <a class="g3-pin" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
          <b>{p.title}</b><span>{p.summary}</span>
        </a>
      ))}
    </nav>
    <div class="g3-ui mono">
      <p class="g3-title">{philosophy.title[lang]}</p>
      <p class="g3-sub" id="g3-sub">{t.sub}</p>
      <p class="g3-hint">{t.hint}</p>
    </div>

    {secretFlower.lines.length > 0 && (
      <div class="g3-secret" id="g3-secret" hidden>
        <figure>
          <button class="g3-secret-x" id="g3-secret-x" type="button" aria-label={t.close}>×</button>
          <blockquote>{secretFlower.lines.map((l, i) => <p dir="auto" style={"--i:" + i}>{l}</p>)}</blockquote>
        </figure>
      </div>
    )}
    <div class="g3-tip" id="g3-tip" role="tooltip" hidden><b id="g3-tip-t"></b><em id="g3-tip-s"></em><span id="g3-tip-n"></span></div>

    <section class="g3-box" id="g3-box" aria-live="polite" data-state="off">
      <p class="g3-who mono" id="g3-who"></p>
      <p class="g3-line" id="g3-line"></p>
      <div class="g3-row">
        <span class="g3-dots" aria-hidden="true">{steps.map(() => <i></i>)}</span>
        <span class="g3-btns">
          <a class="btn g3-blog" href={langUrl(lang, 'blog/')}>{t.blog}</a>
          <button class="btn g3-skip" id="g3-skip" type="button">{t.skip}</button>
          <button class="btn g3-next" id="g3-next" type="button">{t.tour}</button>
        </span>
      </div>
    </section>

    <div class="g3-tools">
      <button class="btn" id="g3-sound" type="button" aria-pressed="false">{t.soundOff}</button>
      <button class="btn" id="g3-cap" type="button">{t.capture}</button>
      <button class="btn g3-clean" id="g3-clean" type="button" aria-pressed="false">{t.hide}</button>
    </div>

    <div class="g3-actions">
      <button class="btn" id="g3-follow" type="button" data-on={t.free} data-off={t.follow}>{t.follow}</button>
      <a class="btn" href={langUrl(lang)}>{t.back}</a>
    </div>
  </div>

  </main>

  <script is:inline define:vars={{ src: url('js/garden3d.js'), steps, t, INFO, nPins: projects.length }}>
    (function () {
      try { localStorage.setItem('fayhaa:papillon', '1'); } catch (e) {}
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const box = document.getElementById('g3-box'), lineEl = document.getElementById('g3-line'), whoEl = document.getElementById('g3-who');
      const nextBtn = document.getElementById('g3-next'), skipBtn = document.getElementById('g3-skip');
      const dots = [...box.querySelectorAll('.g3-dots i')];
      let g = null, step = -1;

      // Decode a line in: 0/1 noise resolving into letters (same feel as the story page)
      function decode(el, text) {
        cancelAnimationFrame(el._raf || 0);
        const chars = [...text], n = chars.length, at = chars.map((_, i) => (i / n) * 0.7 + Math.random() * 0.12);
        const t0 = performance.now(), dur = REDUCED ? 0 : Math.min(1200, 400 + n * 12);
        const frame = (now) => {
          const k = dur ? (now - t0) / dur : 2; let out = '', done = true;
          for (let i = 0; i < n; i++) {
            if (chars[i] === ' ' || k >= at[i] + 0.18) out += chars[i];
            else { out += Math.random() < 0.5 ? '0' : '1'; done = false; }
          }
          el.textContent = out;
          if (!done) el._raf = requestAnimationFrame(frame);
        };
        el._raf = requestAnimationFrame(frame);
      }
      const root = document.getElementById('g3'), subEl = document.getElementById('g3-sub');
      const fact = document.getElementById('g3-fact'), FS = { init: false };
      const pins = [...document.querySelectorAll('.g3-pins .g3-pin')], svg = document.getElementById('g3-lines');
      let anchors = [];
      const setPhase = (ph) => { root.dataset.phase = ph; setTimeout(() => dispatchEvent(new Event('resize')), 30); };

      function show(i) {
        step = i;
        dots.forEach((d, k) => { d.classList.toggle('is-on', k <= i); d.classList.toggle('is-now', k === i); });
        if (i >= steps.length) return finish();
        box.dataset.state = 'tour';
        const st = steps[i];
        if (g) { g.setShot(st.shot); g.stage = i / (steps.length - 1); g.rain = i === 1; }      // a brief rain on "their lifespan is short"
        root.style.setProperty('--stage', (i / (steps.length - 1)).toFixed(2));
        whoEl.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(steps.length).padStart(2, '0') + ' · ' + t.who[st.shot];
        decode(lineEl, st.line);
        nextBtn.textContent = t.next;
        fact.dataset.on = '0'; FS.init = false;
        if (st.fact) {
          const [a, b, c] = st.fact;
          fact.querySelector('b').textContent = a; fact.querySelector('em').textContent = b; fact.querySelector('span').textContent = c;
          setTimeout(() => { if (step === i) fact.dataset.on = '1'; }, REDUCED ? 0 : 1100);    // after the camera arrives
        }
      }
      // 2. The journey: the garden fades in, the story starts on its own
      function begin() {
        setPhase('journey');
        box.classList.add('is-enter');
        setTimeout(() => box.classList.remove('is-enter'), REDUCED ? 0 : 2300);
        setTimeout(() => show(0), REDUCED ? 0 : 900);
      }
      // 3. The end: header back, camera wide and slow, projects bloom on the flowers
      function finish() {
        step = steps.length; fact.dataset.on = '0';
        box.dataset.state = 'end'; whoEl.textContent = '';
        decode(lineEl, t.end); nextBtn.textContent = t.again;
        if (g) { g.setShot('wide'); g.slowSpin = true; g.stage = 1; g.rain = false; anchors = g.spreadFlowers(nPins); }
        root.style.setProperty('--stage', '1');
        subEl.textContent = t.bloom;
        setPhase('end');
      }
      document.getElementById('g3-start').addEventListener('click', begin);
      nextBtn.addEventListener('click', () => { if (step >= steps.length) { if (g) g.slowSpin = false; setPhase('journey'); show(0); } else show(step + 1); });
      skipBtn.addEventListener('click', finish);
      // Hide layout: only the garden stays, and one small button (or Esc) brings everything back
      const cleanBtn = document.getElementById('g3-clean');
      const setClean = (on) => { root.classList.toggle('is-clean', on); cleanBtn.setAttribute('aria-pressed', String(on)); cleanBtn.textContent = on ? t.unhide : t.hide; };
      cleanBtn.addEventListener('click', () => setClean(!root.classList.contains('is-clean')));
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && root.classList.contains('is-clean')) { setClean(false); return; }
        if (root.dataset.phase === 'intro') { if (e.key === 'Enter') begin(); return; }
        if (box.dataset.state !== 'tour') return;
        if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); nextBtn.click(); }
        if (e.key === 'Escape') finish();
      });

      // Callout lines: from each flower, a short diagonal then a straight run to its label.
      // With a mouse, only the flower you point at (or its open label) shows its label;
      // on touch screens every label stays visible.
      const HOVER = matchMedia('(hover: hover)').matches;
      let pmx = -1, pmy = -1, hoverPin = -1, openPin = -1;
      root.addEventListener('pointermove', (e) => { const r = root.getBoundingClientRect(); pmx = e.clientX - r.left; pmy = e.clientY - r.top; });
      root.addEventListener('pointerleave', () => { pmx = -1; });
      pins.forEach((el, k) => { el.addEventListener('pointerenter', () => { hoverPin = k; }); el.addEventListener('pointerleave', () => { if (hoverPin === k) hoverPin = -1; }); });
      // Rising pollen on each project flower: tiny glyphs drift up and fade; pointing at a
      // flower makes more of it rise, and some climbs the callout line to the label
      const POLLEN = ['.', '·', '·', '*', '°'], motes = [];
      let lastT = performance.now();
      const esc = (c) => (c === '<' ? '&lt;' : c);
      function drawPins() {
        requestAnimationFrame(drawPins);
        const now = performance.now(), dt = Math.min(0.05, (now - lastT) / 1000); lastT = now;
        if (root.dataset.phase === 'journey' && g) {
          // Journey: one callout from the subject to its fact card
          const st = steps[step];
          if (!st || !st.on || fact.dataset.on !== '1') { svg.innerHTML = ''; return; }
          const pos = st.on === 'bee' ? g.bee.p : g.flyers[0].p, sc = g.toScreen(pos);
          if (!sc) { svg.innerHTML = ''; return; }
          // Steady callout near the subject: the anchor is smoothed (the butterfly jitters as it
          // flutters), the card eases after it, and it only swaps sides with some hysteresis
          const W = root.clientWidth, H = root.clientHeight, lw = fact.offsetWidth, lh = fact.offsetHeight;
          const k1 = 1 - Math.exp(-dt * 9), k2 = 1 - Math.exp(-dt * 3.5);
          if (!FS.init) Object.assign(FS, { ax: sc[0], ay: sc[1], cx: sc[0], cy: sc[1], side: sc[0] < W / 2 ? 1 : -1, init: true });
          FS.ax += (sc[0] - FS.ax) * k1; FS.ay += (sc[1] - FS.ay) * k1;
          if (FS.side > 0 && FS.ax > W * 0.62) FS.side = -1; else if (FS.side < 0 && FS.ax < W * 0.38) FS.side = 1;
          const gap = 70, wantX = FS.side > 0 ? FS.ax + gap : FS.ax - gap - lw, wantY = FS.ay - lh - 46;
          FS.cx += (wantX - FS.cx) * k2; FS.cy += (wantY - FS.cy) * k2;
          const lx = Math.max(12, Math.min(W - lw - 12, FS.cx)), ly = Math.max(70, Math.min(H - 200 - lh, FS.cy));
          const ex = FS.side > 0 ? lx - 4 : lx + lw + 4, ey = ly + lh;           // the line meets the card's lower corner
          const bx = FS.ax + (ex - FS.ax) * 0.35;
          fact.style.transform = `translate(${lx.toFixed(1)}px, ${ly.toFixed(1)}px)`;
          svg.innerHTML = `<polyline points="${FS.ax.toFixed(1)},${FS.ay.toFixed(1)} ${bx.toFixed(1)},${ey.toFixed(1)} ${ex.toFixed(1)},${ey.toFixed(1)}"/><circle class="g3-glow is-lit" cx="${FS.ax.toFixed(1)}" cy="${FS.ay.toFixed(1)}" r="16"/>`;
          return;
        }
        if (root.dataset.phase !== 'end' || !g || !anchors.length) return;
        const W = root.clientWidth, H = root.clientHeight, top = 150, bot = H - 190;
        const pts = anchors.map((h, k) => ({ k, s: g.toScreen([h.x, h.y, h.z]) })).filter((o) => o.s);
        const sides = [pts.filter((o) => o.s[0] < W / 2), pts.filter((o) => o.s[0] >= W / 2)];
        let paths = '';
        const on = new Set();
        // Which flower is pointed at: the nearest marker within reach, or the label under the pointer
        if (HOVER) {
          let best = -1, bd = 34;
          for (const o of pts) { const d = Math.hypot(o.s[0] - pmx, o.s[1] - pmy); if (pmx >= 0 && d < bd) { bd = d; best = o.k; } }
          openPin = hoverPin >= 0 ? hoverPin : best;
        }
        root.classList.toggle('is-pointing', HOVER && openPin >= 0);
        sides.forEach((list, side) => {
          list.sort((a, b) => a.s[1] - b.s[1]);
          list.forEach((o, j) => {
            const el = pins[o.k]; if (!el) return;
            const ly = top + (bot - top) * ((j + 0.5) / list.length), lw = el.offsetWidth, lh = el.offsetHeight;
            const lx = side ? W - 24 - lw : 24, ex = side ? lx - 6 : lx + lw + 6, ey = ly + lh / 2;
            el.style.transform = `translate(${lx}px, ${ly}px)`;
            const [fx, fy] = o.s, dy = ey - fy, mx = fx + (side ? 1 : -1) * Math.abs(dy) * 0.6;
            const bx = side ? Math.min(Math.max(mx, fx), ex) : Math.max(Math.min(mx, fx), ex);
            const lit = !HOVER || o.k === openPin;
            if (lit) { on.add(el); paths += `<polyline points="${fx},${fy} ${bx},${ey} ${ex},${ey}"/>`; }
            // Spawn: a slow trickle always, a fountain while pointed at
            const rate = REDUCED ? 0 : lit ? 18 : 5.5;
            if (Math.random() < rate * dt) motes.push({ k: o.k, x: (Math.random() - 0.5) * 14, y: 0, vx: (Math.random() - 0.5) * 8, vy: -(14 + Math.random() * 16) * (lit ? 1.6 : 1), age: 0, life: 1.6 + Math.random() * 1.4, ch: POLLEN[(Math.random() * POLLEN.length) | 0], line: lit && Math.random() < 0.35, path: [fx, fy, bx, ey, ex, ey] });
            o.fx = fx; o.fy = fy;
            // Every project flower keeps a small target marker, so there is something to point at
            // The flower head glows: a soft warm light behind it, brighter when pointed at
            paths += `<circle class="g3-glow${lit ? ' is-lit' : ''}" style="--d:${(o.k * 0.37) % 2.4}s" cx="${fx}" cy="${fy}" r="${lit ? 24 : 17}"/>`;
            o.lit = lit;
          });
        });
        // Pollen motes, in the garden's own glyphs
        const where = {};
        for (const o of pts) where[o.k] = o;
        for (let i = motes.length - 1; i >= 0; i--) {
          const m = motes[i]; m.age += dt;
          const o = where[m.k];
          if (!o || m.age > m.life) { motes.splice(i, 1); continue; }
          let x, y, a = Math.sin(Math.PI * Math.min(1, m.age / m.life));
          if (m.line && o.lit) {
            // Climb the callout: along the diagonal, then the straight run to the label
            const P = m.path, k = Math.min(1, m.age / m.life) * 2;
            const [x0, y0, x1, y1] = k < 1 ? [P[0], P[1], P[2], P[3]] : [P[2], P[3], P[4], P[5]], f = k < 1 ? k : k - 1;
            x = x0 + (x1 - x0) * f; y = y0 + (y1 - y0) * f;
          } else {
            m.x += (m.vx + Math.sin((m.age + m.k) * 3) * 6) * dt; m.y += m.vy * dt;
            x = o.fx + m.x; y = o.fy + m.y;
          }
          paths += `<text class="g3-mote" x="${x.toFixed(1)}" y="${y.toFixed(1)}" opacity="${(a * (o.lit ? 1 : 0.85)).toFixed(2)}">${esc(m.ch)}</text>`;
        }
        svg.innerHTML = paths;
        pins.forEach((el) => { const v = on.has(el) ? '1' : '0'; if (el.dataset.on !== v) el.dataset.on = v; });   // only on change, so the fade isn't restarted
      }
      drawPins();

      const s = document.createElement('script');
      s.src = src;
      s.onload = () => {
        g = new window.Garden3D(document.getElementById('g3-canvas'));
        // ── Sound (off until asked): crickets, a hum near the bee, a chime when a flower opens, wind ──
        let A = null;
        const sndBtn = document.getElementById('g3-sound');
        function startAudio() {
          const ac = new (window.AudioContext || window.webkitAudioContext)(), out = ac.createGain();
          out.gain.value = 0.5; out.connect(ac.destination);
          const noiseBuf = ac.createBuffer(1, ac.sampleRate * 2, ac.sampleRate), nd = noiseBuf.getChannelData(0);

---
// Hidden 3D garden walk (/papillon/garden/): an endless straight path through a
// night border garden, rendered in ASCII in real time (public/js/garden3d.js).
// Reached from the end of the secret philosophy page.
import Base from '../layouts/Base.astro';
import { type Lang } from '../data/profile';
import { url, langUrl } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const t = ar
  ? { title: 'الحديقة', kicker: '// GARDEN_3D', hint: 'اسحب لتتلفت · مرّر لتمشي', pause: 'وقّف', walk: 'امشِ', back: 'رجوع للقصة' }
  : { title: 'The garden', kicker: '// GARDEN_3D', hint: 'drag to look around · scroll to walk', pause: 'Pause', walk: 'Walk', back: 'Back to the story' };
---
<Base lang={lang} title={t.title} path="papillon/garden/" noindex>
  <div class="g3" dir={ar ? 'rtl' : 'ltr'}>
    <canvas id="g3-canvas" aria-label={t.title}></canvas>
    <div class="g3-ui mono">
      <p class="g3-kicker" dir="ltr">{t.kicker}</p>
      <p class="g3-hint">{t.hint}</p>
    </div>
    <div class="g3-actions">
      <button class="btn" id="g3-walk" type="button" data-pause={t.pause} data-walk={t.walk}>{t.pause}</button>
      <a class="btn" href={langUrl(lang, 'papillon/')}>{t.back}</a>
    </div>
  </div>

  <script is:inline define:vars={{ src: url('js/garden3d.js') }}>
    (function () {
      try { localStorage.setItem('fayhaa:papillon', '1'); } catch (e) {}
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => {
        const g = new window.Garden3D(document.getElementById('g3-canvas'));
        const btn = document.getElementById('g3-walk');
        const label = () => { btn.textContent = g.walking ? btn.dataset.pause : btn.dataset.walk; };
        label();
        btn.addEventListener('click', () => { g.setWalking(!g.walking); label(); });
      };
      document.body.appendChild(s);
    })();
  </script>
</Base>

<style>
  .g3 { position: relative; height: calc(100svh - var(--header-h)); overflow: hidden; color: var(--paper); background: #07080a; }
  .g3 canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
  .g3 canvas:active { cursor: grabbing; }
  .g3-ui { position: absolute; top: 16px; inset-inline-start: 20px; pointer-events: none; }
  .g3-kicker { margin: 0 0 4px; color: #ff8a8a; }
  .g3-hint { margin: 0; color: #8a8a92; font-size: .8rem; }
  .g3-actions { position: absolute; bottom: 20px; inset-inline-start: 20px; display: flex; flex-wrap: wrap; gap: 10px; }
  .g3-actions .btn { border-color: var(--paper); color: var(--paper); background: rgba(7, 8, 10, .75); }
  .g3-actions .btn:first-child { background: #ff8a8a; border-color: #ff8a8a; color: #111; }
</style>

---
// Secret philosophy page (/papillon/): a scroll-told dialogue over a sticky
// ASCII night garden. Scrollytelling rules it follows:
//  - Scroll is the clock: words, flower growth, the act bar and the dawn are
//    scrubbed by scroll position (reversible, reader sets the pace, no timers
//    gating the text). Ambient motion (sway, wings, pollen) runs on its own.
//  - One idea per line, one visible change in the garden per line.
//  - A clear arc in five acts with a hook, a turn (bees stay home, butterflies
//    travel and connect far gardens) and a resolution (dawn, the butterfly
//    leaves), then a call to action.
//  - Progressive enhancement: the text is real DOM, readable without JS, with
//    reduced motion, and by screen readers. Unlocked by catching the butterfly.
import Base from '../layouts/Base.astro';
import { philosophy, type Lang } from '../data/profile';
import { url, langUrl } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const lines = philosophy.lines[lang];
const ar = lang === 'ar';
const t = ar
  ? { kicker: '// قناة_سرية', found: 'لقيت الفراشة.', hint: '١٢ سطر · دقيقة وحدة', scroll: 'انزل', back: 'رجوع للموقع', blog: 'اقرأ المدونة', end: 'طارت. وأنت؟', visits: 'زيارات', range: 'مدى', gardens: 'حدايق', fly: 'فراشة', bee: 'نحلة', far: 'حديقة بعيدة', tags: ['بيانات', 'تصميم', 'كود'] }
  : { kicker: '// SECRET_CHANNEL', found: 'You caught the butterfly.', hint: '12 lines · about a minute', scroll: 'scroll', back: 'Back to the site', blog: 'Read the blog', end: 'It flew away. Your turn.', visits: 'visits', range: 'range', gardens: 'gardens', fly: 'butterfly', bee: 'bee', far: 'far garden', tags: ['data', 'design', 'code'] };

// Five acts: the line each one starts on, and its name
const ACTS = [
  { from: 0, en: 'the question', ar: 'السؤال' },
  { from: 2, en: 'the job', ar: 'المهمة' },
  { from: 3, en: 'the bee', ar: 'النحلة' },
  { from: 6, en: 'the distance', ar: 'المسافة' },
  { from: 9, en: 'the engine', ar: 'المحرك' },
];
const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const actOf = (i: number) => ACTS.reduce((a, act, k) => (i >= act.from ? k : a), 0);
const actLen = ACTS.map((a, k) => (ACTS[k + 1]?.from ?? lines.length) - a.from);

// Lines split into words so the reveal can be scrubbed word by word
const words = lines.map((l) => l.split(' '));

// Flowers: digitized sprites (public/js/garden.js) drawn on the same cell grid as
// the butterfly. x position (%), the line they grow on, the petal shape, and the
// colour the petals turn once the garden is diverse. Left = near the hive,
// right = the far garden only the butterfly reaches, middle = what sprouts after.
const FLOWERS = [
  { x: 8, at: 2, k: 'daisy', c: '#ff8a8a' }, { x: 21, at: 3, k: 'round', c: '#e6c34a' }, { x: 31, at: 8, k: 'star', c: '#8ac6ff' },
  { x: 40, at: 2, k: 'tulip', c: '#ff8a8a' }, { x: 51, at: 8, k: 'daisy', c: '#c49aff' }, { x: 61, at: 11, k: 'round', c: '#7fe0b0' },
  { x: 75, at: 6, k: 'daisy', c: '#8ac6ff' }, { x: 85, at: 6, k: 'star', c: '#c49aff' }, { x: 94, at: 7, k: 'tulip', c: '#e6c34a' },
  { x: 67, at: 10, k: 'star', c: '#ff8a8a' },
];
const NEAR = [1, 0, 3], FAR = [6, 7, 8];
const TAGS = [{ x: 22, i: 0 }, { x: 51, i: 1 }, { x: 84, i: 2 }];
const GRASS_CHARS = ",.'`;\"'.,";
const GRASS = Array.from({ length: 240 }, (_, i) => GRASS_CHARS[(i * 7 + (i >> 2)) % 9]).join('');
const GRASS2 = GRASS.split('').reverse().join('');
const STARS = Array.from({ length: 26 }, (_, i) => ({ x: (i * 37 + 11) % 97, y: 4 + ((i * i * 13 + i * 29) % 44), c: i % 4 ? '.' : '+', d: (i % 7) * 0.6 }));
const SUN = ' \\ | / \n-- O --\n / | \\ ';
---
<Base lang={lang} title={philosophy.title[lang]} path="papillon/" noindex>
  <div class="pap" id="pap" dir={ar ? 'rtl' : 'ltr'}>
    <div class="pap-stage" id="pap-stage" aria-hidden="true">
      <div class="pap-sky">
        {STARS.map((s) => <span class="pap-star" style={`left:${s.x}%;top:${s.y}%;animation-delay:${s.d}s`}>{s.c}</span>)}
      </div>
      <div class="pap-dawn"></div>
      <pre class="pap-sun">{SUN}</pre>
      {FLOWERS.map((f, i) => (
        <div class="pap-flower" data-at={f.at} data-kind={f.k} data-c={f.c} style={`left:${f.x}%`}>
          <canvas style={`animation-delay:${-(i * 0.7)}s`}></canvas>
        </div>
      ))}
      <div class="pap-hive"><canvas></canvas></div>
      <p class="pap-far mono">{t.far}</p>
      {TAGS.map((tg) => <p class="pap-tag mono" style={`left:${tg.x}%`}>{t.tags[tg.i]}</p>)}
      <div class="pap-grass"><div>{GRASS}</div><div>{GRASS2}</div></div>
      <div class="pap-glow" id="pap-glow"></div>
      <div class="pap-bee" id="pap-bee"><canvas></canvas></div>
      <div class="pap-fly" id="pap-fly"><canvas></canvas></div>

      <div class="pap-hud mono">
        <div class="pap-acts">
          {ACTS.map((_, k) => <span style={`flex-grow:${actLen[k]}`}><i></i></span>)}
        </div>
        <p class="pap-act"><span id="pap-act-n">I</span> · <span id="pap-act-name">{ACTS[0][lang]}</span></p>
      </div>

      <div class="pap-tally mono" id="pap-tally">
        <div><span></span><em>{t.visits}</em><em>{t.range}</em><em>{t.gardens}</em></div>
        <div><span>{t.fly}</span><b data-k="fv">0</b><b data-k="fr">0m</b><b data-k="fg">1</b></div>
        <div><span>{t.bee}</span><b data-k="bv">0</b><b data-k="br">0m</b><b data-k="bg">1</b></div>
      </div>
    </div>

    <div class="pap-script">
      <header class="pap-intro">
        <p class="mono pap-kicker">{t.kicker}</p>
        <h1>{t.found}</h1>
        <p class="mono muted">{t.hint}</p>
        <p class="mono pap-cue">{t.scroll} <span aria-hidden="true">↓</span></p>
      </header>
      {lines.map((_, i) => (
        <section class="pap-step" data-i={i}>
          <div>
            {ACTS.some((a) => a.from === i) && (
              <p class="mono pap-chapter">{ROMAN[actOf(i)]} · {ACTS[actOf(i)][lang]}</p>
            )}
            <p class={i === lines.length - 1 ? 'pap-line is-last' : 'pap-line'} style={`--n:${words[i].length}`}>
              {words[i].map((w, k) => <><span class="pap-w" style={`--k:${k}`}>{w}</span>{k < words[i].length - 1 ? ' ' : ''}</>)}
            </p>
          </div>
        </section>
      ))}
      <footer class="pap-outro pap-step" data-i={lines.length}>
        <p class="pap-end">{t.end}</p>
        <div class="pap-cta">
          <a class="btn" href={langUrl(lang, 'blog/')}>{t.blog}</a>
          <a class="btn" href={langUrl(lang)}>{t.back}</a>
        </div>
      </footer>
    </div>
  </div>

  <script is:inline define:vars={{ flyerSrc: url('js/flyer.js'), gardenSrc: url('js/garden.js'), ACTS, ROMAN, lang, N: lines.length, NEAR, FAR }}>
    (function () {
      try { localStorage.setItem('fayhaa:papillon', '1'); } catch (e) {}
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const PHONE = matchMedia('(max-width: 799px)');
      const root = document.getElementById('pap');
      const stage = document.getElementById('pap-stage');
      const steps = [...document.querySelectorAll('.pap-step')]; // lines + outro
      const lineEls = steps.map((s) => s.querySelector('.pap-line'));
      const flowers = [...stage.querySelectorAll('.pap-flower')];
      const segs = [...stage.querySelectorAll('.pap-acts i')];
      const actN = document.getElementById('pap-act-n'), actName = document.getElementById('pap-act-name');
      const flyEl = document.getElementById('pap-fly'), beeEl = document.getElementById('pap-bee'), glowEl = document.getElementById('pap-glow');
      const hiveEl = stage.querySelector('.pap-hive');
      const tallyEls = Object.fromEntries([...stage.querySelectorAll('[data-k]')].map((b) => [b.dataset.k, b]));
      root.classList.add('is-js');

      // One visible change per line. fly/bee: 'center' | 'away' | 'tour' | [flower, flower…] (hops between)
      const SCENES = [
        { fly: 'center', spot: 1 },                                  // why butterflies?
        { fly: 'center', spot: 1, flicker: 1 },                      // short lifespan
        { fly: [3, 0], trail: 1 },                                   // carries pollen between flowers
        { fly: [3], bee: [1], hive: 1 },                             // the bee arrives from its hive
        { fly: [3, 0], bee: [1, 0], hive: 1, trail: 1 },             // same task, side by side
        { fly: [3], bee: NEAR, hive: 1, beeGlow: 1, tally: 1 },      // bees stay close, and they're excellent
        { fly: [3, ...FAR], bee: NEAR, hive: 1, far: 1, tally: 1, trail: 1 },           // butterflies fly farther
        { fly: [0, 8, 1, 6], bee: NEAR, hive: 1, far: 1, tally: 1, trail: 1, slow: 1 }, // pollen bridges far gardens
        { fly: 'tour', bee: NEAR, hive: 1, diverse: 1, tally: 1 },   // the garden stays diverse
        { fly: 'center', bee: NEAR, hive: 1, diverse: 1, engine: 1, spot: 1 }, // the creative engine
        { fly: 'tour', bee: NEAR, hive: 1, diverse: 1, tags: 1, trail: 1 },    // data, design and code
        { fly: 'tour', bee: NEAR, hive: 1, diverse: 1, trail: 1 },   // keep visiting new flowers
        { fly: 'away', bee: NEAR, hive: 1, diverse: 1 },             // outro: flies off into the dawn
      ];
      const INTRO = { fly: 'center' };
      let active = null, scene = INTRO, p = 0;
      let hopAt = 0, hopIdx = 0, beeAt = 0, beeIdx = 0;
      const tally = { fv: 0, fr: '0m', fg: 1, bv: 0, br: '0m', bg: 1 };
      const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
      const growth = (el) => +el.style.getPropertyValue('--g') || 0;

      // ── Scroll is the clock ─────────────────────
      function focusY() {
        const r = stage.getBoundingClientRect();
        // Desktop: middle of the viewport under the header. Phone: middle of the strip below the stage.
        return PHONE.matches ? (r.bottom + innerHeight) / 2 : (r.top + innerHeight) / 2;
      }
      function update() {
        const f = focusY();
        let a = -1, local = 0;
        steps.forEach((s, i) => {
          const r = s.getBoundingClientRect();
          if (r.top <= f) { a = i; local = (f - r.top) / r.height; }
          // Words arrive as the line rises into the reading zone, done before it reaches the focus line
          const line = lineEls[i];
          if (line) line.style.setProperty('--r', REDUCED ? 1 : clamp((f - r.top + r.height * 0.12) / (r.height * 0.36)).toFixed(3));
        });
        p = a < 0 ? 0 : Math.min(N + 1, a + clamp(local));
        if (a !== active) setScene(a);

        // Flowers grow with the story (scrubbed, so scrolling back un-grows them)
        flowers.forEach((el) => el.style.setProperty('--g', clamp((p - +el.dataset.at + 0.35) / 0.7).toFixed(3)));
        // Act bar fills continuously
        segs.forEach((seg, k) => {
          const from = ACTS[k].from, to = ACTS[k + 1] ? ACTS[k + 1].from : N;
          seg.style.transform = `scaleX(${clamp((p - from) / (to - from)).toFixed(3)})`;
        });
        // The tally is scrubbed too: the bee works hard close to home, while the
        // butterfly's range and the gardens it connects keep growing
        const q = clamp(p - 5, 0, 4);
        tally.bv = Math.round(q * 6); tally.br = Math.round(Math.min(q, 1) * 60) + 'm'; tally.bg = 1;
        tally.fv = Math.round(q * 5);
        tally.fr = q < 1 ? Math.round(q * 80) + 'm' : (0.08 + (q - 1) * 0.6).toFixed(1) + 'km';
        tally.fg = p >= 8.5 ? 3 : p >= 7.3 ? 2 : 1;
        drawTally();
        // Night turns to dawn over the last act
        stage.style.setProperty('--dawn', clamp((p - 9.5) / 3).toFixed(3));
      }
      function setScene(a) {
        active = a;
        scene = a < 0 ? INTRO : SCENES[Math.min(a, SCENES.length - 1)];
        steps.forEach((s, j) => { s.classList.toggle('is-active', j === a); s.classList.toggle('is-past', j < a); });
        const act = ACTS.reduce((x, act, k) => (Math.max(a, 0) >= act.from ? k : x), 0);
        actN.textContent = ROMAN[act]; actName.textContent = ACTS[act][lang];
        for (const k of ['flicker', 'engine', 'beeGlow', 'tally', 'spot', 'hive', 'far', 'diverse', 'tags']) stage.classList.toggle('is-' + k, !!scene[k]);
        hopAt = 0; beeAt = 0;
      }
      let ticking = false;
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      update();

      // ── Garden actors (ambient, time-based) ─────
      // Everything is drawn on one cell grid so the butterfly, flowers, bee and hive match
      const CELL = PHONE.matches ? 6 : 9;
      let sprites = [], beeS = null, hiveS = null;
      function headOf(i) {
        const sp = sprites[i], cv = sp.canvas.getBoundingClientRect(), r = stage.getBoundingClientRect();
        return { x: cv.left - r.left + sp.head.x * (cv.width / sp.width), y: cv.top - r.top + sp.head.y * (cv.height / sp.height) };
      }
      const grown = () => flowers.map((_, i) => i).filter((i) => growth(flowers[i]) > 0.9);
      function drawTally() { for (const k in tally) tallyEls[k].textContent = tally[k]; }
      function puff(x, y, cls, dx, dy, ms) {
        const d = document.createElement('span');
        d.className = 'pap-pollen' + (cls ? ' ' + cls : '');
        d.textContent = Math.random() < 0.2 ? '*' : '·';
        d.style.left = x + 'px'; d.style.top = y + 'px';
        stage.appendChild(d);
        d.animate([{ transform: 'translate(0,0)', opacity: 0 }, { opacity: 1, offset: 0.15 },
          { transform: `translate(${dx}px, ${dy}px)`, opacity: 0 }], { duration: ms, easing: 'ease-out' }).onfinish = () => d.remove();
      }
      // Where an actor is headed: the stage centre, off-screen, or the head of a flower
      function target(spec, idx, isBee) {
        const r = stage.getBoundingClientRect();
        if (spec === 'center') return { x: r.width / 2, y: r.height * 0.36, hop: false };
        if (spec === 'away') return { x: r.width + 160, y: -220, hop: false };
        const list = spec === 'tour' ? grown() : spec.filter((i) => isBee || growth(flowers[i]) > 0.3);
        if (!list.length) return { x: r.width / 2, y: r.height * 0.36, hop: false };
        const h = headOf(list[idx % list.length]);
        return { x: h.x, y: h.y, hop: list.length > 1 };
      }

      function start() {
        sprites = flowers.map((el, i) => new AsciiSprite(el.querySelector('canvas'), { cols: 13, rows: 21, cell: CELL }, AsciiPainters.flower(el.dataset.kind, i)));
        beeS = new AsciiSprite(beeEl.querySelector('canvas'), { cols: 12, rows: 8, cell: CELL }, AsciiPainters.bee());
        hiveS = new AsciiSprite(hiveEl.querySelector('canvas'), { cols: 9, rows: 8, cell: CELL }, AsciiPainters.hive());
        const bf = new AsciiFlyer(flyEl.querySelector('canvas'), { cols: 23, rows: 17, cell: CELL, font: 1, side: true });
        const seatFly = bf.seat(false), seatPerch = bf.seat(true);
        const LEG = 2.5 * CELL;                   // perched: body sits this far above the flower head
        const r0 = stage.getBoundingClientRect();
        const fl = { x: r0.width / 2, y: r0.height * 0.36, vx: 0, vy: 0, facing: 1, perched: false, glide: 0, wand: 0, wx: 0, wy: 0, t: 0, down: 0, perchT: 0, hopT: 0 };
        const bee = { x: -80, y: 0, vx: 0, vy: 0, facing: 1, placed: false };
        let lastT = performance.now(), trailAt = 0, frameN = 0;

        // Pollen drifting up from open flowers (denser and red once the engine starts)
        let tick = 0;
        setInterval(() => {
          tick++;
          if (REDUCED || document.hidden || active < 2 || (!scene.engine && tick % 2)) return;
          const g = grown(); if (!g.length) return;
          const h = headOf(g[(Math.random() * g.length) | 0]);
          puff(h.x, h.y, scene.engine ? 'is-red' : '', (Math.random() - 0.5) * 80, -60 - Math.random() * 80, 2600 + Math.random() * 1600);
        }, 120);

        // Butterfly flight: steer toward the target with a wandering, fluttery line,
        // short glides while cruising, a bob on every downstroke, perch on arrival.
        function flyStep(dt) {
          const away = scene.fly === 'away', loiter = scene.fly === 'center', tour = scene.fly === 'tour';
          const tf = target(scene.fly, hopIdx, false);
          fl.t += dt;
          let tx = tf.x, ty = tf.y;
          if (loiter) { tx += Math.sin(fl.t * 0.8) * 90; ty += Math.sin(fl.t * 1.6) * 30; }
          else if (!away) ty -= LEG;
          const dx = tx - fl.x, dy = ty - fl.y, d = Math.hypot(dx, dy);

          // Visits: stay on a flower for a moment, then move on
          fl.hopT += dt;
          if (tf.hop && ((fl.perched && (fl.perchT += dt) > (tour ? 0.5 : scene.slow ? 1.4 : 0.9)) || fl.hopT > 5)) {
            hopIdx += tour ? 1 + ((Math.random() * 3) | 0) : 1; fl.perchT = 0; fl.hopT = 0;
          }
          if (REDUCED) { fl.x = tx; fl.y = ty; fl.perched = !loiter && !away; return; }

          if (fl.perched) {
            if (!loiter && !away && d < 24) { fl.x = tx; fl.y = ty; return; }   // stay put, riding the sway
            fl.perched = false; fl.vy = -140; fl.vx = (dx >= 0 ? 1 : -1) * 50;  // take off with a hop
          }
          fl.wand -= dt;
          if (fl.wand <= 0) {                       // pick a new random nudge every fraction of a second
            fl.wand = 0.18 + Math.random() * 0.5;
            const a = Math.random() * Math.PI * 2, m = 40 + Math.random() * 90;
            fl.wx = Math.cos(a) * m; fl.wy = Math.sin(a) * m * 0.8;
          }
          const arrive = Math.min(1, d / 170);
          const cruise = away ? 320 : 200;
          const wob = loiter || away ? 1 : arrive;  // steadier on the final approach
          const dvx = (dx / (d || 1)) * cruise * arrive + fl.wx * wob;
          const dvy = (dy / (d || 1)) * cruise * arrive + fl.wy * wob;
          const steer = Math.min(1, dt * (!loiter && d < 60 ? 6 : 2.4));
          fl.vx += (dvx - fl.vx) * steer; fl.vy += (dvy - fl.vy) * steer;
          if (fl.glide > 0) { fl.glide -= dt; fl.vy += 70 * dt; }
          else if (d > 150 && Math.random() < dt * 0.6) fl.glide = 0.25 + Math.random() * 0.45;
          fl.x += fl.vx * dt; fl.y += fl.vy * dt;
          if (Math.abs(fl.vx) > 35) fl.facing = fl.vx > 0 ? 1 : -1;
          if (!loiter && !away && d < 6 && Math.hypot(fl.vx, fl.vy) < 110) { fl.perched = true; fl.perchT = 0; fl.glide = 0; }
        }

        // Bee: direct and busy, with a quick zigzag; lives in the hive between visits
        function beeStep(dt, now) {
          const hv = hiveEl.getBoundingClientRect(), sr = stage.getBoundingClientRect();
          let tx = hv.left - sr.left + hv.width / 2, ty = hv.top - sr.top + hv.height * 0.55, home = true;
          if (scene.bee) {
            beeAt += dt;
            if (scene.bee.length > 1 && beeAt > 1.2) { beeAt = 0; beeIdx++; }
            const h = headOf(scene.bee[beeIdx % scene.bee.length]);
            tx = h.x; ty = h.y - beeS.height * 0.35; home = false;
          }
          if (!bee.placed || REDUCED) { bee.x = tx; bee.y = ty; bee.placed = true; }
          const dx = tx - bee.x, dy = ty - bee.y, d = Math.hypot(dx, dy), arrive = Math.min(1, d / 90);
          bee.vx += ((dx / (d || 1)) * 260 * arrive - bee.vx) * Math.min(1, dt * 5);
          bee.vy += ((dy / (d || 1)) * 260 * arrive - bee.vy) * Math.min(1, dt * 5);
          bee.x += bee.vx * dt; bee.y += bee.vy * dt;
          if (Math.abs(bee.vx) > 25) bee.facing = bee.vx > 0 ? 1 : -1;
          const zig = REDUCED ? 0 : (home ? 0 : 1);
          const x = bee.x + zig * Math.sin(now / 70) * 4, y = bee.y + zig * Math.cos(now / 55) * 3;
          beeEl.style.transform = `translate(${x - beeS.width / 2}px, ${y - beeS.height / 2}px)`;
          beeEl.style.opacity = home && d < 12 ? 0 : 1;   // tucked inside the hive
        }

        function loop(now) {
          requestAnimationFrame(loop);
          const dt = Math.min(0.05, (now - lastT) / 1000); lastT = now;
          frameN++;

          flyStep(dt);
          const bob = fl.perched || fl.glide > 0 || REDUCED ? 0 : -fl.down * 5;
          const seat = fl.perched ? seatPerch : seatFly;
          const ox = fl.perched ? fl.x : fl.x, oy = fl.perched ? fl.y + LEG : fl.y + bob;
          flyEl.style.transform = `translate(${ox - seat.x}px, ${oy - seat.y}px)`;
          glowEl.style.transform = `translate(${fl.x}px, ${fl.y}px)`;
          fl.down = bf.frame(dt, { perched: fl.perched, facing: fl.facing, glide: fl.glide > 0, climb: scene.fly === 'away' ? 1 : 0 }).down || 0;

          trailAt += dt;
          if (scene.trail && !fl.perched && !REDUCED && trailAt > 0.09) {
            trailAt = 0; puff(fl.x, fl.y + CELL, '', (Math.random() - 0.5) * 10, 10 + Math.random() * 14, 1400);
          }

          beeStep(dt, now);
          beeS.draw(dt, { facing: bee.facing, flip: 0.05 });
          if (stage.classList.contains('is-hive') && frameN % 2) hiveS.draw(dt * 2, { flip: 0.02 });

          // Flowers: half of them each frame; petal colour follows the story
          const petal = scene.engine ? '#ff5f5f' : null;
          sprites.forEach((sp, i) => {
            if ((i + frameN) % 2 || growth(flowers[i]) <= 0) return;
            sp.draw(dt * 2, { color: petal || (scene.diverse ? flowers[i].dataset.c : '#ff8a8a') });
          });
        }
        requestAnimationFrame(loop);
      }
      // Load the butterfly and the garden sprites, then start
      let pending = 2;
      for (const src of [flyerSrc, gardenSrc]) {
        const el = document.createElement('script');
        el.src = src; el.onload = () => { if (--pending === 0) start(); };
        document.body.appendChild(el);
      }
    })();
  </script>
</Base>

<style>

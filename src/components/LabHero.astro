---
// Experimental hero for /lab/: one markup, laid out by html[data-layout].
import '../styles/lab.css';
import { profile, type Lang } from '../data/profile';
import { ui, url, hasResume } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="lab-hero">
  <div class="wrap lab-hero-inner">
    <div class="hero-text">
      <p class="kicker mono">
        <span class="dot" aria-hidden="true"></span>{profile.role[lang]} · {profile.availability[lang]}
        <button class="lab-flower" type="button" data-flower aria-label="A small flower">✿</button>
      </p>
      <h1>{profile.name[lang]}</h1>
      <p class="lead">{profile.intro[lang]}</p>
      <ol class="workflow mono" aria-label="Workflow">
        {profile.workflow[lang].map((step) => <li>{step}</li>)}
      </ol>
      <div class="actions">
        <a class="btn btn-primary" href="#projects">{t.viewProjects}</a>
        {hasResume && <a class="btn" href={url('resume.pdf')} download>{t.resume}</a>}
        <a class="btn" href={`mailto:${profile.email}`}>{t.emailMe}</a>
      </div>
    </div>

    <figure class="lab-stage">
      <canvas id="hero-ascii" role="img" aria-label="Animated ASCII art of a butterfly"></canvas>
      <figcaption class="mono">
        <span id="hero-probe">X:[--] Y:[--] VAL:[---]</span>
        <span id="hero-hint">{t.butterflyHint}</span>
        <button class="lab-flower" type="button" data-flower aria-label="A small flower">✿</button>
      </figcaption>
    </figure>
  </div>

  <button id="lab-bee" class="lab-bee mono" type="button" aria-label="A bee" hidden>~(::)&gt;</button>
</section>

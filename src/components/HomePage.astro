---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import { profile, skills, skillGroups, experience, education, type Lang } from '../data/profile';
import { ui, url, langUrl, hasResume, getProjects, projectHref } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
// Skills × projects matrix: rows grouped by category (core skills first),
// one column per project (numbered like the project cards above).
const uses = (p: (typeof projects)[number], key: string) => (p.data.skills as string[]).includes(key);
const columns = projects.map((p, i) => ({
  n: String(i + 1).padStart(2, '0'),
  short: p.data.title.split(' — ')[0],
  ...projectHref(p),
  p,
}));
const groups = Object.keys(skillGroups).map((g) => ({
  key: g,
  label: skillGroups[g][lang],
  items: skills
    .filter((s) => s.group === g)
    .map((s) => ({ ...s, count: projects.filter((p) => uses(p, s.key)).length }))
    .sort((a, b) => Number(b.core) - Number(a.core) || b.count - a.count),
}));

// Sections are numbered in order and alternate white / paper backgrounds;
// the optional experience section shifts the numbering when present.
// (The philosophy is hidden in the hero butterflies, not a section.)
const hasTimeline = experience.length > 0 || education.length > 0;
const order = ['projects', 'skills', ...(hasTimeline ? ['experience'] : []), 'contact'];
const num = (id: string) => order.indexOf(id) + 1;
const tone = (id: string) => (num(id) % 2 ? 'surface' : 'paper') as 'surface' | 'paper';
---
<Base lang={lang} homeRedirect>
  <Hero lang={lang} />

  <!-- ── PROJECTS ── -->
  <Section id="projects" index={num('projects')} tone={tone('projects')} label={t.nav.projects} title={t.featured}>
    {projects.length > featured.length &&
      <a slot="aside" class="mono" href={langUrl(lang, 'projects/')}>{t.allProjects} {lang === 'ar' ? '←' : '→'}</a>}
    <div class="cards">
      {featured.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </Section>

  <!-- ── SKILLS ── -->
  <Section id="skills" index={num('skills')} tone={tone('skills')} label={t.nav.skills} title={t.skillsTitle}>
    <p slot="aside" class="muted">{t.skillsLead}</p>
    <div class="matrix-wrap">
      <table class="skill-matrix" style={`--cols:${columns.length}`}>
        <thead>
          <tr>
            <th scope="col" class="mono">{t.skillCol}</th>
            {columns.map((c) => (
              <th scope="col">
                <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})} title={c.p.data.title}>
                  <span class="mx-num mono">{c.n}</span>
                  <span class="mx-name">{c.short}</span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        {groups.map((g) => (
          <tbody>
            <tr class="mx-group">
              <th scope="colgroup" colspan={columns.length + 1} class="mono">{g.label}</th>
            </tr>
            {g.items.map((s) => (
              <tr class={s.core ? 'is-core' : ''}>
                <th scope="row">
                  <a href={langUrl(lang, `skills/${s.key}/`)}>{s.label[lang]}</a>
                  {s.core && <span class="mx-core mono">{t.core}</span>}
                  {s.count === 0 && <span class="mx-soon mono">{t.noReceipt}</span>}
                </th>
                {columns.map((c) => (
                  <td>
                    {uses(c.p, s.key)
                      ? <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
                           aria-label={`${s.label[lang]}: ${c.p.data.title}`} class="mx-hit">■</a>
                      : <span class="mx-miss" aria-hidden="true">·</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="mx-legend mono" aria-hidden="true">
      {columns.map((c) => <span><b>{c.n}</b> {c.short}</span>)}
    </p>
  </Section>

  <!-- ── EXPERIENCE / EDUCATION (hidden until filled in profile.ts) ── -->
  {hasTimeline && (
    <Section id="experience" index={num('experience')} tone={tone('experience')}
             label={t.experience} title={experience.length ? t.experience : t.education}>
      <div class="timeline-wrap">
        {experience.length > 0 && (
          <ol class="timeline">
            {experience.map((e) => (
              <li>
                <p class="mono muted">{e.period}</p>
                <h3>{e.title[lang]} · {e.org[lang]}</h3>
                <ul>{e.points[lang].map((pt) => <li>{pt}</li>)}</ul>
              </li>
            ))}
          </ol>
        )}
        {education.length > 0 && (
          <div>
            {experience.length > 0 && <h3 class="mono muted timeline-sub">{t.education}</h3>}
            <ol class="timeline">
              {education.map((e) => (
                <li>
                  <p class="mono muted">{e.period}</p>
                  <h3>{e.title[lang]} · {e.org[lang]}</h3>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- ── CONTACT ── -->
  <Section id="contact" index={num('contact')} tone="ink" label={t.nav.contact} title={t.contactTitle}>
    <p class="muted">{t.contactLead} {profile.availability[lang]}.</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="actions">
      <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
      {hasResume && <a class="btn" href={url('resume.pdf')} download>{t.resume}</a>}
    </div>
  </Section>
</Base>

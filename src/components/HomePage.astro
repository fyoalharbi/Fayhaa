---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import { profile, skills, skillGroups, experience, education, certifications, type Lang } from '../data/profile';
import { ui, url, langUrl, hasResume, getProjects, projectHref, formatDate } from '../lib/site';

interface Props { lang: Lang; lab?: boolean }
const { lang, lab = false } = Astro.props;
const t = ui[lang];

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
// Skills explorer: chips grouped by category (core first, then most-used),
// each with a "receipts" panel listing the projects that use it. Scales to
// any number of skills/projects: groups collapse past CHIP_LIMIT, panels
// show the newest RECEIPT_LIMIT projects and link to the full skill page.
const CHIP_LIMIT = 8;
const RECEIPT_LIMIT = 5;
const byDate = [...projects].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const skillInfo = skills.map((s) => {
  const used = byDate.filter((p) => (p.data.skills as string[]).includes(s.key));
  return {
    ...s,
    count: used.length,
    receipts: used.slice(0, RECEIPT_LIMIT).map((p) => ({ title: p.data.title, date: formatDate(p.data.date, lang), ...projectHref(p) })),
  };
});
const groups = Object.keys(skillGroups)
  .map((g) => ({
    key: g,
    label: skillGroups[g][lang],
    items: skillInfo
      .filter((s) => s.group === g)
      .sort((a, b) => Number(b.core) - Number(a.core) || b.count - a.count),
  }))
  .filter((g) => g.items.length);
// Open on the most-used core skill
const initial = [...skillInfo].sort((a, b) => Number(b.core) - Number(a.core) || b.count - a.count)[0]?.key;

// Skills as a pipeline: which tools I use at each stage of the work; the rest are extras
const STAGE_TOOLS: Record<string, string[]> = {
  ingest: ['python', 'rest-apis', 'web-scraping', 'etl'],
  transform: ['sql', 'dbt', 'airflow', 'data-cleaning', 'power-query'],
  model: ['data-modeling', 'snowflake', 'statistics'],
  report: ['power-bi', 'dax', 'dashboard-design', 'streamlit'],
};
const STAGE_WHAT = {
  en: ['Pull data from APIs, files and the web.', 'Clean it, test it, schedule it.', 'Shape it into tables people can trust.', 'Turn it into decisions people can see.'],
  ar: ['أسحب البيانات من الـ APIs والملفات والويب.', 'أنظفها وأختبرها وأجدولها.', 'أشكّلها لجداول يوثق فيها.', 'أحوّلها لقرارات تنشاف.'],
};
const byKey = Object.fromEntries(skillInfo.map((s) => [s.key, s]));
const stages = Object.keys(STAGE_TOOLS).map((k, i) => ({
  name: profile.workflow[lang][i], what: STAGE_WHAT[lang][i],
  tools: STAGE_TOOLS[k].map((key) => byKey[key]).filter(Boolean),
}));
const inStages = new Set(Object.values(STAGE_TOOLS).flat());
const extras = skillInfo.filter((s) => !inStages.has(s.key));

// Sections are numbered in order and alternate white / paper backgrounds;
// the optional experience section shifts the numbering when present.
// (The philosophy is hidden in the hero butterflies, not a section.)
const hasTimeline = experience.length > 0 || education.length > 0;
const order = ['projects', 'skills', ...(hasTimeline ? ['experience'] : []), 'contact'];
const num = (id: string) => order.indexOf(id) + 1;
const tone = (id: string) => (num(id) % 2 ? 'surface' : 'paper') as 'surface' | 'paper';
---
<Base lang={lang} homeRedirect={!lab} noindex={lab} title={lab ? 'Lab' : undefined}>
  <Hero lang={lang} lab={lab} />

  <!-- ── PROJECTS ── -->
  <Section id="projects" index={num('projects')} tone={tone('projects')} label={t.nav.projects} title={t.featured}>
    {projects.length > featured.length &&
      <a slot="aside" class="mono" href={langUrl(lang, 'projects/')}>{t.allProjects} {lang === 'ar' ? '←' : '→'}</a>}
    <div class="cards">
      {featured.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </Section>

  <!-- ── SKILLS: the way I work, as a pipeline ── -->
  <Section id="skills" index={num('skills')} tone={tone('skills')} label={t.nav.skills} title={lang === 'ar' ? 'كيف أشتغل' : 'How I work'}>
    <p slot="aside" class="muted">{lang === 'ar' ? 'مرّر على أي أداة لتشوف المشاريع اللي استخدمتها فيها.' : 'Point at a tool to see the projects I used it in.'}</p>
    <div class="pipe" id="pipe">
      <ol class="pipe-stages">
        {stages.map((st, i) => (
          <li class="pipe-stage">
            <p class="pipe-n mono">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="pipe-name">{st.name}</h3>
            <p class="pipe-what muted">{st.what}</p>
            <ul class="pipe-tools">
              {st.tools.map((s) => (
                <li>
                  <a href={langUrl(lang, `skills/${s.key}/`)} class={`pipe-tool${s.core ? ' is-core' : ''}`} data-skill={s.key}>{s.label[lang]}</a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      <p class="pipe-used" aria-live="polite">
        {skillInfo.filter((s) => s.count).map((s) => (
          <span class="pipe-for" data-for={s.key} hidden={s.key !== initial}>
            <span class="mono">{s.label[lang]} {lang === 'ar' ? '←' : '→'}</span>
            {s.receipts.map((r, k) => <>{k > 0 && <span class="pipe-sep"> · </span>}<a href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener' } : {})}>{r.title.split(/ [—–-] /)[0]}</a></>)}
          </span>
        ))}
      </p>
      <p class="pipe-also mono muted">{lang === 'ar' ? 'وكمان: ' : 'also: '}{extras.map((s, k) => <>{k > 0 && ' · '}<a href={langUrl(lang, `skills/${s.key}/`)}>{s.label[lang]}</a></>)}</p>
    </div>

    <script is:inline>
      // Pointing at (or focusing) a tool shows the projects it was used in
      (function () {
        const root = document.getElementById('pipe'); if (!root) return;
        const show = (key) => {
          const line = root.querySelector(`.pipe-for[data-for="${key}"]`); if (!line) return;
          root.querySelectorAll('.pipe-for').forEach((el) => { el.hidden = el !== line; });
          root.querySelectorAll('.pipe-tool').forEach((el) => el.classList.toggle('is-on', el.dataset.skill === key));
        };
        root.addEventListener('pointerover', (e) => { const a = e.target.closest('.pipe-tool'); if (a) show(a.dataset.skill); });
        root.addEventListener('focusin', (e) => { const a = e.target.closest('.pipe-tool'); if (a) show(a.dataset.skill); });
      })();
    </script>
  </Section>

  <style>
    .pipe-stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
    .pipe-stage { position: relative; padding: 18px 20px 6px 0; }
    .pipe-stage + .pipe-stage { padding-inline-start: 20px; border-inline-start: 1px solid var(--rule); }
    /* the arrow between stages */
    .pipe-stage + .pipe-stage::before { content: '→'; position: absolute; top: -0.75em; inset-inline-start: -0.6em; padding: 0 4px; background: var(--paper); font: 600 0.95rem/1.4 var(--font-mono); color: var(--accent); }
    :global([dir='rtl']) .pipe-stage + .pipe-stage::before { content: '←'; }
    .pipe-n { margin: 0 0 4px; color: var(--accent); }
    .pipe-name { margin: 0 0 4px; font-size: 1.25rem; }
    .pipe-what { margin: 0 0 14px; font-size: 0.85rem; min-height: 2.6em; }
    .pipe-tools { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
    .pipe-tool { display: inline-block; padding: 3px 0; text-decoration: none; color: var(--ink); border-bottom: 1px solid transparent; }
    .pipe-tool.is-core { font-weight: 600; }
    .pipe-tool:hover, .pipe-tool:focus-visible, .pipe-tool.is-on { color: var(--accent); border-bottom-color: currentColor; }
    .pipe-used { margin: 22px 0 0; padding-top: 14px; border-top: 1px solid var(--rule); min-height: 3.2em; }
    .pipe-used a { color: var(--ink); }
    .pipe-used a:hover { color: var(--accent); }
    .pipe-used .mono { color: var(--accent); margin-inline-end: 8px; }
    .pipe-sep { color: var(--muted); }
    .pipe-also { margin: 14px 0 0; line-height: 1.8; }
    .pipe-also a { color: inherit; text-decoration: none; }
    .pipe-also a:hover { color: var(--accent); }
    @media (max-width: 760px) {
      .pipe-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 8px; }
      .pipe-stage:nth-child(3) { padding-inline-start: 0; border-inline-start: 0; }
      .pipe-stage:nth-child(3)::before { display: none; }
      .pipe-what { display: none; }
      .pipe-stage { padding-top: 12px; padding-bottom: 4px; }
      .pipe-name { font-size: 1.05rem; margin-bottom: 6px; }
      .pipe-tools { display: flex; flex-wrap: wrap; gap: 0 10px; font-size: 0.9rem; }
      .pipe-tool { padding: 1px 0; }
      .pipe-used { margin-top: 12px; padding-top: 10px; font-size: 0.9rem; }
      .pipe-also { margin-top: 8px; font-size: 0.7rem; line-height: 1.6; }
    }
  </style>

  <!-- ── EXPERIENCE / EDUCATION / CERTIFICATIONS (hidden until filled in profile.ts) ── -->
  {hasTimeline && (
    <Section id="experience" index={num('experience')} tone={tone('experience')}
             label={t.experience} title={experience.length ? t.experience : t.education}>
      <div class="timeline-wrap" data-active={experience.length ? 'exp' : 'edu'}>
        {/* Phones show one list at a time via these tabs; desktop shows all */}
        <div class="tl-tabs mono" role="tablist">
          {experience.length > 0 && <button type="button" role="tab" data-tab="exp" aria-selected="true">{t.experience}</button>}
          {education.length > 0 && <button type="button" role="tab" data-tab="edu" aria-selected={experience.length ? 'false' : 'true'}>{t.education}</button>}
          {certifications.length > 0 && <button type="button" role="tab" data-tab="cert" aria-selected="false">{t.certifications}</button>}
        </div>
        {experience.length > 0 && (
          <ol class="timeline" data-panel="exp">
            {experience.map((e) => (
              <li>
                <h3>{e.title[lang]}</h3>
                <p class="tl-meta mono muted">{e.org[lang]} · <span dir="ltr">{e.period}</span></p>
                <ul>{e.points[lang].map((pt) => <li>{pt}</li>)}</ul>
              </li>
            ))}
          </ol>
        )}
        <div class="timeline-side">
          {education.length > 0 && (
            <div data-panel="edu">
              {experience.length > 0 && <h3 class="mono muted timeline-sub">{t.education}</h3>}
              <ol class="timeline">
                {education.map((e) => (
                  <li>
                    <h3>{e.title[lang]}</h3>
                    <p class="tl-meta mono muted">
                      {e.org[lang]} · <span dir="ltr">{e.period}</span>{e.note && <> · <b>{e.note[lang]}</b></>}
                    </p>
                  </li>
                ))}
              </ol>
            </div>
          )}
          {certifications.length > 0 && (
            <div data-panel="cert">
              <h3 class="mono muted timeline-sub">{t.certifications}</h3>
              <ol class="timeline">
                {certifications.map((e) => (
                  <li>
                    <h3>{e.title[lang]}</h3>
                    <p class="tl-meta mono muted">{e.org[lang]} · <span dir="ltr">{e.period}</span></p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </div>
      <script is:inline>
        document.querySelectorAll('.timeline-wrap').forEach((wrap) => {
          wrap.querySelector('.tl-tabs').addEventListener('click', (e) => {
            const tab = e.target.closest('[data-tab]');
            if (!tab) return;
            wrap.dataset.active = tab.dataset.tab;
            wrap.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === tab)));
          });
        });
      </script>
    </Section>
  )}

  <!-- ── CONTACT ── -->
  <Section id="contact" index={num('contact')} tone="ink" label={t.nav.contact} title={t.contactTitle}>
    <p class="muted">{t.contactLead}</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="actions">
      <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
      {hasResume && <a class="btn" href={url('resume.pdf')} download>{t.resume}</a>}
    </div>
  </Section>
</Base>

---
// The writing page: every note, newest first, each with its own small garden flower.
import Herb from '../layouts/Herb.astro';
import { expData } from '../lib/expData';
import { flowerHTML } from '../lib/flowerArt';
import { type Lang } from '../data/profile';
import { ui } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const AR = lang === 'ar';
const posts = [...(await expData(lang)).posts].sort((a, b) => b.time - a.time);
const T = AR ? { title: 'المدونة', min: 'دقيقة قراءة', read: 'اقرأ ←' } : { title: 'Writing', min: 'min read', read: 'Read →' };
---
<Herb lang={lang} title={T.title} description={t.blogLead} path="blog/">
  <header class="hb-head"><h1 class="hb-title" data-decode data-perch>{T.title}</h1><p class="hb-lead">{t.blogLead}</p></header>
  {posts.length === 0 && <p class="hb-lead">{t.noPosts}</p>}
  <div class="hb-notes">
    {posts.map((p, i) => (
      <article class="hb-entry">
        <p class="hb-entry-k">{p.date} · {p.minutes} {T.min}</p>
        <pre class="hb-sprig" aria-hidden="true" set:html={flowerHTML({ R: 3, petals: 5 + (i % 3), seed: 40 + i, stem: 4 })}></pre>
        <h2><a href={p.href}>{p.title}</a></h2>
        <p class="hb-excerpt">{p.summary}</p>
        <p class="hb-entry-f"><a href={p.href}>{T.read}</a></p>
      </article>
    ))}
  </div>
</Herb>

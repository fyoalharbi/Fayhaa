---
// Herbarium (experiment 03): a readable scrolling portfolio drawn in Papillon's
// visual language, in English and Arabic. Rendered by
// /experiments/herbarium/ and /ar/experiments/herbarium/; behaviour lives in
// public/experiments/herbarium.js. Project text comes straight from the content
// collection, so the Arabic descriptions are shown exactly as written.
import ExpShell from './ExpShell.astro';
import { expData } from '../lib/expData';
import { flowerHTML } from '../lib/flowerArt';
import type { Lang } from '../data/profile';
import { url } from '../lib/site';
import { projectArt } from '../lib/projectArt';

interface Props { lang: Lang }
const { lang } = Astro.props;
const D = await expData(lang);
const AR = lang === 'ar';
const pad = (n: number) => String(n).padStart(2, '0');

const T = AR ? {
  kicker: 'معرض أعمال · 2022 — 2026', see: 'شوف المشاريع ↓', email: 'راسلني',
  facts: ['الدور', 'السنوات', 'الأعمال'], works: `مشاريع: ${D.projects.length} · تدوينات: ${D.posts.length}`,
  now: 'آخر مشروع', training: 'آخر تدريب', note: 'آخر تدوينة',
  secs: ['عني', 'المشاريع', 'الأدوات', 'المدونة', 'تواصل'],
  leads: ['خبراتي وتعليمي وطريقتي في الشغل.', 'الأعمال المميزة أول، وبعدها الباقي.',
    'كل أداة أستخدمها مرتبة حسب مرحلتها، ووين استخدمتها: في الشغل، وفي معسكر SDA، وفي مشاريعي.',
    'أشياء أتعلمها بالطريق.', 'أسرع طريقة توصل لي هي الإيميل.'],
  preview: 'معاينة', hide: 'إخفاء', fig: 'شكل', shot: 'لقطة من',
  why: 'ليش فراشات؟ القصة كاملة ←', project: 'مشروع', result: 'النتيجة', case: 'دراسة الحالة ←', live: 'العرض المباشر ↗', liveS: 'مباشر ↗', code: 'الكود ↗',
  feat: 'عيّنات مختارة', featN: (n: number, all: number) => `· ${n} من ${all}`, explore: 'تصفّح المجموعة كاملة ←',
  coll: 'المجموعة كاملة', collN: (n: number) => (n === 1 ? '· عيّنة واحدة' : `· ${n} عيّنات`), cols: ['رقم', 'العيّنة', 'الفصيلة · التاريخ', 'روابط'],
  featW: 'كتابات مختارة', exploreW: 'تصفّح كل الكتابات ←', arch: 'أرشيف الكتابات', archN: (n: number) => (n === 1 ? '· تدوينة واحدة' : `· ${n} تدوينات`),
  types: { Pipelines: 'خطوط بيانات', Dashboards: 'لوحات بيانات', Web: 'ويب', Analysis: 'تحليل' } as Record<string, string>,
  lgWork: 'استخدمتها في وظيفة', lgTrain: 'استخدمتها في معسكر SDA', lgN: 'عدد المشاريع',
  atWork: 'في الشغل', trainingRow: 'التدريب', projects: 'المشاريع',
  noteK: 'تدوينة', min: 'دقيقة قراءة', read: 'اقرأ ←', colophon: 'مبني بـ Astro. الزهور والفراشة مرسومة بالكود.',
  extra: [['run', 'التشغيل والنشر', 'السحابة والحاويات وكل ما حولها.'], ['web', 'البناء للويب', 'لما تكون النتيجة موقع أو تطبيق.']],
  what: ['أسحب البيانات من الـ APIs والملفات والويب.', 'أنظفها وأختبرها وأجدولها.', 'أشكّلها لجداول يوثق فيها.', 'أحوّلها لقرارات تنشاف.'],
  js: { hint: 'مرّر أو اضغط على أداة أو وظيفة أو مشروع.', pinned: 'مثبّت · اضغط مرة ثانية أو Esc', jobs: 'وظائف', camp: 'المعسكر', projects: 'مشاريع', tools: 'أدوات', tip: 'ليش فراشات؟ افتح الحديقة ←' },
} : {
  kicker: 'Portfolio · 2022 — 2026', see: 'See the projects ↓', email: 'Email me',
  facts: ['Role', 'Years', 'Work'], works: `${D.projects.length} projects · ${D.posts.length} notes`,
  now: 'Latest project', training: 'Latest training', note: 'Latest note',
  secs: ['About', 'Projects', 'Tools', 'Notes', 'Contact'],
  leads: ['Experience, education, and how I like to work.', 'Featured work first, then everything else.',
    'Every tool I use, grouped by stage, and where I used it: at work, in the SDA bootcamp, and in my projects.',
    'Things I learn along the way.', 'Email is the fastest way to reach me.'],
  preview: 'Preview', hide: 'Hide preview', fig: 'fig.', shot: 'Screenshot of',
  why: 'Why butterflies? The full story →', project: 'Project', result: 'Result', case: 'Case study →', live: 'Live demo ↗', liveS: 'Live ↗', code: 'Code ↗',
  feat: 'Featured specimens', featN: (n: number, all: number) => `· ${n} of ${all}`, explore: 'Explore the complete collection →',
  coll: 'Complete Collection', collN: (n: number) => `· ${n} specimen${n === 1 ? '' : 's'}`, cols: ['No.', 'Specimen', 'Family · collected', 'Links'],
  featW: 'Featured writings', exploreW: 'Explore all writings →', arch: 'Writing Archive', archN: (n: number) => `· ${n} ${n === 1 ? 'entry' : 'entries'}`,
  types: { Pipelines: 'Pipelines', Dashboards: 'Dashboards', Web: 'Web', Analysis: 'Analysis' } as Record<string, string>,
  lgWork: 'used at a job', lgTrain: 'used in the SDA bootcamp', lgN: 'projects',
  atWork: 'At work', trainingRow: 'Training', projects: 'Projects',
  noteK: 'Note', min: 'min read', read: 'Read →', colophon: 'Built with Astro. The flowers and the butterfly are drawn in code.',
  extra: [['run', 'Ship & run', 'Cloud, containers and the plumbing around it.'], ['web', 'Build for the web', 'When the result is a site or an app.']],
  what: ['Pull data from APIs, files and the web.', 'Clean it, test it, schedule it.', 'Shape it into tables people can trust.', 'Turn it into decisions people can see.'],
  js: { hint: 'Hover or tap a tool, a job or a project.', pinned: 'pinned · tap again or esc', jobs: 'jobs', camp: 'bootcamp', projects: 'projects', tools: 'tools', tip: 'Why butterflies? Open the garden →' },
};
const ids = ['about', 'work', 'tools', 'notes', 'contact'];
// Each project's flower plate and its specimen note
const plate = (slug: string) => { const a = projectArt(slug); return { html: a.html, cap: AR ? a.ar : a.en }; };
// The same page in the other language
const other = AR ? { href: url('experiments/herbarium/'), label: 'English', lang: 'en' } : { href: url('ar/experiments/herbarium/'), label: 'العربية', lang: 'ar' };

// Stages (the home page's pipeline split) plus two shelves for everything else
const KEYS = [
  ['python', 'rest-apis', 'web-scraping', 'etl', 'ibm-api-connect', 'outsystems'],
  ['sql', 'dbt', 'airflow', 'data-cleaning', 'power-query'],
  ['data-modeling', 'snowflake', 'statistics'],
  ['power-bi', 'dax', 'dashboard-design', 'streamlit'],
  ['aws', 'azure', 'docker', 'ci-cd', 'git'],
  ['typescript', 'javascript', 'astro', 'p5js', 'generative-viz'],
];
const STAGES = [
  ...['ingest', 'transform', 'model', 'report'].map((id, i) => ({ id, name: D.workflow[i], what: T.what[i] })),
  ...T.extra.map(([id, name, what]) => ({ id, name, what })),
].map((s, i) => ({ ...s, keys: KEYS[i] }));
const live = (k: string) => D.skills.find((s) => s.key === k && (s.used.length || s.work.length || s.train.length));
const groups = STAGES.map((g) => ({ ...g, tools: g.keys.map(live).filter(Boolean).sort((a, b) => b!.used.length - a!.used.length || b!.work.length - a!.work.length) as typeof D.skills }))
  .filter((g) => g.tools.length);
const roles = D.experience.filter((e) => e.skills.length);
const camps = D.education.filter((e) => e.skills.length);
const fam = (p: (typeof D.projects)[number]) => T.types[p.skills.some((s) => s.key === 'airflow' || s.key === 'dbt') ? 'Pipelines' : p.skills.some((s) => s.key === 'power-bi') ? 'Dashboards' : p.skills.some((s) => s.key === 'typescript') ? 'Web' : 'Analysis'];
// Curated for this page: three specimens that each show a different strength (a team data-engineering
// pipeline, a solo scrape-validate-report dashboard, a merged open-source product contribution).
// Everything else goes to the collection, newest first; nothing appears twice.
const PICKS = ['invasight', 'ewc-2024-dashboard', 'qafiyah-feelings'];
const byTime = <X extends { time: number }>(a: X, b: X) => b.time - a.time;
const picked = PICKS.map((s) => D.projects.find((p) => p.slug === s)).filter((p): p is (typeof D.projects)[number] => !!p);
const featured = [...picked, ...D.projects.filter((p) => p.featured && !picked.includes(p))].slice(0, 3);
const collection = D.projects.filter((p) => !featured.includes(p)).sort(byTime);
// Writing: the personal reflection first, then the practical how-to; the archive takes the rest
const POST_PICKS = ['adapting-to-ai', 'gsd-claude-code'];
const featPosts = [...POST_PICKS.map((s) => D.posts.find((p) => p.slug === s)), ...[...D.posts].sort(byTime)]
  .filter((p, i, a): p is (typeof D.posts)[number] => !!p && a.indexOf(p) === i).slice(0, 3);
const archive = D.posts.filter((p) => !featPosts.includes(p)).sort(byTime);
const noteNo = (p: (typeof D.posts)[number]) => pad([...D.posts].sort(byTime).reverse().indexOf(p) + 1);
const PT: Record<string, [string, string]> = { red: ['#ff8a8a', '#b35a5a'], white: ['#f4f4f4', '#9a9a9a'], violet: ['#c49aff', '#6f5a99'], blush: ['#ffc0d0', '#a07080'], orange: ['#ffb070', '#a06a3a'], gold: ['#e6c34a', '#8a7428'] };
const petal = (slug: string) => { const t = PT[projectArt(slug).tone] ?? PT.red; return `--pt:${t[0]};--pt2:${t[1]}`; };
const stack = (p: (typeof D.projects)[number], n = 4) => p.skills.slice(0, n).map((s) => s.label).join(' · ') + (p.skills.length > n ? ` · +${p.skills.length - n}` : '');
const lead = featured[0] ?? D.projects[0], camp = camps[0], post = D.posts[0];
---
<ExpShell title="Herbarium" n="03" lang={lang} scripts={['js/flyer.js', 'experiments/kit.js', 'experiments/herbarium.js']}>
  <script is:inline define:vars={{ t: T.js }} slot="head">window.HB_T = t;</script>
  {AR && <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" />}
  <a class="hb-lang" href={other.href} lang={other.lang} hreflang={other.lang} data-keep-hash>{other.label}</a>
  <nav class="hb-rail" id="hb-rail" aria-label="Sections">
    <span class="hb-stem"><i id="hb-grow"></i></span>
    {ids.map((id, i) => <a href={`#${id}`} data-id={id}><b>{pad(i + 1)}</b><span>{T.secs[i]}</span></a>)}
  </nav>

  <div class="hb-gwrap"><canvas id="hb-garden" aria-hidden="true"></canvas></div>
  <main class="hb">
    <!-- ── Landing ── -->
    <header class="hb-hero">
      <div class="hb-ruler" aria-hidden="true"><span>0</span><span>5</span><span>10</span><span>15</span><span>20</span></div>
      <div class="hb-hero-in">
        <p class="hb-k">{T.kicker}</p>
        <h1 class="hb-name" data-perch><span data-decode>{D.name}</span></h1>
        <p class="hb-role">{D.role}</p>
        <p class="hb-intro">{D.intro}</p>
        <p class="hb-cta"><a href="#work">{T.see}</a><a href={`mailto:${D.email}`}>{T.email}</a></p>
        <dl class="hb-museum">
          <dt>{T.facts[0]}</dt><dd>{D.role}</dd>
          <dt>{T.facts[1]}</dt><dd>2022 — 2026</dd>
          <dt>{T.facts[2]}</dt><dd>{T.works}</dd>
        </dl>
      </div>
      <aside class="hb-now">
        <article class="hb-now-p">
          <a class="hb-img" href={lead.href} aria-label={lead.title}>
            <pre class="hb-art" aria-hidden="true" set:html={plate(lead.slug).html}></pre>
            {lead.thumb && <img class="hb-shot" src={lead.thumb} alt={`${T.shot} ${lead.title}`} loading="lazy" />}
            <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          </a>
          <p class="hb-fig"><span><b>{T.fig} 01</b> {plate(lead.slug).cap}</span>{lead.thumb && <button type="button" class="hb-prev" aria-pressed="false" data-on={T.hide} data-off={T.preview}>{T.preview}</button>}</p>
          <p class="hb-tag">{T.now} · {lead.date}</p>
          <h3><a href={lead.href}>{lead.title}</a></h3>
          {lead.sub && <p class="hb-sub">{lead.sub}</p>}
        </article>
        <div class="hb-now-rows">
          {camp && <a href="#tools" data-camp><p class="hb-tag">{T.training} · {camp.period}</p><b>{camp.title}</b><span>{camp.org}</span></a>}
          {post && <a href={post.href}><p class="hb-tag">{T.note} · {post.date}</p><b>{post.title}</b></a>}
        </div>
      </aside>
    </header>

    <!-- ── 01 About ── -->
    <section id="about" class="hb-sec">
      <header class="hb-head"><p class="hb-num">01</p><h2 data-decode data-perch>{T.secs[0]}</h2><p class="hb-lead">{T.leads[0]}</p></header>
      <div class="hb-about">
        <blockquote class="hb-quote">
          <p>{D.philosophy.paragraphs[1]}</p>
          <a href={D.papillon}>{T.why}</a>
        </blockquote>
        <ol class="hb-time">
          {D.experience.map((e) => <li><small>{e.period}</small><b>{e.title}</b><span>{e.org}</span><p>{e.points[0]}</p>
            {e.skills.length > 0 && <p class="hb-uses">{e.skills.map((k) => D.skills.find((s) => s.key === k)?.label).join(' · ')}</p>}</li>)}
          {D.education.map((e) => <li class="is-root"><small>{e.period}</small><b>{e.title}</b><span>{e.org}{e.note && ` · ${e.note}`}</span>
            {e.skills.length > 0 && <p class="hb-uses">{e.skills.map((k) => D.skills.find((s) => s.key === k)?.label).join(' · ')}</p>}</li>)}
        </ol>
      </div>
    </section>

    <!-- ── 02 Projects ── -->
    <section id="work" class="hb-sec">
      <header class="hb-head"><p class="hb-num">02</p><h2 data-decode data-perch>{T.secs[1]}</h2><p class="hb-lead">{T.leads[1]}</p></header>
      <p class="hb-shelf" id="featured">{T.feat} <span>{T.featN(featured.length, D.projects.length)}</span></p>
      <div class="hb-feats">
        {featured.map((p, i) => (
          <article class={`hb-feat ${i % 2 ? 'is-flip' : ''}`}>
            <a class="hb-img" href={p.href} aria-label={p.title}>
              <pre class="hb-art" aria-hidden="true" set:html={plate(p.slug).html}></pre>
              {p.thumb && <img class="hb-shot" src={p.thumb} alt={`${T.shot} ${p.title}`} loading="lazy" />}
              <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
              <span class="hb-tape t1"></span><span class="hb-tape t2"></span>
              <span class="hb-slip" aria-hidden="true"><b>{T.project} {pad(i + 1)}</b><span>{p.title}</span><span>{fam(p)} · {p.date}</span></span>
            </a>
            <div class="hb-label">
              <p class="hb-n" aria-hidden="true">{pad(i + 1)}</p>
              <h3><a href={p.href}>{p.title}</a></h3>
              {p.sub && <p class="hb-sub">{p.sub}</p>}
              <p class="hb-sum">{p.summary}</p>
              <p class="hb-res"><b>{T.result}</b>{p.tldr.result}</p>
              <p class="hb-stack">{stack(p)}</p>
              <p class="hb-links">
                <a href={p.href}>{T.case}</a>
                {p.live && <a href={p.live}>{T.live}</a>}
                {p.code && <a href={p.code}>{T.code}</a>}
              </p>
              <p class="hb-fig"><span><b>{T.fig} {pad(i + 1)}</b> {plate(p.slug).cap}</span>{p.thumb && <button type="button" class="hb-prev" aria-pressed="false" data-on={T.hide} data-off={T.preview}>{T.preview}</button>}</p>
            </div>
          </article>
        ))}
      </div>
      {collection.length > 0 && <p class="hb-explore"><a href="#collection">{T.explore}</a></p>}
      {collection.length > 0 && (
        <div class="hb-coll" id="collection">
          <h3 class="hb-sub-h" data-perch>{T.coll} <span>{T.collN(collection.length)}</span></h3>
          <p class="hb-reg-h" aria-hidden="true"><span>{T.cols[0]}</span><span></span><span>{T.cols[1]}</span><span>{T.cols[2]}</span><span>{T.cols[3]}</span></p>
          <ol class="hb-reg">
            {collection.map((p, i) => (
              <li class="hb-row" style={petal(p.slug)}>
                <p class="hb-row-n">{pad(featured.length + i + 1)}</p>
                <pre class="hb-row-art" aria-hidden="true" set:html={flowerHTML({ R: 4, petals: 5 + (i % 4), seed: p.slug, stem: 4 })}></pre>
                <div class="hb-row-main">
                  <h4><a href={p.href}>{p.title}</a></h4>
                  {p.sub && <p class="hb-sub">{p.sub}</p>}
                  <p class="hb-row-sum">{p.summary}</p>
                  <p class="hb-stack">{stack(p, 5)}</p>
                </div>
                <p class="hb-row-meta"><span>{fam(p)}</span><span>{p.date}</span></p>
                <p class="hb-row-links">
                  <a href={p.href}>{T.case}</a>
                  {p.live && <a href={p.live}>{T.liveS}</a>}
                  {p.code && <a href={p.code}>{T.code}</a>}
                </p>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>

    <!-- ── 03 Tools: stages on top, where they were used underneath ── -->
    <section id="tools" class="hb-sec">
      <header class="hb-head"><p class="hb-num">03</p><h2 data-decode data-perch>{T.secs[2]}</h2><p class="hb-lead">{T.leads[2]}</p></header>
      <div class="hb-tools" id="hb-map">
        <p class="hb-legend"><span><i class="d w"></i>{T.lgWork}</span><span><i class="d t"></i>{T.lgTrain}</span><span><b>4</b> = {T.lgN}</span></p>
        <div class="hb-stages">
          {groups.map((g, gi) => (
            <div class="hb-grp">
              <p class="hb-grp-h"><b>{pad(gi + 1)}</b> {g.name}<small>{g.what}</small></p>
              <ul>{g.tools.map((s) => (
                <li class={`hb-tool ${s.core ? 'is-core' : ''}`}>
                  <span class="nm">{s.label}</span><span class="ld"></span>
                  <span class="mk">{s.work.length > 0 && <i class="d w" title={T.lgWork}></i>}{s.train.length > 0 && <i class="d t" title={T.lgTrain}></i>}<b>{s.used.length || '–'}</b></span></li>))}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 04 Notes ── -->
    <section id="notes" class="hb-sec">
      <header class="hb-head"><p class="hb-num">04</p><h2 data-decode data-perch>{T.secs[3]}</h2><p class="hb-lead">{T.leads[3]}</p></header>
      <p class="hb-shelf">{T.featW} <span>{T.featN(featPosts.length, D.posts.length)}</span></p>
      <div class={`hb-journal n-${featPosts.length}`} style={`--n:${featPosts.length}`}>
        {featPosts.map((p, i) => (
          <article class="hb-entry">
            <p class="hb-entry-k"><span>{T.noteK} {noteNo(p)}</span><span>{p.date} · {p.minutes} {T.min}</span></p>
            <p class="hb-date" aria-hidden="true"><b>{noteNo(p)}</b></p>
            <pre class="hb-sprig" aria-hidden="true" set:html={flowerHTML({ R: 3, petals: 5 + i, seed: 40 + i, stem: 4 })}></pre>
            <h3><a href={p.href}>{p.title}</a></h3>
            <p class="hb-excerpt">{p.summary}</p>
            <p class="hb-entry-f"><span>{p.tags.map((t) => `#${t}`).join('  ')}</span><a href={p.href}>{T.read}</a></p>
          </article>
        ))}
      </div>
      {archive.length > 0 && <p class="hb-explore"><a href="#archive">{T.exploreW}</a></p>}
      {archive.length > 0 && (
        <div class="hb-coll" id="archive">
          <h3 class="hb-sub-h" data-perch>{T.arch} <span>{T.archN(archive.length)}</span></h3>
          <ol class="hb-toc">
            {archive.map((p) => (
              <li>
                <a href={p.href}><span class="tt">{p.title}</span><span class="ld" aria-hidden="true"></span><span class="dt">{p.date}</span></a>
                <p>{p.tags.map((t) => `#${t}`).join('  ')}</p>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>

    <!-- ── 05 Contact ── -->
    <section id="contact" class="hb-sec hb-end">
      <header class="hb-head"><p class="hb-num">05</p><h2 data-decode data-perch>{T.secs[4]}</h2><p class="hb-lead">{T.leads[4]}</p></header>
      <a class="hb-mail" href={`mailto:${D.email}`} id="hb-mail" dir="ltr" data-perch>{D.email}</a>
      <p class="hb-cta"><a href={D.links.linkedin}>LinkedIn ↗</a><a href={D.links.github}>GitHub ↗</a></p>
      <p class="hb-colophon">{T.colophon}</p>
    </section>
  </main>

  <!-- The white butterfly: wanders the page, perches on things, and opens the garden when caught -->
  <a class="hb-fly" id="hb-fly" href={D.papillon} aria-label={T.js.tip}><canvas></canvas><span class="hb-fly-tip">{T.js.tip}</span></a>
</ExpShell>

<style is:global>
  html { scroll-behavior: smooth; overflow-x: clip; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { background: radial-gradient(1200px 600px at 85% -10%, #1a1f1a 0%, transparent 60%), var(--night); }
  /* Arabic is set in Amiri throughout: bold for the name and headings, regular for reading */
  html[lang='ar'] { --sans: 'Amiri', 'IBM Plex Sans Arabic', serif; --serif: 'Amiri', 'IBM Plex Serif', serif; --mono: 'JetBrains Mono', 'Amiri', ui-monospace, monospace; }
  html[lang='ar'] .hb, html[lang='ar'] .hb-rail { letter-spacing: 0; }
  /* mono labels fall back to Amiri for Arabic letters; size them to the mono's x-height so they stay readable */
  html[lang='ar'] .hb *, html[lang='ar'] .hb-rail * { font-size-adjust: from-font; }
  html[lang='ar'] .hb-rail a { line-height: 1.6; gap: 0; }
  html[lang='ar'] .hb *, html[lang='ar'] .hb-rail * { font-style: normal !important; letter-spacing: 0 !important; }
  .hb { --col: min(1120px, calc(100vw - 230px)); margin-inline-start: 180px; }
  .hb-sec { width: var(--col); margin: 0 auto; padding: 150px 0 40px; position: relative; }

  .hb-head { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 0 48px; padding-bottom: 22px; margin-bottom: 56px; position: relative;
    background: repeating-linear-gradient(90deg, #ffffff22 0 1px, transparent 1px 12px) bottom left / 100% 5px no-repeat, linear-gradient(#ffffff1a, #ffffff1a) bottom / 100% 1px no-repeat; }
  .hb-num { grid-column: 1 / -1; margin: 0; font: 500 11px var(--mono); letter-spacing: .2em; color: var(--red); }
  .hb h2 { margin: 8px 0 0; font: 400 clamp(48px, 6.4vw, 96px)/0.95 var(--serif); font-style: italic; letter-spacing: -.025em; color: var(--ink); }
  html[lang='ar'] .hb h2 { font-weight: 700; line-height: 1.15; }
  .hb-lead { max-width: 46ch; margin: 0 0 6px; justify-self: end; color: var(--dim); font-size: 14.5px; line-height: 1.6; }

  /* language switch, beside the lab chip */
  .hb-lang { position: fixed; z-index: 90; top: max(10px, env(safe-area-inset-top)); inset-inline-end: 98px; padding: 5px 9px; text-decoration: none;
    font: 500 11px/1 'IBM Plex Sans Arabic', var(--mono); color: var(--ink-2); background: rgba(11, 12, 14, .6); border: 1px solid #ffffff1f; backdrop-filter: blur(6px); transition: color .2s, border-color .2s; }
  .hb-lang[lang='en'] { font-family: var(--mono); letter-spacing: .06em; }
  .hb-lang:hover { color: var(--ink); border-color: #ff8a8a88; }
  /* rail */
  .hb-rail { position: fixed; z-index: 20; inset-inline-start: 34px; top: 50%; transform: translateY(-50%); display: grid; gap: 22px; padding-inline-start: 18px; transition: opacity .6s; }
  .hb-stem { position: absolute; inset-inline-start: 0; top: 4px; bottom: 4px; width: 1px; background: #ffffff1a; }
  .hb-stem i { position: absolute; inset-inline-start: 0; top: 0; width: 1px; height: 0; background: var(--leaf); box-shadow: 0 0 6px #6f9f6f; }
  .hb-rail a { position: relative; display: grid; gap: 3px; text-decoration: none; color: var(--dim); font: 500 10.5px/1.1 var(--mono); letter-spacing: .12em; text-transform: uppercase; transition: color .3s; }
  .hb-rail a b { font: 500 10px/1 var(--mono); color: #ffffff55; transition: color .3s; }
  .hb-rail a::before { content: ''; position: absolute; inset-inline-start: -21px; top: 2px; width: 7px; height: 7px; border-radius: 50%; background: var(--night); border: 1px solid #ffffff33; transition: all .3s; }
  .hb-rail a.is-on { color: var(--ink); } .hb-rail a.is-on b { color: var(--red); }
  .hb-rail a.is-on::before { background: var(--red); border-color: var(--red); box-shadow: 0 0 8px var(--red); }
  .hb-rail.is-hero { opacity: 0; pointer-events: none; }

  /* ── landing ── */
  .hb-hero { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: 70px; width: var(--col); margin: 0 auto; padding: 80px 0 30svh; }
  .hb-ruler { position: absolute; top: 26px; inset-inline: 0; height: 18px; display: flex; justify-content: space-between; font: 9px var(--mono); color: #ffffff40;
    background: repeating-linear-gradient(90deg, #ffffff30 0 1px, transparent 1px 9px) bottom / 100% 4px no-repeat, repeating-linear-gradient(90deg, #ffffff40 0 1px, transparent 1px 45px) bottom / 100% 8px no-repeat; padding-bottom: 10px; }
  .hb-gwrap { position: absolute; left: 0; top: 70svh; width: 100%; height: 28svh; }
  #hb-garden { width: 100%; height: 100%; display: block; }
  .hb-k { font: 500 10.5px var(--mono); letter-spacing: .2em; text-transform: uppercase; color: var(--red); margin: 0 0 22px; }
  .hb-name { margin: 0; font: 400 clamp(88px, 12.5vw, 196px)/.82 var(--serif); font-style: italic; letter-spacing: -.045em; }
  /* Arabic: the name in Ruqʿa, the hand counterpart of the English italic; its right edge sits flush with the kicker and the role */
  html[lang='ar'] .hb-name { font: 700 clamp(84px, 11.5vw, 176px)/1.2 'Amiri', var(--serif); letter-spacing: 0; }
  html[lang='ar'] .hb-name span { padding: .1em 0 .3em .06em; margin: -.1em 0 -.45em; }
  .hb-name span { display: inline-block; background: linear-gradient(100deg, var(--ink) 40%, #ffd7c8 50%, var(--ink) 60%) 0 0 / 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: hb-sheen 9s ease-in-out 2.5s infinite; padding: 0 .06em .32em 0; margin-bottom: -.32em; }
  @keyframes hb-sheen { 0%, 70% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  .hb-role { margin: clamp(26px, 3.6vw, 52px) 0 0; font: 400 clamp(20px, 2.1vw, 27px)/1.3 var(--serif); color: var(--ink-2); }
  .hb-intro { max-width: 50ch; margin: 16px 0 0; font-size: 15px; line-height: 1.7; color: var(--dim); }
  .hb-cta { display: flex; gap: 10px; flex-wrap: wrap; margin: 28px 0 0; }
  .hb-cta a { font: 500 11.5px/1 var(--mono); letter-spacing: .06em; padding: 11px 14px; text-decoration: none; color: var(--ink); border: 1px solid #ffffff2a; background: #0b0c0e99; transition: all .2s; }
  .hb-cta a:first-child { border-color: #ff8a8a88; background: #ff8a8a12; }
  .hb-cta a:hover { border-color: var(--red); color: var(--red); box-shadow: 0 0 14px #ff8a8a33; }
  .hb-museum { margin: 44px 0 0; display: inline-grid; grid-template-columns: repeat(6, auto); gap: 0 12px; padding-top: 9px; font: 10px/1.5 var(--mono); border-top: 1px solid #ffffff1a; }
  .hb-museum dt { color: var(--dim); text-transform: uppercase; letter-spacing: .14em; } .hb-museum dd { margin: 0; margin-inline-end: 14px; color: var(--ink-2); white-space: nowrap; }

  .hb-now { display: grid; gap: 26px; align-self: center; }
  .hb-now-p .hb-img { aspect-ratio: 16/10; margin-bottom: 18px; }
  .hb-now-p h3 { margin: 6px 0 0; font: 400 30px/1.05 var(--serif); font-style: italic; }
  .hb-now-p h3 a { text-decoration: none; } .hb-now-p h3 a:hover { color: var(--red); }
  .hb-now-rows { display: grid; gap: 0; border-top: 1px solid #ffffff14; }
  .hb-now-rows a { display: grid; gap: 3px; padding: 13px 0; border-bottom: 1px solid #ffffff14; text-decoration: none; transition: padding .3s; }
  .hb-now-rows a:hover { padding-inline-start: 8px; } .hb-now-rows a:hover b { color: var(--red); }
  .hb-now-rows b { font-weight: 500; font-size: 14.5px; color: var(--ink); transition: color .2s; } .hb-now-rows span { font-size: 12.5px; color: var(--leaf); }

  /* ── about ── */
  .hb-about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: start; }
  .hb-quote { margin: 0; position: sticky; top: 110px; padding-inline-start: 26px; border-inline-start: 1px solid var(--gold); }
  .hb-quote p { margin: 0; font: italic 400 clamp(22px, 2.3vw, 31px)/1.4 var(--serif); color: var(--ink); text-wrap: pretty; }
  html[lang='ar'] .hb-quote p { font-size: clamp(20px, 2vw, 27px); line-height: 1.8; }
  .hb-quote a { display: inline-block; margin-top: 20px; font: 500 11px var(--mono); color: var(--red); text-decoration: none; letter-spacing: .06em; }
  .hb-quote a:hover { text-decoration: underline; }
  .hb-time { list-style: none; margin: 0; padding: 0; padding-inline-start: 28px; border-inline-start: 1px solid #6f9f6f55; }
  .hb-time li { position: relative; padding: 0 0 30px; }
  .hb-time li::before { content: '0'; position: absolute; inset-inline-start: -34px; top: 0; width: 12px; text-align: center; font: 11px/1.2 var(--mono); color: var(--leaf); background: var(--night); }
  .hb-time li.is-root::before { content: '1'; color: var(--gold); }
  .hb-time small { display: block; font: 10.5px var(--mono); color: var(--dim); letter-spacing: .04em; }
  .hb-time b { display: block; margin-top: 4px; font-weight: 500; font-size: 16px; }
  .hb-time span { font-size: 13px; color: var(--leaf); }
  .hb-time p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--dim); max-width: 52ch; }
  .hb-time .hb-uses { margin-top: 8px; font: 10.5px/1.6 var(--mono); color: #6f9f6fb0; }

  /* ── projects ── */
  .hb-img { position: relative; display: block; aspect-ratio: 16/10; background: #0e100f; outline: 1px solid #ffffff12; outline-offset: 7px; }
  /* the plate: a 64×20 drawing scaled to the frame's width, in a quiet monochrome */
  .hb-img { container-type: inline-size; display: grid; place-items: center; overflow: visible; }
  .hb-feat > *, .hb-row > *, .hb-now > * { min-width: 0; }   /* grid items never grow past their column */
  .hb-art { margin: 0; direction: ltr; white-space: pre; max-width: 100%; overflow: hidden; font: 400 var(--art-fs, 7px)/1.25 'JetBrains Mono', monospace; color: #4d4d57; transition: opacity .5s; user-select: none; }
  .hb-img { text-decoration: none; } .hb-art i { font-style: normal !important; }
  .hb-art { transform: translateZ(0); }   /* own layer → grayscale antialiasing, no coloured fringes on thin glyphs */
  /* the garden's palette (KIT.PAL): petals, their darker rims, gold eyes, green stems and grass */
  .hb-art .a-red { color: #ff8a8a; } .hb-art .a-red2 { color: #b35a5a; } .hb-art .a-white { color: #f4f4f4; } .hb-art .a-white2 { color: #9a9a9a; }
  .hb-art .a-violet { color: #c49aff; } .hb-art .a-violet2 { color: #6f5a99; } .hb-art .a-blush { color: #ffc0d0; } .hb-art .a-blush2 { color: #a07080; }
  .hb-art .a-orange { color: #ffb070; } .hb-art .a-orange2 { color: #a06a3a; } .hb-art .a-gold { color: #e6c34a; } .hb-art .a-gold2 { color: #8a7428; }
  .hb-art .a-stem { color: #5f8f5f; } .hb-art .a-leaf { color: #4f8a4f; } .hb-art .a-g0 { color: #1f3524; } .hb-art .a-g1 { color: #2f5a3a; } .hb-art .a-g2 { color: #3f6b3f; }
  .hb-art .a-pollen { color: #e6d27a; } .hb-art .a-fly { color: #d4ff7a; text-shadow: 0 0 6px #d4ff7a88; }
  .hb-art .a-p { transition: opacity .4s; opacity: .88; } article:hover .hb-art .a-p { opacity: 1; }
  /* the real screenshot waits behind the plate until asked for */
  .hb-shot { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; object-position: top; clip-path: inset(0 0 100% 0); transition: clip-path 1.2s cubic-bezier(.6, 0, .2, 1); }
  .is-prev .hb-shot { clip-path: inset(0 0 0 0); }
  .is-prev .hb-art { opacity: 0; }
  .hb-fig { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; margin: 16px 0 0; font: 10.5px/1.5 var(--mono); color: #6a6a74; }
  .hb-fig b { font-weight: 500; color: #8d8d96; margin-inline-end: 6px; }
  .hb-prev { all: unset; cursor: pointer; flex: none; font: 500 10px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #8d8d96; padding: 5px 8px; border: 1px solid #ffffff1c; transition: color .2s, border-color .2s; }
  .hb-prev:hover, .hb-prev[aria-pressed='true'] { color: var(--ink); border-color: #7f95b0; }
  .hb-label .hb-fig { margin-top: 22px; padding-top: 12px; border-top: 1px dashed #ffffff14; }
  .hb-img::after { content: ''; position: absolute; left: -6px; right: -6px; top: 0; height: 1px; background: var(--red); box-shadow: 0 0 10px 1px #ff8a8a; opacity: 0; pointer-events: none; z-index: 2; }
  .is-prev .hb-img::after { animation: hb-scan 1.2s cubic-bezier(.6, 0, .2, 1) both; }
  @keyframes hb-scan { 0% { top: 0; opacity: 1; } 92% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  .hb-img .c { position: absolute; width: 12px; height: 12px; border: 1px solid var(--red); opacity: 0; transition: all .3s; filter: drop-shadow(0 0 4px var(--red)); z-index: 3; }
  .hb-img .tl { top: -14px; left: -14px; border-right: 0; border-bottom: 0; } .hb-img .tr { top: -14px; right: -14px; border-left: 0; border-bottom: 0; }
  .hb-img .bl { bottom: -14px; left: -14px; border-right: 0; border-top: 0; } .hb-img .br { bottom: -14px; right: -14px; border-left: 0; border-top: 0; }
  article:hover .hb-img .c { opacity: 1; }
  article:hover .hb-img .tl { transform: translate(5px, 5px); } article:hover .hb-img .tr { transform: translate(-5px, 5px); }
  article:hover .hb-img .bl { transform: translate(5px, -5px); } article:hover .hb-img .br { transform: translate(-5px, -5px); }
  .hb-tape { position: absolute; width: 54px; height: 16px; background: #e8e4d01a; border: 1px solid #e8e4d014; z-index: 3; }
  .hb-tape.t1 { top: -9px; left: 14%; transform: rotate(-4deg); } .hb-tape.t2 { bottom: -9px; right: 12%; transform: rotate(3deg); }

  .hb-feats { display: grid; gap: 130px; }
  .hb-feat { position: relative; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .hb-feat.is-flip .hb-img { order: 2; } .hb-feat.is-flip .hb-label { order: 1; }
  .hb-slip { position: absolute; z-index: 4; inset-inline-end: -10px; top: calc(100% + 16px); display: grid; gap: 1px; width: 190px; padding: 9px 11px; font: 9.5px/1.5 var(--mono); color: var(--dim); background: #101311; border: 1px solid #ffffff22; box-shadow: 0 10px 30px #0008; transform: rotate(-1.5deg); }
  .hb-slip b { color: var(--red); font-weight: 500; letter-spacing: .1em; text-transform: uppercase; } .hb-slip span:nth-child(2) { color: var(--ink); font: italic 13px/1.3 var(--serif); }
  .hb-feat.is-flip .hb-slip { inset-inline-end: auto; inset-inline-start: -10px; transform: rotate(1.5deg); }
  .hb-n { margin: 0 0 -10px; font: italic 400 110px/1 var(--serif); color: transparent; -webkit-text-stroke: 1px #ffffff26; letter-spacing: -.04em; }
  .hb-label h3 { margin: 0; font: 400 46px/1.04 var(--serif); font-style: italic; letter-spacing: -.01em; }
  html[lang='ar'] .hb-label h3 { font-weight: 700; line-height: 1.3; font-size: 38px; }
  .hb-label h3 a { text-decoration: none; transition: color .2s; } .hb-label h3 a:hover { color: var(--red); }
  .hb-sub { margin: 10px 0 0; font-size: 14px; color: var(--leaf); }
  .hb-sum { margin: 14px 0 0; font-size: 14.5px; line-height: 1.65; color: var(--ink-2); max-width: 48ch; }
  html[lang='ar'] .hb-sum, html[lang='ar'] .hb-res, html[lang='ar'] .hb-intro { line-height: 1.9; }
  .hb-res { margin: 16px 0 0; padding: 10px 0; padding-inline-start: 14px; border-inline-start: 1px solid var(--gold); font-size: 13.5px; line-height: 1.6; color: var(--dim); max-width: 48ch; }
  .hb-res b { display: block; font: 500 9.5px var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin-bottom: 3px; }
  .hb-stack { margin: 14px 0 0; font: 11px/1.6 var(--mono); color: #6f9f6fcc; }
  .hb-links { display: flex; flex-wrap: wrap; gap: 18px; margin: 18px 0 0; font: 500 11px var(--mono); }
  .hb-links a { color: var(--ink); text-decoration: none; border-bottom: 1px solid #ff8a8a66; padding-bottom: 2px; transition: color .2s, border-color .2s; }
  .hb-links a:hover { color: var(--red); border-color: var(--red); }
  .hb-sub-h { margin: 150px 0 34px; font: 400 30px/1 var(--serif); font-style: italic; color: var(--ink); padding-bottom: 14px; border-bottom: 1px dashed #ffffff22; }
  .hb-sub-h span { font: 500 10.5px var(--mono); font-style: normal; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
  /* Shelf labels: a quiet mono line that names what sits below */
  .hb-shelf { margin: 0 0 40px; font: 500 10.5px var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--red); }
  .hb-shelf span { color: var(--dim); letter-spacing: .1em; }
  .hb-explore { margin: 96px 0 0; display: flex; justify-content: flex-end; }
  .hb-explore a { font: 500 11.5px var(--mono); letter-spacing: .06em; color: var(--ink); text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid #ff8a8a66; transition: color .2s, border-color .2s, padding .3s; }
  .hb-explore a:hover { color: var(--red); border-color: var(--red); padding-inline-end: 8px; }
  .hb-coll { scroll-margin-top: 40px; }
  .hb-coll .hb-sub-h { margin-top: 70px; }
  /* Complete collection: a specimen register, one ruled line per accession */
  .hb-reg-h, .hb-row { display: grid; grid-template-columns: 44px 64px minmax(0, 1fr) 150px 150px; gap: 0 24px; align-items: start; }
  .hb-reg-h { margin: -18px 0 0; padding: 0 10px 10px; font: 500 9.5px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: #ffffff4d; }
  .hb-reg { list-style: none; margin: 0; padding: 0; border-top: 1px solid #ffffff1a; }
  .hb-row { position: relative; padding: 26px 10px 28px; border-bottom: 1px dashed #ffffff1c; transition: background .3s; }
  .hb-row:hover, .hb-row:focus-within { background: linear-gradient(90deg, #ffffff06, #ffffff02); }
  .hb-row::before { content: ''; position: absolute; inset-inline-start: 0; top: 26px; bottom: 28px; width: 1px; background: var(--pt); opacity: 0; transition: opacity .3s; }
  .hb-row:hover::before, .hb-row:focus-within::before { opacity: .7; }
  .hb-row-n { margin: 4px 0 0; font: 500 11px var(--mono); letter-spacing: .1em; color: var(--dim); transition: color .3s; }
  .hb-row:hover .hb-row-n, .hb-row:focus-within .hb-row-n { color: var(--red); }
  .hb-row-art { margin: 0; font: 10.5px/1.05 var(--mono); direction: ltr; opacity: .55; transform-origin: 50% 60%; transition: opacity .4s, transform .6s cubic-bezier(.2, .8, .2, 1); }
  .hb-row-art .t-p { color: var(--pt); } .hb-row-art .t-r { color: var(--pt2); } .hb-row-art .t-s { color: #5f8f5f; } .hb-row-art .t-l { color: var(--leaf); }
  .hb-row:hover .hb-row-art, .hb-row:focus-within .hb-row-art { opacity: 1; transform: scale(1.12) rotate(-4deg); }
  .hb-row-main h4 { margin: 0; font: 400 25px/1.15 var(--serif); font-style: italic; letter-spacing: -.01em; text-wrap: balance; }
  html[lang='ar'] .hb-row-main h4 { font-weight: 700; font-size: 21px; line-height: 1.5; }
  .hb-row-main h4 a { text-decoration: none; transition: color .2s; } .hb-row-main h4 a:hover { color: var(--red); }
  .hb-row-main .hb-sub { margin-top: 4px; font-size: 13px; }
  .hb-row-sum { margin: 10px 0 0; max-width: 62ch; font-size: 13.5px; line-height: 1.65; color: var(--dim); text-wrap: pretty; }
  .hb-row-main .hb-stack { margin-top: 10px; font-size: 10.5px; }
  .hb-row-meta { display: grid; gap: 4px; margin: 6px 0 0; font: 500 10px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
  .hb-row-meta span:first-child { color: var(--leaf); }
  .hb-row-links { display: grid; justify-items: start; gap: 9px; margin: 5px 0 0; font: 500 11px var(--mono); }
  .hb-row-links a { color: var(--ink); text-decoration: none; border-bottom: 1px solid #ff8a8a55; padding-bottom: 2px; transition: color .2s, border-color .2s; }
  .hb-row-links a:hover { color: var(--red); border-color: var(--red); }
  /* Writing archive: a journal's table of contents */
  .hb-toc { list-style: none; margin: 0; padding: 0; max-width: 820px; }
  .hb-toc li { padding: 18px 0 16px; border-bottom: 1px solid #ffffff10; }
  .hb-toc a { display: flex; align-items: baseline; gap: 14px; text-decoration: none; color: var(--ink); }
  .hb-toc .tt { font: 400 21px/1.35 var(--serif); font-style: italic; transition: color .2s; text-wrap: pretty; }
  html[lang='ar'] .hb-toc .tt { font-weight: 700; font-size: 18px; line-height: 1.6; }
  .hb-toc .ld { flex: 1; min-width: 24px; border-bottom: 1px dotted #ffffff2e; transform: translateY(-5px); }
  .hb-toc .dt { flex: none; font: 500 10.5px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
  .hb-toc a:hover .tt { color: var(--red); } .hb-toc a:hover .dt { color: var(--ink); }
  .hb-toc p { margin: 6px 0 0; font: 10.5px var(--mono); color: #6f9f6fcc; }
  .hb a:focus-visible, .hb button:focus-visible { outline: 1px solid var(--red); outline-offset: 4px; }
  .hb-tag { margin: 0; font: 500 9.5px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }

  /* ── tools: compact stage grid + where-used rows ── */
  .hb-tools { position: relative; }

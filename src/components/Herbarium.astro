---
// Herbarium: the home page, a readable scrolling portfolio drawn in Papillon's visual language, in
// English and Arabic. Rendered by / and /ar/; behaviour lives in public/js/herb.js (shared with every
// page) and public/experiments/herbarium.js (the landing garden, the section rail and the scroll lock).
// Project text comes straight from the content collection, so the Arabic descriptions are shown
// exactly as written. Styles: src/styles/herbarium.css.
import Herb from '../layouts/Herb.astro';
import { expData } from '../lib/expData';
import { flowerHTML } from '../lib/flowerArt';
import type { Lang } from '../data/profile';
import { langUrl } from '../lib/site';
import { projectArt } from '../lib/projectArt';

interface Props { lang: Lang }
const { lang } = Astro.props;
const D = await expData(lang);
const AR = lang === 'ar';
const pad = (n: number) => String(n).padStart(2, '0');

const T = AR ? {
  see: 'شوف المشاريع ↓', email: 'راسلني',
  intro: 'فضولية بطبعي، أستكشف التقاطع بين البيانات والبرمجيات والتقنية من خلال المشاريع والتجارب.',
  now: 'آخر مشروع', training: 'آخر تدريب', note: 'آخر تدوينة',
  secs: ['المشاريع', 'عني', 'الأدوات', 'المدونة', 'تواصل'],
  tools: 'كل أداة استخدمتها، مرتبة حسب مجالها. النقاط توضح وين استخدمتها: في مشاريعي، في وظيفة، أو في معسكر SDA.',
  contact: 'أسرع طريقة توصل لي هي الإيميل.',
  case: 'دراسة الحالة ←', live: 'العرض المباشر ↗', code: 'الكود ↗',
  preview: 'معاينة', hide: 'إخفاء', shot: 'لقطة من',
  explore: 'تصفّح المجموعة كاملة ←', allN: (n: number) => `كل المشاريع · ${n}`,
  exploreW: 'اقرأ كل الكتابات ←', allW: (n: number) => (n === 1 ? 'تدوينة واحدة' : `كل التدوينات · ${n}`),
  lgProj: 'استخدمتها في مشاريعي', lgWork: 'استخدمتها في وظيفة', lgTrain: 'استخدمتها في معسكر SDA',
  caps: [['Data & Analytics', 'تحويل البيانات لتقارير وقرارات واضحة.'], ['Software Development', 'الكود والـ integrations والتطبيقات.'],
    ['Data Engineering', 'Pipelines و models و data warehouses يوثق فيها.'], ['Cloud & Infrastructure', 'وين يشتغل كل هذا، وكيف ينشر.']],
  min: 'دقيقة قراءة', read: 'اقرأ ←',
} : {
  see: 'See the projects ↓', email: 'Email me',
  intro: 'Curious by nature, I explore the intersection of data, software, and technology through projects and experiments.',
  now: 'Latest project', training: 'Latest training', note: 'Latest note',
  secs: ['Projects', 'About', 'Tools', 'Notes', 'Contact'],
  tools: 'Every tool I have used, grouped by what it is for. The dots show where I used it: in my own projects, at a job, or in the SDA bootcamp.',
  contact: 'Email is the fastest way to reach me.',
  case: 'Case study →', live: 'Live demo ↗', code: 'Code ↗',
  preview: 'Preview', hide: 'Hide preview', shot: 'Screenshot of',
  explore: 'Explore the complete collection →', allN: (n: number) => `All ${n} projects`,
  exploreW: 'Read all the writing →', allW: (n: number) => (n === 1 ? 'One note' : `All ${n} notes`),
  lgProj: 'used in my projects', lgWork: 'used at a job', lgTrain: 'used in the SDA bootcamp',
  caps: [['Data & Analytics', 'Turning data into clear reports and decisions.'], ['Software Development', 'Code, integrations and the apps around them.'],
    ['Data Engineering', 'Pipelines, models and warehouses people can trust.'], ['Cloud & Infrastructure', 'Where it all runs, and how it ships.']],
  min: 'min read', read: 'Read →',
};
const ids = ['work', 'about', 'tools', 'notes', 'contact'];
// Each project's flower plate
const plate = (slug: string) => projectArt(slug).html;

// Capability groups; every tool sits in exactly one. Only tools with real use (a project, a job or the
// bootcamp) are shown, so the unused keys here stay hidden until they are used somewhere.
const CAPS = [
  ['power-bi', 'dax', 'power-query', 'dashboard-design', 'data-cleaning', 'web-scraping', 'statistics'],
  ['python', 'typescript', 'javascript', 'astro', 'streamlit', 'rest-apis', 'ibm-api-connect', 'outsystems', 'git', 'p5js', 'generative-viz'],
  ['sql', 'dbt', 'airflow', 'etl', 'data-modeling', 'snowflake'],
  ['aws', 'azure', 'docker', 'ci-cd'],
];
const live = (k: string) => D.skills.find((s) => s.key === k && (s.used.length || s.work.length || s.train.length));
const groups = CAPS.map((keys, i) => ({ name: T.caps[i][0], what: T.caps[i][1],
  tools: keys.map(live).filter(Boolean).sort((a, b) => b!.used.length - a!.used.length || b!.work.length - a!.work.length) as typeof D.skills }))
  .filter((g) => g.tools.length);
const camps = D.education.filter((e) => e.skills.length);
// Curated for this page: three specimens that each show a different strength (a team data-engineering
// pipeline, a solo scrape-validate-report dashboard, a merged open-source product contribution).
// Everything else is on the projects page.
const PICKS = ['invasight', 'ewc-2024-dashboard', 'qafiyah-feelings'];
const byTime = <X extends { time: number }>(a: X, b: X) => b.time - a.time;
const picked = PICKS.map((s) => D.projects.find((p) => p.slug === s)).filter((p): p is (typeof D.projects)[number] => !!p);
const featured = [...picked, ...D.projects.filter((p) => p.featured && !picked.includes(p))].slice(0, 3);
// Writing: the personal reflection first, then the practical how-to; the rest is on the writing page
const POST_PICKS = ['adapting-to-ai', 'gsd-claude-code'];
const featPosts = [...POST_PICKS.map((s) => D.posts.find((p) => p.slug === s)), ...[...D.posts].sort(byTime)]
  .filter((p, i, a): p is (typeof D.posts)[number] => !!p && a.indexOf(p) === i).slice(0, 3);
const lead = featured[0] ?? D.projects[0], camp = camps[0], post = D.posts[0];
---
<Herb lang={lang} home scripts={['experiments/herbarium.js']}>
  <nav class="hb-rail" id="hb-rail" aria-label="Sections">
    <span class="hb-stem"><i id="hb-grow"></i></span>
    {ids.map((id, i) => <a href={`#${id}`} data-id={id}><b>{pad(i + 1)}</b><span>{T.secs[i]}</span></a>)}
  </nav>

  <div class="hb-gwrap"><canvas id="hb-garden" aria-hidden="true"></canvas></div>
  <main class="hb" id="main">
    <!-- ── Landing ── -->
    <header class="hb-hero">
      <div class="hb-hero-in">
        <h1 class="hb-name" data-perch><span data-decode>{D.name}</span></h1>
        <p class="hb-intro">{T.intro}</p>
        <p class="hb-cta"><a href="#work">{T.see}</a><a href={`mailto:${D.email}`}>{T.email}</a></p>
      </div>
      <aside class="hb-now">
        <article class="hb-now-p">
          <a class="hb-img" href={lead.href} aria-label={lead.title}>
            <pre class="hb-art" aria-hidden="true" set:html={plate(lead.slug)}></pre>
            <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          </a>
          <p class="hb-tag">{T.now} · {lead.date}</p>
          <h3><a href={lead.href}>{lead.title}</a></h3>
          {lead.sub && <p class="hb-sub">{lead.sub}</p>}
        </article>
        <div class="hb-now-rows">
          {camp && <a href="#tools"><p class="hb-tag">{T.training} · {camp.period}</p><b>{camp.title}</b><span>{camp.org}</span></a>}
          {post && <a href={post.href}><p class="hb-tag">{T.note} · {post.date}</p><b>{post.title}</b></a>}
        </div>
      </aside>
    </header>

    <!-- ── 01 Projects ── -->
    <section id="work" class="hb-sec">
      <header class="hb-head"><h2 data-decode data-perch>{T.secs[0]}</h2></header>
      <div class="hb-feats">
        {featured.map((p) => (
          <article class="hb-feat">
            <div class="hb-label">
              <h3><a href={p.href}>{p.title}</a></h3>
              {p.sub && <p class="hb-sub">{p.sub}</p>}
              <p class="hb-sum">{p.summary}</p>
              {p.tldr.result && <p class="hb-sum is-2">{p.tldr.result}</p>}
              <p class="hb-stack">{p.skills.map((s) => <span>{s.label}</span>)}</p>
              <p class="hb-links">
                <a href={p.href}>{T.case}</a>
                {p.live && <a href={p.live}>{T.live}</a>}
                {p.code && <a href={p.code}>{T.code}</a>}
              </p>
            </div>
            <div class="hb-plate">
              <a class="hb-img" href={p.href} aria-label={p.title}>
                <pre class="hb-art" aria-hidden="true" set:html={plate(p.slug)}></pre>
                {p.thumb && <img class="hb-shot" src={p.thumb} alt={`${T.shot} ${p.title}`} loading="lazy" />}
              </a>
              {p.thumb && <p class="hb-fig is-bare"><button type="button" class="hb-prev" aria-pressed="false" data-on={T.hide} data-off={T.preview}>{T.preview}</button></p>}
            </div>
          </article>
        ))}
      </div>
      <p class="hb-explore is-coll">
        <a class="hb-all" href={langUrl(lang, 'projects/')}><small>{T.allN(D.projects.length)}</small><span>{T.explore}</span></a>
      </p>
    </section>

    <!-- ── 02 About ── -->
    <section id="about" class="hb-sec">
      <header class="hb-head"><h2 data-decode data-perch>{T.secs[1]}</h2></header>
      <div class="hb-about">
        <ol class="hb-time">
          {D.experience.map((e) => <li><small>{e.period}</small><b>{e.title}</b><span>{e.org}</span><p>{e.points[0]}</p></li>)}
          {D.education.map((e) => <li class="is-root"><small>{e.period}</small><b>{e.title}</b><span>{e.org}{e.note && ` · ${e.note}`}</span></li>)}
        </ol>
      </div>
    </section>

    <!-- ── 03 Tools ── -->
    <section id="tools" class="hb-sec">
      <header class="hb-head"><h2 data-decode data-perch>{T.secs[2]}</h2><p class="hb-lead">{T.tools}</p></header>
      <div class="hb-tools">
        <p class="hb-legend"><span><i class="d p"></i>{T.lgProj}</span><span><i class="d w"></i>{T.lgWork}</span><span><i class="d t"></i>{T.lgTrain}</span></p>
        <div class="hb-caps">
          {groups.map((g) => (
            <div class="hb-cap">
              <h3>{g.name}</h3>
              <p class="hb-cap-d">{g.what}</p>
              <ul>{g.tools.map((t) => (
                <li>{t.label}<span class="mk">{t.used.length > 0 && <i class="d p" role="img" aria-label={T.lgProj} title={T.lgProj}></i>}{t.work.length > 0 && <i class="d w" role="img" aria-label={T.lgWork} title={T.lgWork}></i>}{t.train.length > 0 && <i class="d t" role="img" aria-label={T.lgTrain} title={T.lgTrain}></i>}</span></li>))}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 04 Notes ── -->
    <section id="notes" class="hb-sec">
      <header class="hb-head"><h2 data-decode data-perch>{T.secs[3]}</h2></header>
      <div class={`hb-journal n-${featPosts.length}`} style={`--n:${featPosts.length}`}>
        {featPosts.map((p, i) => (
          <article class="hb-entry">
            <p class="hb-entry-k">{p.date} · {p.minutes} {T.min}</p>
            <pre class="hb-sprig" aria-hidden="true" set:html={flowerHTML({ R: 3, petals: 5 + i, seed: 40 + i, stem: 4 })}></pre>
            <h3><a href={p.href}>{p.title}</a></h3>
            <p class="hb-excerpt">{p.summary}</p>
            <p class="hb-entry-f"><a href={p.href}>{T.read}</a></p>
          </article>
        ))}
      </div>
      <p class="hb-explore is-coll is-w">
        <a class="hb-all" href={langUrl(lang, 'blog/')}><small>{T.allW(D.posts.length)}</small><span>{T.exploreW}</span></a>
      </p>
    </section>

    <!-- ── 05 Contact ── -->
    <section id="contact" class="hb-sec hb-end">
      <header class="hb-head"><h2 data-decode data-perch>{T.secs[4]}</h2><p class="hb-lead">{T.contact}</p></header>
      <a class="hb-mail" href={`mailto:${D.email}`} id="hb-mail" dir="ltr" data-perch>{D.email}</a>
      <p class="hb-cta"><a href={D.links.linkedin}>LinkedIn ↗</a><a href={D.links.github}>GitHub ↗</a></p>
    </section>
  </main>
</Herb>
